---
import Layout from '../../../layouts/Layout.astro';
import EnterpriseSolutionHero from '../../../components/enterprise-solution/EnterpriseSolutionHero.astro';
import EnterpriseSolutionShortAnswer from '../../../components/enterprise-solution/EnterpriseSolutionShortAnswer.astro';
import EnterpriseSolutionAudience from '../../../components/enterprise-solution/EnterpriseSolutionAudience.astro';
import EnterpriseSolutionChallenges from '../../../components/enterprise-solution/EnterpriseSolutionChallenges.astro';
import EnterpriseSolutionScope from '../../../components/enterprise-solution/EnterpriseSolutionScope.astro';
import EnterpriseSolutionPathway from '../../../components/enterprise-solution/EnterpriseSolutionPathway.astro';
import EnterpriseSolutionProcess from '../../../components/enterprise-solution/EnterpriseSolutionProcess.astro';
import EnterpriseSolutionDeliverables from '../../../components/enterprise-solution/EnterpriseSolutionDeliverables.astro';
import EnterpriseSolutionLimitations from '../../../components/enterprise-solution/EnterpriseSolutionLimitations.astro';
import EnterpriseSolutionRelatedServices from '../../../components/enterprise-solution/EnterpriseSolutionRelatedServices.astro';
import ServiceFAQ from '../../../components/service-page/ServiceFAQ.astro';
import ServiceFinalCTA from '../../../components/service-page/ServiceFinalCTA.astro';
import TrustBadgesStrip from '../../../components/ui/TrustBadgesStrip.astro';
import { governmentServiceSchema, faqPageSchema, breadcrumbSchema } from '../../../lib/seo/schema';

const audience = [
  "Federal, State, and Municipal Government Agencies",
  "Public Sector HR & Talent Directors",
  "Regulatory & Compliance Oversight Bodies",
  "Public Health & Human Services Departments",
  "Law Enforcement & Emergency Services Academies",
  "Educational & Vocational Training Authorities",
  "Government Contracting Partners & Vendors",
  "Public Works & Infrastructure Teams"
];

const challenges = [
  "Strict Section 508 and WCAG 2.1 AA legal accessibility mandates",
  "Mandatory auditable completion and verification records for regulatory oversight",
  "Legacy, passive 100-slide compliance decks with high attrition rates",
  "Multi-agency LMS interoperability requirements (SCORM, xAPI, cmi5)",
  "Tight procurement cycles requiring rapid RFP evaluation turnarounds",
  "Handling sensitive public agency information under strict NDA protocols",
  "Distributed public workforce requiring mobile-friendly offline/low-bandwidth access",
  "Budget constraints demanding measurable seat-time productivity savings"
];

const scope = [
  "Accessibility compliance auditing (WCAG 2.1 AA & Section 508 VPAT)",
  "Regulatory curriculum and instructional blueprint design",
  "SCORM 1.2, SCORM 2004 4th Edition, and xAPI module authoring",
  "Scenario-based ethical decision-making simulations",
  "Multi-lingual translation and localization for diverse citizen/staff groups",
  "Full screen-reader (NVDA/JAWS) and keyboard navigation optimization",
  "Closed captioning (.vtt) and synchronized interactive transcripts",
  "LMS deployment and sandbox sandbox verification",
  "Post-launch 60-day compliance warranty and bug remediation"
];

const stages = [
  {
    step: "01",
    title: "Procurement & Scope Discovery",
    description: "Execute bilateral NDA, review agency RFP requirements, and establish accessibility and technical compliance criteria."
  },
  {
    step: "02",
    title: "Curriculum & Accessibility Architecture",
    description: "Map regulatory mandates to actionable learning objectives using Bloom's Taxonomy and Cathy Moore's Action Mapping."
  },
  {
    step: "03",
    title: "Interactive Development & Media Production",
    description: "Build microlearning modules, branching decision trees, audio voiceovers, and closed-captioned visual assets."
  },
  {
    step: "04",
    title: "Verification, VPAT & LMS Deployment",
    description: "Rigorous testing with automated axe-core and manual screen-readers, SCORM Cloud verification, and LMS delivery."
  }
];

const processSteps = [
  {
    step: "Phase 1: Compliance Alignment",
    title: "Kickoff & Legal Safeguards",
    description: "NDA execution, stakeholder kickoff, and mapping agency compliance benchmarks."
  },
  {
    step: "Phase 2: Storyboarding",
    title: "Instructional Storyboarding",
    description: "Developing 2-column visual/audio scripts and scenario branching logic for SME review."
  },
  {
    step: "Phase 3: Prototype Approval",
    title: "Interactive Accessibility Prototype",
    description: "Testing a live course slice with screen-readers and LMS sandboxes before full production."
  },
  {
    step: "Phase 4: Full Course Build",
    title: "Turnkey Module Authoring",
    description: "Full module production across Storyline 360, Rise, and responsive HTML5 frameworks."
  },
  {
    step: "Phase 5: Final Delivery",
    title: "SCORM Packaging & Sign-Off",
    description: "Delivering LMS-ready SCORM/xAPI packages, source files, and accessibility verification logs."
  }
];

const deliverables = [
  "Certified SCORM 1.2 / 2004 4th Edition and xAPI packages",
  "Section 508 VPAT 2.4 accessibility compliance documentation",
  "Full visual storyboards and SME-approved audio scripts",
  "Closed-caption files (.vtt) and downloadable accessible transcripts",
  "Interactive branching scenario decision trees and knowledge checks",
  "Complete editable source files (Storyline 360 / Rise / Graphics)",
  "LMS implementation guidance and sandbox test verification reports"
];

const limitations = [
  "We do not provide certified legal counsel on statutory regulatory interpretation; curriculum is built in partnership with agency subject-matter experts.",
  "Public sector procurements requiring active high-level military security clearance facilities (SCIF) require specific on-premise arrangement.",
  "Accessibility certification requires approved source content; external third-party embedded links must also support accessibility standards."
];

const relatedServices = [
  {
    title: "Custom eLearning Development",
    description: "Bespoke digital learning modules engineered for high retention and LMS compatibility.",
    link: "/services/custom-elearning-development/"
  },
  {
    title: "LMS Implementation & Migration",
    description: "Seamless platform setup, content migration, and system integrations for multi-agency ecosystems.",
    link: "/services/lms-implementation-migration/"
  },
  {
    title: "Course Localization & Translation",
    description: "Multi-language translation and cultural localization for distributed global and citizen populations.",
    link: "/services/course-localization-translation/"
  },
  {
    title: "Procurement & Trust Centre",
    description: "Review our security protocols, RFP review guidance, and data privacy commitments.",
    link: "/trust-centre/procurement/"
  }
];

const faqs = [
  {
    question: "Do you comply with Section 508 and WCAG 2.1 AA mandates?",
    answer: "Yes. All public sector eLearning deliverables are built to meet WCAG 2.1 Level AA and Section 508 standards, including minimum contrast ratios (>= 4.5:1), keyboard-only tab order navigation, closed captions, descriptive transcripts, and screen-reader compatibility."
  },
  {
    question: "How fast can TheEduAssist respond to a formal government RFP?",
    answer: "Our enterprise solutions team reviews formal RFPs and provides capability statements, technical compliance matrices, and detailed milestone proposals within 48 to 72 business hours."
  },
  {
    question: "Can TheEduAssist execute bilateral Non-Disclosure Agreements (NDAs)?",
    answer: "Yes. We regularly work under strict NDAs before receiving agency training source documents, SOPs, or project specifications. We guarantee that client IP and curriculum data are never used to train public AI models."
  },
  {
    question: "Which LMS platforms do your SCORM packages support?",
    answer: "Our packages run across all major enterprise and government learning platforms, including Canvas, Blackboard, Moodle, Cornerstone OnDemand, Docebo, SAP Litmos, and custom headless LMS architectures."
  },
  {
    question: "Do you provide source files upon project completion?",
    answer: "Yes. 100% of final intellectual property, including editable Articulate Storyline/Rise source files, graphics, audio recordings, and caption files, are transferred to the client upon milestone delivery."
  }
];
---

<Layout
  title="Government & Public Sector Training Solutions | Section 508 & WCAG | TheEduAssist"
  description="Section 508 and WCAG 2.1 AA-compliant custom eLearning, workforce upskilling, and regulatory training development for federal, state, and municipal public sector agencies."
  canonicalPath="/enterprise-solutions/government-and-public-sector-training/"
  jsonLd={[
    governmentServiceSchema(),
    faqPageSchema(faqs),
    breadcrumbSchema([
      { name: "Home", urlPath: "/" },
      { name: "Enterprise Solutions", urlPath: "/enterprise-solutions/" },
      { name: "Government & Public Sector Training", urlPath: "/enterprise-solutions/government-and-public-sector-training/" }
    ])
  ]}
>
  <main class="flex-auto">
    <EnterpriseSolutionHero
      eyebrow="Government & Public Sector Training Solutions"
      title="Accessible, Compliant Digital Training for Public Sector Workforces"
      body="TheEduAssist develops custom, Section 508 and WCAG 2.1 AA-compliant digital training, workforce upskilling pathways, and multi-agency LMS learning ecosystems engineered for public sector accountability."
      primaryCtaLabel="Submit RFP / Procurement Desk"
      primaryCtaLink="/trust-centre/procurement/"
      secondaryCtaLabel="Download 2026 Capability Statement (PDF)"
      secondaryCtaLink="/downloads/enterprise-capability-statement/"
    />

    <!-- Verified Enterprise Trust & Delivery Guarantee Strip -->
    <TrustBadgesStrip variant="light" />

    <EnterpriseSolutionShortAnswer
      heading="What Is Public Sector Digital Learning Architecture?"
      answer="It is the specialized discipline of designing digital training programs for government and public institutions that meet strict statutory accessibility mandates (Section 508 / WCAG 2.1 AA), multi-agency technical interoperability (SCORM/xAPI), and auditable compliance standards."
    />

    <!-- Downloadable RFP Toolkit Banner -->
    <section class="py-12 bg-slate-900 text-white border-y border-slate-800">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-gradient-to-r from-brand-navy via-slate-800 to-brand-navy rounded-2xl p-8 border border-brand-green/30 flex flex-col md:flex-row items-center justify-between gap-6">
          <div class="max-w-2xl">
            <span class="inline-block px-3 py-1 rounded text-xs font-bold tracking-wider uppercase bg-brand-green/20 text-brand-green border border-brand-green/30 mb-2">Public Sector RFP Toolkit</span>
            <h3 class="text-2xl font-bold text-white">Evaluating eLearning Vendors for an Upcoming Tender?</h3>
            <p class="text-slate-300 text-sm mt-2">
              Download our 40-point objective scoring rubric used by government committees to evaluate vendor bids across technical architecture, Section 508 compliance, pedagogy, and SLAs.
            </p>
          </div>
          <div class="flex flex-col sm:flex-row gap-3 shrink-0">
            <a href="/downloads/procurement-rfp-evaluation-matrix/" target="_blank" rel="noopener noreferrer" class="px-5 py-3 rounded-lg bg-[#77BA55] text-slate-950 font-black text-sm hover:bg-white hover:text-brand-navy transition-all text-center shadow-md">
              Download 40-Point Matrix (PDF) &rarr;
            </a>
            <a href="/downloads/enterprise-capability-statement/" target="_blank" rel="noopener noreferrer" class="px-5 py-3 rounded-lg bg-white/10 text-white font-semibold text-sm hover:bg-white/20 border border-white/20 transition-all text-center">
              Capability Statement (PDF)
            </a>
          </div>
        </div>
      </div>
    </section>

    <EnterpriseSolutionAudience audience={audience} />

    <EnterpriseSolutionChallenges challenges={challenges} />

    <EnterpriseSolutionScope scope={scope} />

    <EnterpriseSolutionPathway
      title="The Public Sector Compliance & Delivery Pathway"
      description="A structured, risk-mitigated model for moving from legislative requirements to verified learner competency."
      stages={stages}
    />

    <EnterpriseSolutionProcess steps={processSteps} />

    <EnterpriseSolutionDeliverables deliverables={deliverables} />

    <!-- Verified Public Sector Case Study Feature -->
    <section class="py-16 bg-slate-50 border-y border-slate-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-white rounded-2xl border border-slate-200 shadow-md p-8 md:p-10 flex flex-col lg:flex-row items-center justify-between gap-8">
          <div class="max-w-2xl">
            <div class="flex items-center gap-3 mb-3">
              <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-brand-navy/10 text-brand-navy">Verified Public Sector Project</span>
              <span class="text-xs text-slate-500 font-medium">Case 01 &bull; Malaysia</span>
            </div>
            <h3 class="text-2xl md:text-3xl font-bold text-brand-navy">SQA-Aligned Vocational Training for Government Institute</h3>
            <p class="text-slate-600 text-base mt-3 leading-relaxed">
              Discover how TheEduAssist transitioned traditional classroom vocational curriculum into an interactive, SQA-compliant, LMS-ready eLearning ecosystem for a public government institute across 6 structured delivery sprints.
            </p>
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 mt-6">
              <div class="border-l-2 border-brand-green pl-3">
                <div class="text-lg font-bold text-brand-navy">100% SQA</div>
                <div class="text-xs text-slate-500">Standard Compliance</div>
              </div>
              <div class="border-l-2 border-brand-green pl-3">
                <div class="text-lg font-bold text-brand-navy">LMS Ready</div>
                <div class="text-xs text-slate-500">Multi-Agency SCORM</div>
              </div>
              <div class="border-l-2 border-brand-green pl-3">
                <div class="text-lg font-bold text-brand-navy">6 Weeks</div>
                <div class="text-xs text-slate-500">Milestone Turnaround</div>
              </div>
            </div>
          </div>
          <div class="shrink-0 flex flex-col sm:flex-row lg:flex-col gap-3 w-full lg:w-auto">
            <a href="/case-studies/sqa-aligned-vocational-training/" class="px-6 py-3.5 rounded-lg bg-brand-navy text-white font-bold text-sm hover:bg-slate-800 transition-all text-center shadow-sm">
              Read Public Sector Case Study &rarr;
            </a>
            <a href="/downloads/enterprise-capability-statement/" target="_blank" rel="noopener noreferrer" class="px-6 py-3.5 rounded-lg bg-slate-100 text-slate-700 font-semibold text-sm hover:bg-slate-200 border border-slate-300 transition-all text-center">
              Download 2026 Capability Statement (PDF)
            </a>
          </div>
        </div>
      </div>
    </section>

    <EnterpriseSolutionLimitations limitations={limitations} />

    <EnterpriseSolutionRelatedServices services={relatedServices} />

    <ServiceFAQ faqs={faqs} />

    <ServiceFinalCTA serviceSlug="government-and-public-sector-training" />
  </main>
</Layout>
