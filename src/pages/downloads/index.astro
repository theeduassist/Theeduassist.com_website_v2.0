---
import Layout from '../../layouts/Layout.astro';
import { downloadAssets } from '../../data/downloads';
import { collectionPageSchema, breadcrumbSchema } from '../../lib/seo/schema';

const jsonLd = [
  collectionPageSchema(
    "Executive Downloads, Capability Statements & Blueprints | TheEduAssist",
    "Access official public sector capability statements, RFP matrices, ROI measurement playbooks, and instructional design frameworks.",
    "/downloads/"
  ),
  breadcrumbSchema([
    { name: "Home", urlPath: "/" },
    { name: "Resources", urlPath: "/resources/" },
    { name: "Downloads", urlPath: "/downloads/" }
  ])
];
---

<Layout
  title="Executive Downloads & Blueprints | TheEduAssist"
  description="Download official public sector capability statements, RFP matrices, ROI measurement playbooks, and instructional design blueprints from TheEduAssist."
  canonicalPath="/downloads/"
  jsonLd={jsonLd}
>
  <main class="flex-auto">
    <!-- Hero Section -->
    <section class="bg-gradient-to-b from-brand-navy via-slate-900 to-slate-950 text-white py-16 sm:py-20 border-b border-slate-800">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-brand-accent/20 text-brand-accent border border-brand-accent/30 mb-4">
          Verified Enterprise & Public Sector Assets
        </span>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight mb-4">
          Executive Downloads & Frameworks Library
        </h1>
        <p class="text-lg text-slate-300 max-w-3xl mx-auto leading-relaxed">
          Access our official capability statements, procurement scoring rubrics, Kirkpatrick ROI calculation models, and turnkey curriculum blueprints. Hosted securely with instant browser preview and direct PDF download.
        </p>
      </div>
    </section>

    <!-- Downloads Grid -->
    <section class="py-16 bg-slate-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          {downloadAssets.map((asset) => (
            <div class="bg-white rounded-2xl border border-slate-200 p-8 flex flex-col justify-between shadow-sm hover:shadow-lg transition-all">
              <div>
                <div class="flex items-center justify-between gap-3 mb-4">
                  <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-brand-navy/10 text-brand-navy">
                    {asset.badge}
                  </span>
                  <span class="text-xs font-mono text-slate-400">
                    {asset.technicalSpecs.pageCount} &bull; {asset.technicalSpecs.format}
                  </span>
                </div>

                <h2 class="text-2xl font-bold text-brand-navy mb-3 hover:text-brand-accent transition-colors">
                  <a href={`/downloads/${asset.slug}/`}>{asset.title}</a>
                </h2>

                <p class="text-slate-600 text-sm leading-relaxed mb-6">
                  {asset.description}
                </p>

                <!-- Key bullets -->
                <div class="mb-6 space-y-2">
                  <span class="text-xs font-bold uppercase tracking-wider text-slate-400 block">Core Topics Covered:</span>
                  <ul class="space-y-1.5">
                    {asset.keyTopics.slice(0, 3).map((topic) => (
                      <li class="flex items-start gap-2 text-xs text-slate-700">
                        <svg class="w-4 h-4 text-brand-accent shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
                        </svg>
                        <span>{topic}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>

              <div class="pt-6 border-t border-slate-100 flex flex-col sm:flex-row gap-3">
                <a
                  href={`/downloads/${asset.slug}/`}
                  class="flex-1 text-center px-5 py-3 rounded-lg bg-brand-navy text-white font-bold text-xs uppercase tracking-wider hover:bg-slate-800 transition-all shadow-sm"
                >
                  View Details & Preview Online &rarr;
                </a>
                <a
                  href={asset.driveUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex-1 text-center px-5 py-3 rounded-lg bg-[#77BA55] text-slate-950 font-black text-xs uppercase tracking-wider hover:bg-white hover:text-brand-navy transition-all shadow-sm border border-[#77BA55]"
                >
                  Download PDF &darr;
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Procurement Support Banner -->
    <section class="py-16 bg-white border-t border-slate-200">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-2xl sm:text-3xl font-bold text-brand-navy mb-4">
          Need a Tailored RFP Proposal or Security Review?
        </h2>
        <p class="text-base text-slate-600 max-w-2xl mx-auto mb-8">
          Our senior solutions architecture team provides formal technical compliance reviews, Section 508 VPAT documentation, and milestone-based Statements of Work within 24–48 hours under bilateral NDA.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="/trust-centre/procurement/"
            class="px-8 py-4 rounded-xl bg-brand-navy text-white font-bold text-sm hover:bg-slate-800 transition-all shadow-md text-center"
          >
            Submit Formal RFP / Procurement Scope &rarr;
          </a>
          <a
            href="/contact-us/"
            class="px-8 py-4 rounded-xl bg-slate-100 text-slate-700 font-semibold text-sm hover:bg-slate-200 border border-slate-300 transition-all text-center"
          >
            Book Discovery Sprint
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>
