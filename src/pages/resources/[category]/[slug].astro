---
export const prerender = true;
import { getCollection, render } from 'astro:content';
import Layout from "../../../layouts/Layout.astro";
import ResourceTableOfContents from "../../../components/resources/ResourceTableOfContents.astro";
import ResourceAiSummary from "../../../components/resources/ResourceAiSummary.astro";
import RelatedResources from "../../../components/resources/RelatedResources.astro";
import ServiceFAQ from "../../../components/service-page/ServiceFAQ.astro";
import ServicesFinalCTA from "../../../components/services/ServicesFinalCTA.astro";
import { breadcrumbSchema } from '../../../lib/seo/schema';

export async function getStaticPaths() {
  const resources = await getCollection('resources');

  return resources.map(resource => {
    // the collection uses the format folder/filename as the actual ID/slug for the markdown files,
    // so resource.slug might contain the category in it or not depending on the loader behavior.
    // Astro 5 glob loader makes the id be the path. So slug or id might look like "localization/what-is-elearning-localization"
    const actualSlug = resource.slug || resource.id.split('/').pop() || resource.data.slug;
    return {
      params: {
        category: resource.data.category,
        slug: actualSlug.split('/').pop()
      },
      props: { resource }
    };
  });
}

const { resource } = Astro.props;
const data = resource.data;
const { Content, headings } = await render(resource);

const categoryName = data.category.split('-').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ');

// Formatter for dates
const formatDate = (dateInput) => {
  if (!dateInput) return null;
  const date = new Date(dateInput);
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
};

const publishedDate = formatDate(data.publishedAt);
const updatedDate = formatDate(data.updatedAt);

// Build structured data
const schemaData = [];

const actualSlug = resource.data.slug || resource.id.split('/').pop();

// Breadcrumbs
schemaData.push(
  breadcrumbSchema([
    { name: 'Home', item: '/' },
    { name: 'Resources', item: '/resources/' },
    { name: categoryName, item: `/resources/${data.category}/` },
    { name: data.title, item: `/resources/${data.category}/${actualSlug}/` }
  ])
);

// Add Article Schema (default) or other schemaType if specified
const articleSchema = {
  "@context": "https://schema.org",
  "@type": data.schemaType || "Article",
  "headline": data.title,
  "description": data.description || data.summary,
  "url": `https://www.theeduassist.com/resources/${data.category}/${actualSlug}/`
};
if (data.publishedAt) articleSchema.datePublished = new Date(data.publishedAt).toISOString();
if (data.updatedAt) articleSchema.dateModified = new Date(data.updatedAt).toISOString();
if (data.author) {
    articleSchema.author = {
        "@type": "Person",
        "name": data.author
    };
} else {
     articleSchema.author = {
        "@type": "Organization",
        "name": "TheEduAssist"
    };
}
if (data.featuredImage) {
    articleSchema.image = `https://www.theeduassist.com${data.featuredImage}`;
}
schemaData.push(articleSchema);

// Add FAQ schema if present
if (data.faq && data.faq.length > 0) {
    schemaData.push({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": data.faq.map(f => ({
        "@type": "Question",
        "name": f.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": f.answer
        }
      }))
    });
}
---
<Layout
  title={`${data.title} | TheEduAssist`}
  description={data.description || data.summary || `Read our comprehensive guide on ${data.title}.`}
  canonical={data.canonical || `/resources/${data.category}/${actualSlug}/`}
  schema={schemaData}
  noindex={data.noindex}
  lang={data.language || 'en'}
>
  <main id="main-content" class="bg-white">

    <!-- Header -->
    <header class="pt-32 pb-20 bg-gradient-to-b from-slate-100 to-slate-50 border-b border-slate-200 relative overflow-hidden">
      <div class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-slate-300 to-transparent"></div>
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

        <nav class="flex text-sm text-slate-500 mb-8" aria-label="Breadcrumb">
          <ol class="flex items-center space-x-2 bg-white px-4 py-2 rounded-full border border-slate-200 shadow-sm">
            <li><a href="/home/" class="hover:text-brand-primary transition-colors">Home</a></li>
            <li><span class="mx-2 text-slate-300">/</span></li>
            <li><a href="/resources/" class="hover:text-brand-primary transition-colors">Resources</a></li>
            <li><span class="mx-2 text-slate-300">/</span></li>
            <li><a href={`/resources/${data.category}/`} class="hover:text-brand-primary transition-colors font-medium text-brand-navy">{categoryName}</a></li>
          </ol>
        </nav>

        {data.resourceType && (
          <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-brand-primary/10 text-brand-primary uppercase tracking-wider mb-6 shadow-sm border border-brand-primary/20">
            {data.resourceType}
          </span>
        )}

        <h1 class="text-3xl md:text-5xl font-bold text-brand-navy mb-6 leading-tight">{data.title}</h1>

        {data.description && (
          <p class="text-xl text-slate-600 mb-8 leading-relaxed">
            {data.description}
          </p>
        )}

        <div class="flex flex-wrap items-center gap-4 text-sm text-slate-500 border-t border-slate-200 pt-6">
          {publishedDate && (
             <div class="flex items-center">
               <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
               Published: {publishedDate}
             </div>
          )}
          {updatedDate && updatedDate !== publishedDate && (
             <div class="flex items-center text-brand-primary">
               <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
               Updated: {updatedDate}
             </div>
          )}
          {data.author && (
            <div class="flex items-center ml-auto">
               <span class="font-medium text-brand-navy">By {data.author}</span>
            </div>
          )}
        </div>

      </div>
    </header>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="flex flex-col lg:flex-row gap-12">

        <!-- Main Content -->
        <article class="w-full lg:w-2/3 max-w-4xl">

          {data.featuredImage && (
            <figure class="mb-12 rounded-xl overflow-hidden border border-slate-200 shadow-sm">
              <img loading="lazy" src={data.featuredImage} alt={data.featuredImageAlt || data.title} class="w-full h-auto object-cover" />
            </figure>
          )}

          <ResourceAiSummary summary={data.summary} />

          <div class="prose prose-lg prose-slate max-w-none prose-headings:text-brand-navy prose-a:text-brand-primary hover:prose-a:text-brand-accent prose-img:rounded-xl">
            <Content />
          </div>

          <!-- Component-based FAQs -->
          {data.faq && data.faq.length > 0 && (
            <div class="mt-16 pt-16 border-t border-slate-200">
               <ServiceFAQ faqs={data.faq} title="Frequently Asked Questions" />
            </div>
          )}

          <!-- Sources -->
          {data.sources && data.sources.length > 0 && (
            <div class="mt-16 pt-8 border-t border-slate-200 bg-slate-50 p-8 rounded-xl text-sm">
              <h3 class="text-lg font-bold text-brand-navy mb-4">Sources and References</h3>
              <ul class="space-y-3">
                {data.sources.map(source => (
                  <li class="flex items-start">
                    <span class="mr-2 mt-1 text-slate-400">•</span>
                    <span class="text-slate-700">
                      {source.url ? (
                        <a href={source.url} target="_blank" rel="noopener noreferrer" class="hover:text-brand-primary underline decoration-slate-300 underline-offset-2">
                          {source.title}
                        </a>
                      ) : (
                        <span>{source.title}</span>
                      )}
                      {source.publisher && <span class="italic text-slate-500 ml-1">- {source.publisher}</span>}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <RelatedResources
            currentSlug={actualSlug}
            relatedSlugs={data.relatedResources}
            category={data.category}
          />

        </article>

        <!-- Sidebar -->
        <aside class="w-full lg:w-1/3">
          <ResourceTableOfContents headings={headings} />

          {/* Related Services Callout */}
          {data.relatedServices && data.relatedServices.length > 0 && (
            <div class="mt-8 bg-brand-navy text-white rounded-xl p-6 shadow-md border border-brand-primary/20">
              <h3 class="text-xl font-bold mb-3">Need Help Implementing This?</h3>
              <p class="text-slate-300 text-sm mb-6">TheEduAssist provides professional services to help organizations execute these strategies effectively.</p>
              <ul class="space-y-3">
                {data.relatedServices.map(service => (
                   <li>
                     <a href={`/services/${service}/`} class="flex items-center text-brand-secondary hover:text-white transition-colors group">
                       <svg class="w-4 h-4 mr-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                       {service.replace(/-/g, ' ').replace(/\b\w/g, l => l.toUpperCase())} Services
                     </a>
                   </li>
                ))}
              </ul>
            </div>
          )}
        </aside>

      </div>
    </div>

    <ServicesFinalCTA />
  </main>
</Layout>
