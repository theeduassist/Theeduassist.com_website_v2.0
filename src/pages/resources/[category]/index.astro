---
import { getCollection } from 'astro:content';
import Layout from "../../../layouts/Layout.astro";
import ResourceCard from "../../../components/resources/ResourceCard.astro";
import { breadcrumbSchema } from '../../../lib/seo/schema';

export async function getStaticPaths() {
  const resources = await getCollection('resources');

  // Get unique categories
  const categories = [...new Set(resources.map(r => r.data.category))].filter(Boolean);

  return categories.map(category => {
    return {
      params: { category: category },
      props: { category }
    };
  });
}

const { category } = Astro.props;
const allResources = await getCollection('resources');

const categoryResources = allResources
  .filter(r => r.data.category === category && !r.data.noindex)
  .sort((a, b) => new Date(b.data.publishedAt || b.data.updatedAt || new Date()).valueOf() - new Date(a.data.publishedAt || a.data.updatedAt || new Date()).valueOf());

// Pretty print the category name
const categoryName = category.split('-').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ');

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": `${categoryName} Resources | TheEduAssist`,
    "description": `Read our latest guides, tutorials, and definitions on ${categoryName}.`,
    "url": `https://www.theeduassist.com/resources/${category}/`
  },
  breadcrumbSchema([
    { name: 'Home', item: '/' },
    { name: 'Resources', item: '/resources/' },
    { name: categoryName, item: `/resources/${category}/` }
  ])
];

---
<Layout
  title={`${categoryName} Resources | TheEduAssist`}
  description={`Explore our library of guides, templates and definitions around ${categoryName}.`}
  canonical={`/resources/${category}/`}
  schema={structuredData}
>
  <main id="main-content">

    <div class="bg-brand-navy pt-32 pb-24 text-white text-center px-4">
      <div class="max-w-4xl mx-auto">
          <div class="text-brand-secondary font-semibold uppercase tracking-wider mb-4">Category</div>
          <h1 class="text-4xl md:text-5xl font-bold mb-6">{categoryName} Resources</h1>
      </div>
    </div>

    <section class="py-24 bg-white min-h-[50vh]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

        {categoryResources.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {categoryResources.map(resource => (
              <ResourceCard resource={resource} />
            ))}
          </div>
        ) : (
          <div class="text-center py-20 bg-slate-50 rounded-xl border border-slate-200">
             <h3 class="text-xl font-bold text-brand-navy mb-2">No resources found</h3>
             <p class="text-slate-600">Check back soon for new guides on this topic.</p>
             <a href="/resources/" class="inline-block mt-6 text-brand-primary font-medium hover:underline">Return to Knowledge Hub</a>
          </div>
        )}

      </div>
    </section>

  </main>
</Layout>
