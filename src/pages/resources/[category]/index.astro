---
import { getCollection } from 'astro:content';
import Layout from "../../../layouts/Layout.astro";
import ResourceCard from "../../../components/resources/ResourceCard.astro";
import { breadcrumbSchema } from '../../../lib/seo/schema';

export async function getStaticPaths() {
  const resources = await getCollection('resources');

  // Get unique categories
  const categories = [...new Set(resources.map(r => r.data.category))].filter(Boolean);

  return categories.map(category => {
    return {
      params: { category: category },
      props: { category }
    };
  });
}

const { category } = Astro.props;
const allResources = await getCollection('resources');

const categoryResources = allResources
  .filter(r => r.data.category === category && !r.data.noindex)
  .sort((a, b) => new Date(b.data.publishedAt || b.data.updatedAt || new Date()).valueOf() - new Date(a.data.publishedAt || a.data.updatedAt || new Date()).valueOf());

const categoryMeta: Record<string, { title: string; description: string; breadcrumb: string }> = {
  "localization": { title: "Localization Resources", description: "Guides and best practices for localizing your learning content for a global audience.", breadcrumb: "Localization" },
  "customer-education": { title: "Customer Education Resources", description: "Strategies and templates for building effective customer education and training programs.", breadcrumb: "Customer Education" },
  "knowledge-bases": { title: "Knowledge Base Resources", description: "Best practices for creating, managing, and optimizing your customer knowledge base.", breadcrumb: "Knowledge Bases" },
  "saas-training": { title: "SaaS Training Resources", description: "Resources and insights for training SaaS customers and increasing user adoption.", breadcrumb: "SaaS Training" },
  "technical-documentation": { title: "Technical Documentation Resources", description: "Guides on writing clear, effective, and user-friendly technical documentation.", breadcrumb: "Technical Documentation" },
  "learning-technology": { title: "Learning Technology Resources", description: "Insights and tutorials on learning management systems (LMS) and learning tools.", breadcrumb: "Learning Technology" },
  "instructional-design": { title: "Instructional Design Resources", description: "Frameworks, models, and tips for designing engaging learning experiences.", breadcrumb: "Instructional Design" },
  "accessibility": { title: "Accessibility Resources", description: "Guides to ensure your learning content is accessible and inclusive to all learners.", breadcrumb: "Accessibility" },
  "global-elearning": { title: "Global eLearning Resources", description: "Strategies for delivering effective eLearning and training to an international audience.", breadcrumb: "Global eLearning" },
  "glossary": { title: "eLearning Glossary", description: "Definitions and explanations of key terms in eLearning and customer education.", breadcrumb: "Glossary" },
};

// Fallback logic
const defaultName = category.split('-').map((word: string) => word.charAt(0).toUpperCase() + word.slice(1)).join(' ');
const defaultTitle = `${defaultName} Resources`;
const defaultDescription = `Explore our library of guides, templates and definitions around ${defaultName}.`;

const meta = categoryMeta[category] || { title: defaultTitle, description: defaultDescription, breadcrumb: defaultName };
const pageTitle = meta.title;
const pageDescription = meta.description;

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": `${pageTitle} | TheEduAssist`,
    "description": pageDescription,
    "url": `https://www.theeduassist.com/resources/${category}/`
  },
  breadcrumbSchema([
    { name: 'Home', item: '/' },
    { name: 'Resources', item: '/resources/' },
    { name: meta.breadcrumb, item: `/resources/${category}/` }
  ])
];

---
<Layout
  title={`${pageTitle} | TheEduAssist`}
  description={pageDescription}
  canonicalPath={`/resources/${category}/`}
  jsonLd={structuredData}
>
  <main id="main-content">

    <div class="bg-brand-navy pt-32 pb-24 text-white px-4 relative overflow-hidden">
      <div class="absolute inset-0 opacity-15 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-brand-secondary via-transparent to-transparent"></div>
      <div class="max-w-4xl mx-auto relative z-10 text-center">
          <div class="mb-6 flex justify-center">
            <nav class="flex text-sm text-slate-300 font-medium" aria-label="Breadcrumb">
              <ol class="inline-flex items-center space-x-1 md:space-x-3 bg-white/10 backdrop-blur-sm px-4 py-1.5 rounded-full border border-white/10">
                <li class="inline-flex items-center">
                  <a href="/resources/" class="inline-flex items-center hover:text-white transition-colors">
                    <svg class="w-3.5 h-3.5 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
                    Knowledge Hub
                  </a>
                </li>
                <li>
                  <div class="flex items-center">
                    <svg class="w-3 h-3 mx-1 text-slate-400" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
                      <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
                    </svg>
                    <span class="ml-1 text-white md:ml-2 font-semibold">{meta.breadcrumb}</span>
                  </div>
                </li>
              </ol>
            </nav>
          </div>

          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-brand-secondary/20 text-brand-secondary border border-brand-secondary/30 mb-4">
            <span class="w-1.5 h-1.5 rounded-full bg-brand-secondary animate-pulse"></span>
            Peer-Reviewed & Industry Standard Frameworks
          </div>

          <h1 class="text-4xl md:text-5xl font-extrabold mb-6 tracking-tight">{pageTitle}</h1>
          <p class="text-lg md:text-xl text-slate-300 max-w-2xl mx-auto leading-relaxed">{pageDescription}</p>

          <div class="mt-8 flex items-center justify-center gap-6 text-sm text-slate-400">
            <span>{categoryResources.length} Published Resource{categoryResources.length !== 1 ? 's' : ''}</span>
            <span>•</span>
            <span>Updated Monthly</span>
            <span>•</span>
            <a href="/resources/" class="text-brand-secondary hover:text-white transition-colors underline underline-offset-4">Browse All Categories &rarr;</a>
          </div>
      </div>
    </div>

    <section class="py-20 bg-slate-50 min-h-[50vh]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

        {categoryResources.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {categoryResources.map(resource => (
              <ResourceCard resource={resource} />
            ))}
          </div>
        ) : (
          <div class="text-center py-20 bg-white rounded-2xl border border-slate-200 shadow-sm max-w-md mx-auto">
             <h3 class="text-xl font-bold text-brand-navy mb-2">No resources found</h3>
             <p class="text-slate-600 mb-6">Check back soon for new guides on this topic.</p>
             <a href="/resources/" class="inline-flex items-center px-5 py-2.5 rounded-lg bg-brand-primary text-white font-medium hover:bg-brand-primary/90 transition-colors">Return to Knowledge Hub</a>
          </div>
        )}

        <!-- Free Architecture Review Callout -->
        <div class="mt-16 bg-gradient-to-r from-brand-navy to-slate-900 rounded-2xl p-8 md:p-12 text-white shadow-xl border border-slate-700/50 flex flex-col md:flex-row items-center justify-between gap-8">
          <div class="max-w-2xl">
            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-brand-primary/30 text-brand-secondary border border-brand-primary/40 mb-3">
              Zero-Risk Assessment
            </span>
            <h3 class="text-2xl md:text-3xl font-bold text-white mb-3">
              Need Expert Architecture Guidance for Your Organization?
            </h3>
            <p class="text-slate-300 text-sm md:text-base leading-relaxed">
              Get an end-to-end audit of your LMS infrastructure, SCORM/xAPI packages, or localized course libraries in 24–48 hours from senior learning architects.
            </p>
          </div>
          <div class="flex-shrink-0 w-full md:w-auto">
            <a href="/book-free-audit/" class="inline-flex items-center justify-center w-full md:w-auto px-7 py-3.5 rounded-xl bg-brand-primary hover:bg-brand-primary/90 text-white font-bold text-base shadow-lg shadow-brand-primary/30 transition-all hover:scale-105">
              Claim Your Free 24–48h Audit
              <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
            </a>
          </div>
        </div>

      </div>
    </section>

  </main>
</Layout>
