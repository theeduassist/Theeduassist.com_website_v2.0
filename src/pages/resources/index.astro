---
import Layout from "../../layouts/Layout.astro";
import ResourceCard from "../../components/resources/ResourceCard.astro";
import { getCollection } from 'astro:content';

const allResources = await getCollection('resources');
const resources = allResources
  .filter(r => !r.data.noindex)
  .sort((a, b) => new Date(b.data.publishedAt || b.data.updatedAt || new Date()).valueOf() - new Date(a.data.publishedAt || a.data.updatedAt || new Date()).valueOf());

const featuredResources = resources.filter(r => r.data.featured).slice(0, 3);
const latestResources = resources.filter(r => !r.data.featured).slice(0, 9);

const categories = [
  { name: "Localization", slug: "localization", count: resources.filter(r => r.data.category === 'localization').length },
  { name: "Customer Education", slug: "customer-education", count: resources.filter(r => r.data.category === 'customer-education').length },
  { name: "Knowledge Bases", slug: "knowledge-bases", count: resources.filter(r => r.data.category === 'knowledge-bases').length },
  { name: "SaaS Training", slug: "saas-training", count: resources.filter(r => r.data.category === 'saas-training').length },
  { name: "Technical Documentation", slug: "technical-documentation", count: resources.filter(r => r.data.category === 'technical-documentation').length },
  { name: "Learning Technology", slug: "learning-technology", count: resources.filter(r => r.data.category === 'learning-technology').length },
  { name: "Instructional Design", slug: "instructional-design", count: resources.filter(r => r.data.category === 'instructional-design').length },
  { name: "Accessibility", slug: "accessibility", count: resources.filter(r => r.data.category === 'accessibility').length },
  { name: "Global eLearning", slug: "global-elearning", count: resources.filter(r => r.data.category === 'global-elearning').length },
  { name: "Glossary", slug: "glossary", count: resources.filter(r => r.data.category === 'glossary').length },
].filter(c => c.count > 0);

const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Learning Knowledge Hub | TheEduAssist",
  "description": "Practical research-informed guides for eLearning, Customer Education, Localization and Learning Technology.",
  "url": "https://www.theeduassist.com/resources/"
};
---

<Layout
  title="Learning Knowledge Hub | Research & Practical Guides | TheEduAssist"
  description="Explore peer-reviewed, practical guidance for building, localizing, and scaling workplace training, knowledge bases, customer education, and enterprise LMS architectures."
  canonicalPath="/resources/"
  jsonLd={[structuredData]}
>
  <main id="main-content">

    <!-- Hero Section with Modern UI -->
    <div class="bg-gradient-to-br from-brand-navy via-slate-900 to-brand-navy pt-32 pb-24 text-white text-center px-4 relative overflow-hidden">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_30%,rgba(59,130,246,0.12),transparent_70%)] pointer-events-none"></div>
      <div class="max-w-4xl mx-auto relative z-10">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-accent/20 border border-brand-accent/30 text-brand-secondary text-xs font-semibold uppercase tracking-wider mb-6">
            <span>📚 Verified Research & Practice</span>
          </div>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold mb-6 tracking-tight">TheEduAssist Knowledge Hub</h1>
          <p class="text-lg md:text-xl text-slate-300 mb-8 max-w-3xl mx-auto leading-relaxed">
            Evidence-based frameworks, instructional methodologies, and technical blueprints for enterprise L&D, SaaS education, and global learning systems.
          </p>
          <div class="flex flex-wrap justify-center gap-3">
            <a href="/book-free-audit/" class="inline-flex items-center justify-center px-6 py-3 rounded-lg bg-brand-accent text-white font-bold text-sm hover:bg-white hover:text-brand-navy transition-all shadow-md">
              Request Free 24–48h Architecture Audit &rarr;
            </a>
            <a href="/blog/" class="inline-flex items-center justify-center px-6 py-3 rounded-lg bg-white/10 text-white font-semibold text-sm hover:bg-white/20 transition-all border border-white/20">
              Read Latest Insights & Analysis
            </a>
          </div>
      </div>
    </div>

    <!-- Core Foundational Frameworks Banner -->
    <section class="py-12 bg-slate-50 border-b border-slate-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-8">
          <span class="text-xs uppercase tracking-widest text-brand-green font-bold bg-emerald-50 px-3 py-1 rounded-full border border-emerald-100">Featured Authoritative Guides</span>
          <h2 class="text-2xl font-bold text-brand-navy mt-2">Workforce Capabilities & Instructional Frameworks</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <a href="/blog/what-is-technical-proficiency/" class="p-6 bg-white rounded-xl border border-slate-200 hover:border-brand-green hover:shadow-md transition-all group block">
            <span class="text-xs font-semibold text-brand-green uppercase tracking-wider">Evaluation Framework</span>
            <h3 class="text-lg font-bold text-brand-navy mt-2 group-hover:text-brand-green transition-colors">What Is Technical Proficiency?</h3>
            <p class="text-slate-600 text-sm mt-2 line-clamp-3">Master the 4-tier proficiency rubric, workplace assessment criteria, and technical evaluation methods for modern L&D teams.</p>
            <span class="text-xs text-brand-green font-semibold mt-4 inline-flex items-center">Read Definitive Guide &rarr;</span>
          </a>
          <a href="/blog/what-is-teachability/" class="p-6 bg-white rounded-xl border border-slate-200 hover:border-brand-green hover:shadow-md transition-all group block">
            <span class="text-xs font-semibold text-brand-green uppercase tracking-wider">Learning Psychology</span>
            <h3 class="text-lg font-bold text-brand-navy mt-2 group-hover:text-brand-green transition-colors">What Is Teachability?</h3>
            <p class="text-slate-600 text-sm mt-2 line-clamp-3">Explore the 5 mindset pillars of learner receptivity, behavioral evaluation interview questions, and continuous upskilling strategies.</p>
            <span class="text-xs text-brand-green font-semibold mt-4 inline-flex items-center">Read Definitive Guide &rarr;</span>
          </a>
          <a href="/blog/primary-and-secondary-technical-domain-skills/" class="p-6 bg-white rounded-xl border border-slate-200 hover:border-brand-green hover:shadow-md transition-all group block">
            <span class="text-xs font-semibold text-brand-green uppercase tracking-wider">Competency Architecture</span>
            <h3 class="text-lg font-bold text-brand-navy mt-2 group-hover:text-brand-green transition-colors">Primary & Secondary Domain Skills</h3>
            <p class="text-slate-600 text-sm mt-2 line-clamp-3">Role-by-role competency matrices across Software, L&D, Data Science, and candidate application prompts.</p>
            <span class="text-xs text-brand-green font-semibold mt-4 inline-flex items-center">Read Definitive Guide &rarr;</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Executive & Creator Toolkits (Direct PDF Downloads) -->
    <section class="py-16 bg-slate-900 text-white relative overflow-hidden">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_70%_20%,rgba(34,197,94,0.1),transparent_60%)] pointer-events-none"></div>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="max-w-3xl mx-auto text-center mb-12">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-brand-green/20 text-brand-green text-xs font-bold tracking-wider uppercase mb-3 border border-brand-green/30">
            📥 Instant Client Downloads
          </span>
          <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight">Executive Playbooks & Creator Blueprints</h2>
          <p class="text-slate-300 text-base md:text-lg mt-3 leading-relaxed">
            Download our verified procurement statements, 40-point RFP scoring rubrics, L&D ROI calculation formulas, and course curriculum blueprints.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <!-- Toolkit 1 -->
          <div class="bg-white/5 border border-white/10 rounded-2xl p-6 hover:border-brand-green/50 hover:bg-white/[0.08] transition-all flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="px-2.5 py-1 rounded text-2xs font-bold tracking-wider uppercase bg-brand-green/20 text-brand-green border border-brand-green/30">Government & Enterprise</span>
                <span class="text-xs text-slate-400 font-mono">PDF &bull; 2026 Edition</span>
              </div>
              <h3 class="text-xl font-bold text-white mb-2">Enterprise & Public Sector Capability Statement</h3>
              <p class="text-slate-300 text-sm leading-relaxed mb-6">
                Official vendor procurement profile, Section 508 and WCAG 2.1 AA accessibility compliance specifications, SCORM/xAPI interoperability, and 500+ program delivery metrics.
              </p>
            </div>
            <a href="/downloads/enterprise-capability-statement/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center px-4 py-2.5 rounded-lg bg-brand-green text-brand-navy font-bold text-sm hover:bg-green-400 transition-all shadow-sm">
              Download Capability PDF &rarr;
            </a>
          </div>

          <!-- Toolkit 2 -->
          <div class="bg-white/5 border border-white/10 rounded-2xl p-6 hover:border-brand-green/50 hover:bg-white/[0.08] transition-all flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="px-2.5 py-1 rounded text-2xs font-bold tracking-wider uppercase bg-blue-500/20 text-blue-400 border border-blue-500/30">Procurement Audit</span>
                <span class="text-xs text-slate-400 font-mono">PDF &bull; 40-Point Rubric</span>
              </div>
              <h3 class="text-xl font-bold text-white mb-2">eLearning Vendor RFP Scoring Matrix</h3>
              <p class="text-slate-300 text-sm leading-relaxed mb-6">
                Objective 40-point evaluation scoring matrix used by procurement committees to grade vendor bids across technical architecture, accessibility, pedagogy, and SLAs.
              </p>
            </div>
            <a href="/downloads/procurement-rfp-evaluation-matrix/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center px-4 py-2.5 rounded-lg bg-white/10 text-white font-bold text-sm hover:bg-white/20 border border-white/20 transition-all">
              Download RFP Matrix (PDF) &rarr;
            </a>
          </div>

          <!-- Toolkit 3 -->
          <div class="bg-white/5 border border-white/10 rounded-2xl p-6 hover:border-brand-green/50 hover:bg-white/[0.08] transition-all flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="px-2.5 py-1 rounded text-2xs font-bold tracking-wider uppercase bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">C-Suite L&D</span>
                <span class="text-xs text-slate-400 font-mono">PDF &bull; Financial Model</span>
              </div>
              <h3 class="text-xl font-bold text-white mb-2">Enterprise L&D ROI & Kirkpatrick Playbook</h3>
              <p class="text-slate-300 text-sm leading-relaxed mb-6">
                Data-driven financial formulas to calculate training ROI, prove seat-time cost reductions vs. in-person training, and present boardroom-ready Kirkpatrick impact metrics.
              </p>
            </div>
            <a href="/downloads/enterprise-ld-roi-playbook/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center px-4 py-2.5 rounded-lg bg-white/10 text-white font-bold text-sm hover:bg-white/20 border border-white/20 transition-all">
              Download ROI Playbook (PDF) &rarr;
            </a>
          </div>

          <!-- Toolkit 4 -->
          <div class="bg-white/5 border border-white/10 rounded-2xl p-6 hover:border-brand-green/50 hover:bg-white/[0.08] transition-all flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="px-2.5 py-1 rounded text-2xs font-bold tracking-wider uppercase bg-amber-500/20 text-amber-400 border border-amber-500/30">Creator & Academy</span>
                <span class="text-xs text-slate-400 font-mono">PDF &bull; Dream Pro Style</span>
              </div>
              <h3 class="text-xl font-bold text-white mb-2">The 7-Figure Course Architecture Blueprint</h3>
              <p class="text-slate-300 text-sm leading-relaxed mb-6">
                The 4-D Course Architecture and 4-part high-retention lesson structure that turns low-completion information dumps into scalable, high-earning digital academies.
              </p>
            </div>
            <a href="/downloads/7-figure-course-blueprint/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center px-4 py-2.5 rounded-lg bg-amber-400 text-brand-navy font-bold text-sm hover:bg-amber-300 transition-all shadow-sm">
              Download Course Blueprint (PDF) &rarr;
            </a>
          </div>

          <!-- Toolkit 5 -->
          <div class="bg-white/5 border border-white/10 rounded-2xl p-6 hover:border-brand-green/50 hover:bg-white/[0.08] transition-all flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="px-2.5 py-1 rounded text-2xs font-bold tracking-wider uppercase bg-purple-500/20 text-purple-400 border border-purple-500/30">Instructional Design</span>
                <span class="text-xs text-slate-400 font-mono">PDF &bull; Action Mapping</span>
              </div>
              <h3 class="text-xl font-bold text-white mb-2">Rapid Storyboarding & Action-Mapping Kit</h3>
              <p class="text-slate-300 text-sm leading-relaxed mb-6">
                Practical branching scenario templates, 2-column video scripts, cognitive load chunking rules, and pre-flight LMS QA checklists for course developers.
              </p>
            </div>
            <a href="/downloads/rapid-storyboarding-toolkit/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center px-4 py-2.5 rounded-lg bg-white/10 text-white font-bold text-sm hover:bg-white/20 border border-white/20 transition-all">
              Download Storyboard Kit (PDF) &rarr;
            </a>
          </div>

          <!-- Custom Request Box -->
          <div class="bg-gradient-to-br from-blue-900/40 to-brand-green/10 border border-brand-green/30 rounded-2xl p-6 flex flex-col justify-between">
            <div>
              <span class="px-2.5 py-1 rounded text-2xs font-bold tracking-wider uppercase bg-white/20 text-white border border-white/30">Custom Enterprise Request</span>
              <h3 class="text-xl font-bold text-white mt-3 mb-2">Need a Formal Capability Presentation?</h3>
              <p class="text-slate-300 text-sm leading-relaxed mb-6">
                Our solutions team prepares customized RFP response decks, accessibility statements (VPAT), and technical LMS compatibility audits within 24–48 hours.
              </p>
            </div>
            <a href="/book-free-audit/" class="inline-flex items-center justify-center px-4 py-2.5 rounded-lg bg-brand-green text-brand-navy font-bold text-sm hover:bg-green-400 transition-all shadow-md">
              Request Enterprise Review &rarr;
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Categories & Guides Section -->
    <section class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

        {categories.length > 0 && (
          <div class="mb-16">
            <h2 class="text-2xl font-bold text-brand-navy mb-6 text-center">Browse by Topic</h2>
            <div class="flex flex-wrap justify-center gap-3">
              {categories.map(category => (
                <a href={`/resources/${category.slug}/`} class="inline-flex items-center px-4 py-2 rounded-full border border-slate-200 bg-slate-50 text-brand-navy font-medium hover:bg-brand-primary hover:text-white hover:border-brand-primary transition-colors shadow-2xs">
                  {category.name} <span class="ml-2 text-xs opacity-70">({category.count})</span>
                </a>
              ))}
            </div>
          </div>
        )}

        <div class="mb-16 bg-gradient-to-r from-slate-50 via-emerald-50/40 to-slate-50 p-8 rounded-2xl border border-emerald-100/80 text-center">
            <h3 class="text-2xl font-bold text-brand-navy mb-3">Global eLearning, Compliance & Market Readiness</h3>
            <p class="text-slate-600 mb-6 max-w-2xl mx-auto text-sm md:text-base">
                Explore international localization, WCAG 2.2 accessibility, learner data privacy regulations (GDPR, BDSG, POPIA, DPDPA), and cross-border delivery architectures.
            </p>
            <a href="/resources/global-elearning/" class="inline-flex items-center justify-center px-6 py-3 text-sm font-bold text-white bg-brand-primary rounded-lg hover:bg-brand-accent transition-colors shadow-sm focus-ring">
                Explore Global eLearning Resources &rarr;
            </a>
        </div>

        {featuredResources.length > 0 && (
          <div class="mb-20">
            <h2 class="text-2xl md:text-3xl font-bold text-brand-navy mb-8 border-b border-slate-200 pb-4">Featured Research Guides</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
              {featuredResources.map(resource => (
                <ResourceCard resource={resource} />
              ))}
            </div>
          </div>
        )}

        {latestResources.length > 0 && (
          <div>
            <h2 class="text-2xl md:text-3xl font-bold text-brand-navy mb-8 border-b border-slate-200 pb-4">Latest Knowledge Base Articles</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
              {latestResources.map(resource => (
                <ResourceCard resource={resource} />
              ))}
            </div>
          </div>
        )}

      </div>
    </section>

  </main>
</Layout>
