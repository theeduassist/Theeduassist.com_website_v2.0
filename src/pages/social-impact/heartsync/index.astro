---
import Layout from "../../../layouts/Layout.astro";
import { 
  Heart, 
  Activity, 
  Video, 
  Smartphone, 
  ShieldCheck, 
  CheckCircle2, 
  Hospital, 
  Users, 
  ArrowRight, 
  Clock, 
  Sparkles, 
  ExternalLink, 
  Lock, 
  Eye, 
  Calendar, 
  DollarSign, 
  BrainCircuit, 
  MessageSquare, 
  Send, 
  CheckCircle,
  HelpCircle,
  Layers,
  HeartHandshake,
  Compass,
  FileText
} from "lucide-react";
import { breadcrumbSchema } from "../../../lib/seo/schema";

const jsonLd = [
  breadcrumbSchema([
    { name: "Home", urlPath: "/" },
    { name: "Social Impact", urlPath: "/social-impact/" },
    { name: "Project HeartSync", urlPath: "/social-impact/heartsync/" }
  ]),
  {
    "@context": "https://schema.org",
    "@type": "MedicalWebPage",
    "name": "Project HeartSync | Humanitarian Healthcare & Inpatient Mental Health Ecosystem | TheEduAssist",
    "description": "HeartSync is a philanthropic digital health platform engineered by TheEduAssist, connecting 1,400+ long-stay psychiatric inpatients at Punjab Institute of Mental Health (PIMH Lahore) with their distant families.",
    "url": "https://www.theeduassist.com/social-impact/heartsync/",
    "about": [
      {
        "@type": "MedicalCondition",
        "name": "Psychiatric Rehabilitation & Chronic Ward Isolation"
      }
    ],
    "creator": {
      "@type": "Organization",
      "name": "TheEduAssist",
      "url": "https://www.theeduassist.com"
    }
  }
];
---

<Layout
  title="Project HeartSync | Philanthropic Mental Health Digital Ecosystem | TheEduAssist"
  description="HeartSync is a philanthropic digital health initiative connecting 1,400+ psychiatric patients at Punjab Institute of Mental Health (PIMH Lahore) with their distant families through resilient ward kiosks and zero-install mobile video links."
  canonicalPath="/social-impact/heartsync/"
  jsonLd={jsonLd}
>
  <main class="min-h-screen bg-slate-50 text-slate-800 antialiased selection:bg-teal-500 selection:text-white">
    
    <!-- Hero Section -->
    <section class="relative overflow-hidden bg-gradient-to-b from-[#0B1F3A] via-[#11324D] to-[#0D3B4C] text-white pt-24 pb-20 md:pt-32 md:pb-28">
      <!-- Ambient Lighting -->
      <div class="absolute -top-40 -left-40 w-96 h-96 bg-teal-500/20 rounded-full blur-3xl pointer-events-none animate-ambient-drift"></div>
      <div class="absolute -bottom-40 -right-40 w-96 h-96 bg-emerald-500/15 rounded-full blur-3xl pointer-events-none animate-ambient-drift" style="animation-delay: -6s;"></div>
      
      <!-- Subtle Grid Pattern -->
      <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#14b8a6_1px,transparent_1px)] [background-size:24px_24px] pointer-events-none"></div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <!-- Sub-Header Meta Badge -->
        <div class="flex flex-wrap items-center gap-3 mb-6">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-teal-500/15 border border-teal-400/30 text-teal-300 text-xs font-bold tracking-wide uppercase">
            <span class="w-2 h-2 rounded-full bg-teal-400 animate-pulse"></span>
            Philanthropic Healthcare Initiative
          </div>
          <span class="text-xs text-slate-300 font-medium">Deployed at Punjab Institute of Mental Health (PIMH), Lahore</span>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
          <div class="lg:col-span-7 space-y-6">
            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-white leading-tight tracking-tight">
              Medicine Stabilizes the Mind. <br />
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-teal-300 via-emerald-300 to-amber-300">
                Familiar Voices Heal the Soul.
              </span>
            </h1>

            <p class="text-lg sm:text-xl text-slate-200 max-w-2xl leading-relaxed">
              A philanthropic digital health ecosystem engineered by TheEduAssist, connecting long-stay psychiatric patients with their distant families at Pakistan's largest psychiatric hospital through rugged ward kiosks, clinician review gates, and zero-install mobile video links.
            </p>

            <!-- Dual Action CTAs -->
            <div class="flex flex-wrap gap-4 pt-4">
              <a 
                href="https://pims-family.vercel.app" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="btn-shimmer inline-flex items-center justify-center px-6 py-3.5 rounded-xl font-black text-sm sm:text-base bg-teal-500 hover:bg-teal-400 text-slate-950 shadow-lg shadow-teal-500/25 transition-all hover:-translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-teal-400"
              >
                <Smartphone className="w-5 h-5 mr-2" />
                Live Family Portal Demo
                <ExternalLink className="w-4 h-4 ml-2" />
              </a>

              <a 
                href="https://pims-hospital.vercel.app" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="inline-flex items-center justify-center px-6 py-3.5 rounded-xl font-bold text-sm sm:text-base bg-white/10 hover:bg-white/20 border border-white/20 text-white transition-all hover:-translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-slate-300"
              >
                <Hospital className="w-5 h-5 mr-2" />
                Hospital OS Terminal
                <ExternalLink className="w-4 h-4 ml-2" />
              </a>

              <a 
                href="#workflow" 
                class="inline-flex items-center justify-center px-5 py-3.5 rounded-xl font-semibold text-sm text-teal-200 hover:text-white hover:bg-white/5 transition-colors"
              >
                Explore End-to-End Workflow
                <ArrowRight className="w-4 h-4 ml-1.5" />
              </a>
            </div>

            <!-- Trust Badges Strip -->
            <div class="pt-6 border-t border-white/10 grid grid-cols-2 sm:grid-cols-4 gap-4 text-xs font-semibold text-slate-300">
              <div class="flex items-center gap-2">
                <CheckCircle2 className="w-4 h-4 text-teal-400 shrink-0" />
                <span>1,400+ Beds Supported</span>
              </div>
              <div class="flex items-center gap-2">
                <CheckCircle2 className="w-4 h-4 text-teal-400 shrink-0" />
                <span>PIMH Lahore Deployment</span>
              </div>
              <div class="flex items-center gap-2">
                <CheckCircle2 className="w-4 h-4 text-teal-400 shrink-0" />
                <span>100% Non-Profit Initiative</span>
              </div>
              <div class="flex items-center gap-2">
                <CheckCircle2 className="w-4 h-4 text-teal-400 shrink-0" />
                <span>Bilingual Urdu & English</span>
              </div>
            </div>
          </div>

          <!-- Hero Telemetry & Interactive Preview Card -->
          <div class="lg:col-span-5">
            <div class="bg-gradient-to-b from-slate-800/90 to-slate-900/95 backdrop-blur-xl border border-teal-500/30 rounded-3xl p-6 sm:p-8 shadow-2xl text-white relative">
              <div class="flex items-center justify-between border-b border-white/10 pb-4 mb-6">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-xl bg-teal-500/20 text-teal-400 flex items-center justify-center font-bold">
                    <Heart className="w-5 h-5 text-teal-400" />
                  </div>
                  <div>
                    <h3 class="text-base font-bold text-white leading-tight">HeartSync Telemetry</h3>
                    <p class="text-xs text-teal-300">Active Deployment Metrics</p>
                  </div>
                </div>
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-500/20 text-emerald-300 text-xs font-bold border border-emerald-500/30">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span>
                  Live in Wards
                </span>
              </div>

              <!-- Quick Metrics Grid -->
              <div class="grid grid-cols-2 gap-4 mb-6">
                <div class="p-3.5 bg-white/5 rounded-2xl border border-white/5">
                  <div class="text-2xl font-black text-teal-300">1,400+</div>
                  <div class="text-xs text-slate-300">Inpatient Beds Covered</div>
                </div>
                <div class="p-3.5 bg-white/5 rounded-2xl border border-white/5">
                  <div class="text-2xl font-black text-emerald-300">10,000+</div>
                  <div class="text-xs text-slate-300">Family Members Impacted</div>
                </div>
                <div class="p-3.5 bg-white/5 rounded-2xl border border-white/5">
                  <div class="text-2xl font-black text-amber-300">Rs. 0</div>
                  <div class="text-xs text-slate-300">Cost to Families</div>
                </div>
                <div class="p-3.5 bg-white/5 rounded-2xl border border-white/5">
                  <div class="text-2xl font-black text-cyan-300">70%</div>
                  <div class="text-xs text-slate-300">Nurse Phone Load Cut</div>
                </div>
              </div>

              <!-- Workflow Micro Preview -->
              <div class="space-y-3 bg-black/20 rounded-2xl p-4 border border-white/5 text-xs text-slate-300">
                <div class="flex items-center justify-between font-bold text-white pb-2 border-b border-white/5">
                  <span>Clinical Safeguard Pipeline</span>
                  <span class="text-teal-400">Doctor-Gated</span>
                </div>
                <div class="flex items-center gap-3">
                  <span class="w-5 h-5 rounded-full bg-teal-500/20 text-teal-300 flex items-center justify-center text-[10px] font-bold">1</span>
                  <span>Supervised Ward Kiosk Video Recording</span>
                </div>
                <div class="flex items-center gap-3">
                  <span class="w-5 h-5 rounded-full bg-teal-500/20 text-teal-300 flex items-center justify-center text-[10px] font-bold">2</span>
                  <span>Psychiatrist Clinical Approval Gate</span>
                </div>
                <div class="flex items-center gap-3">
                  <span class="w-5 h-5 rounded-full bg-teal-500/20 text-teal-300 flex items-center justify-center text-[10px] font-bold">3</span>
                  <span>Zero-Install WhatsApp Family Connection</span>
                </div>
              </div>

              <div class="mt-6 pt-4 border-t border-white/10 flex items-center justify-between text-xs text-slate-400">
                <span>Built pro-bono by TheEduAssist Studio</span>
                <span class="text-teal-300 font-semibold">Lahore, Pakistan</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- The Human Story & Problem -->
    <section class="py-20 bg-white border-b border-slate-200" id="the-story">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <span class="text-teal-600 font-bold uppercase tracking-wider text-xs">The Human Reality</span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 mt-2 tracking-tight">
            The Heartbreak of Chronic Ward Isolation
          </h2>
          <p class="text-slate-600 mt-4 text-base sm:text-lg leading-relaxed">
            In long-stay mental health institutions, psychiatric stabilization is only half the battle. When patients are severed from family contact, isolation breeds hopelessness and slows neurological recovery.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
          <!-- Barrier 1 -->
          <div class="card-glow-lift bg-slate-50 border border-slate-200/80 rounded-2xl p-8">
            <div class="w-12 h-12 rounded-xl bg-teal-100 text-teal-700 flex items-center justify-center font-black mb-6">
              <Compass className="w-6 h-6" />
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-3">Crushing Travel Distance</h3>
            <p class="text-slate-600 text-sm leading-relaxed">
              Patients at PIMH arrive from all 36 districts of Punjab and neighboring provinces—often traveling 300 to 500 km from remote villages in Rajanpur, D.G. Khan, or Bahawalpur. For families without private vehicles, reaching Lahore requires days of grueling transit.
            </p>
          </div>

          <!-- Barrier 2 -->
          <div class="card-glow-lift bg-slate-50 border border-slate-200/80 rounded-2xl p-8">
            <div class="w-12 h-12 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center font-black mb-6">
              <DollarSign className="w-6 h-6" />
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-3">Severe Financial Drain</h3>
            <p class="text-slate-600 text-sm leading-relaxed">
              A single visit to Lahore costs an impoverished rural family between <span class="font-bold text-slate-900">Rs. 7,500 and Rs. 15,000 PKR</span> in bus tickets, lost daily wages, and food. For families surviving on minimum wage, visiting monthly is economically impossible.
            </p>
          </div>

          <!-- Barrier 3 -->
          <div class="card-glow-lift bg-slate-50 border border-slate-200/80 rounded-2xl p-8">
            <div class="w-12 h-12 rounded-xl bg-rose-100 text-rose-700 flex items-center justify-center font-black mb-6">
              <Users className="w-6 h-6" />
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-3">The "Abandoned Patient" Crisis</h3>
            <p class="text-slate-600 text-sm leading-relaxed">
              Months of communication blackout cause families to lose hope or fear that their loved one cannot reintegrate into society. Clinically stabilized patients frequently remain stuck in hospital beds simply because family ties have withered away.
            </p>
          </div>
        </div>

        <!-- Callout Banner -->
        <div class="bg-gradient-to-r from-teal-900 to-slate-900 rounded-3xl p-8 md:p-12 text-white shadow-xl relative overflow-hidden">
          <div class="absolute -right-20 -bottom-20 w-80 h-80 bg-teal-500/20 rounded-full blur-3xl pointer-events-none"></div>
          <div class="max-w-3xl relative z-10">
            <span class="text-teal-400 font-bold uppercase tracking-wider text-xs">Our Core Insight</span>
            <h3 class="text-2xl sm:text-3xl font-bold mt-2 text-white leading-tight">
              A 60-Second Video from Home is Active Clinical Medicine
            </h3>
            <p class="text-slate-300 mt-4 text-base sm:text-lg leading-relaxed">
              Hearing a daughter say <em>"Abba, we miss you, please take your medicine and come home"</em> or seeing an elderly mother smiling directly reduces clinical agitation, restores patient cooperation with therapy, and reminds patients that they are loved and expected back.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 1: The End-to-End Workflow -->
    <section class="py-20 lg:py-28 bg-slate-100" id="workflow">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <span class="text-teal-600 font-bold uppercase tracking-wider text-xs">Clinical Engineering</span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 mt-2 tracking-tight">
            How HeartSync Works in Daily Hospital Life
          </h2>
          <p class="text-slate-600 mt-4 text-base sm:text-lg leading-relaxed">
            Designed for high-traffic public hospital wards, HeartSync connects the hospital bedside, clinical doctor review desks, and family smartphones in seven closed-loop steps.
          </p>
        </div>

        <!-- Visual Architecture Diagram Card -->
        <div class="bg-slate-900 text-slate-100 rounded-3xl p-6 sm:p-10 shadow-2xl mb-16 border border-slate-800">
          <div class="flex items-center justify-between pb-6 mb-8 border-b border-slate-800 text-xs sm:text-sm">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-teal-400"></span>
              <span class="font-bold text-white">Closed-Loop Psychiatric Communication Flow</span>
            </div>
            <span class="text-teal-400 font-mono">PIMH Wards ⇄ Clinical Cloud ⇄ Family Mobile</span>
          </div>

          <!-- Flowchart Grid -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 relative">
            <!-- Column 1: Hospital Ward -->
            <div class="bg-slate-800/80 rounded-2xl p-6 border border-teal-500/20 flex flex-col justify-between">
              <div>
                <div class="inline-block px-3 py-1 rounded-full bg-teal-500/20 text-teal-300 font-bold text-xs uppercase mb-3">
                  1. Hospital Ward
                </div>
                <h4 class="text-lg font-bold text-white mb-2">Ward Kiosk Recording</h4>
                <p class="text-slate-300 text-xs leading-relaxed">
                  Supervised 30–60 second check-in recorded on durable, locked Android touchscreen kiosks right in the patient ward.
                </p>
              </div>
              <div class="mt-6 pt-4 border-t border-slate-700/60 text-xs text-teal-300 flex items-center gap-2">
                <Video className="w-4 h-4" />
                <span>Supervised by Duty Nurse</span>
              </div>
            </div>

            <!-- Column 2: Clinical Cloud -->
            <div class="bg-slate-800/80 rounded-2xl p-6 border border-amber-500/20 flex flex-col justify-between">
              <div>
                <div class="inline-block px-3 py-1 rounded-full bg-amber-500/20 text-amber-300 font-bold text-xs uppercase mb-3">
                  2. Clinical Cloud & Safety
                </div>
                <h4 class="text-lg font-bold text-white mb-2">Doctor Review Gate</h4>
                <p class="text-slate-300 text-xs leading-relaxed">
                  Every video is clinically inspected by duty psychiatrists to ensure emotional stability and patient dignity before cloud dispatch.
                </p>
              </div>
              <div class="mt-6 pt-4 border-t border-slate-700/60 text-xs text-amber-300 flex items-center gap-2">
                <ShieldCheck className="w-4 h-4" />
                <span>Psychiatric Safety Vetting</span>
              </div>
            </div>

            <!-- Column 3: Family's Home -->
            <div class="bg-slate-800/80 rounded-2xl p-6 border border-emerald-500/20 flex flex-col justify-between">
              <div>
                <div class="inline-block px-3 py-1 rounded-full bg-emerald-500/20 text-emerald-300 font-bold text-xs uppercase mb-3">
                  3. Family Smartphone
                </div>
                <h4 class="text-lg font-bold text-white mb-2">Private Family Portal</h4>
                <p class="text-slate-300 text-xs leading-relaxed">
                  Family receives an instant WhatsApp link. Opens in mobile browser without installation. Family watches and replies with live video.
                </p>
              </div>
              <div class="mt-6 pt-4 border-t border-slate-700/60 text-xs text-emerald-300 flex items-center gap-2">
                <Smartphone className="w-4 h-4" />
                <span>Zero Installation Needed</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Detailed 7-Step List -->
        <div class="space-y-6">
          <!-- Step 1 -->
          <div class="bg-white rounded-2xl p-6 sm:p-8 border border-slate-200/80 shadow-sm flex flex-col md:flex-row gap-6 items-start">
            <div class="w-12 h-12 rounded-2xl bg-teal-600 text-white font-black text-lg flex items-center justify-center shrink-0 shadow-md">
              01
            </div>
            <div class="space-y-2 flex-grow">
              <div class="flex items-center gap-3">
                <h3 class="text-xl font-bold text-slate-900">Patient Admission & Secure Profile Creation</h3>
                <span class="text-xs bg-slate-100 text-slate-600 font-semibold px-2.5 py-0.5 rounded-full border border-slate-200">Hospital Ward</span>
              </div>
              <p class="text-slate-600 text-sm leading-relaxed">
                When a patient is admitted to a ward at the Punjab Institute of Mental Health (PIMH), the clinical team registers them into the HeartSync Clinical OS. A unique, secure Patient ID & Access Token is generated. No sensitive national identity details or medical charts are exposed publicly. The designated family telephone number is authenticated and linked.
              </p>
            </div>
          </div>

          <!-- Step 2 -->
          <div class="bg-white rounded-2xl p-6 sm:p-8 border border-slate-200/80 shadow-sm flex flex-col md:flex-row gap-6 items-start">
            <div class="w-12 h-12 rounded-2xl bg-teal-600 text-white font-black text-lg flex items-center justify-center shrink-0 shadow-md">
              02
            </div>
            <div class="space-y-2 flex-grow">
              <div class="flex items-center gap-3">
                <h3 class="text-xl font-bold text-slate-900">Supervised Recording at the Ward Kiosk</h3>
                <span class="text-xs bg-slate-100 text-slate-600 font-semibold px-2.5 py-0.5 rounded-full border border-slate-200">Bedside / Ward</span>
              </div>
              <p class="text-slate-600 text-sm leading-relaxed">
                A durable touchscreen kiosk, positioned inside the ward under attendant supervision, opens the patient's recording session. The nurse guides the patient in recording a short 30 to 60-second reassuring video message or a cheerful photo update. If a patient is non-verbal, a dignified visual greeting confirming comfort and rest is captured.
              </p>
            </div>
          </div>

          <!-- Step 3 -->
          <div class="bg-white rounded-2xl p-6 sm:p-8 border border-slate-200/80 shadow-sm flex flex-col md:flex-row gap-6 items-start">
            <div class="w-12 h-12 rounded-2xl bg-amber-600 text-white font-black text-lg flex items-center justify-center shrink-0 shadow-md">
              03
            </div>
            <div class="space-y-2 flex-grow">
              <div class="flex items-center gap-3">
                <h3 class="text-xl font-bold text-slate-900">Clinical Doctor Review & Psychiatric Safety Gate</h3>
                <span class="text-xs bg-amber-50 text-amber-800 font-semibold px-2.5 py-0.5 rounded-full border border-amber-200">Doctor Desk</span>
              </div>
              <p class="text-slate-600 text-sm leading-relaxed">
                Mental health recovery requires uncompromising emotional safety. Before any video leaves the hospital, it enters the Doctor Review Queue. The duty psychiatrist verifies that the patient is not experiencing acute manic distress that could frighten family members, and that patient dignity is preserved. Once approved with one click, the video is encrypted and uploaded.
              </p>
            </div>
          </div>

          <!-- Step 4 -->
          <div class="bg-white rounded-2xl p-6 sm:p-8 border border-slate-200/80 shadow-sm flex flex-col md:flex-row gap-6 items-start">
            <div class="w-12 h-12 rounded-2xl bg-teal-600 text-white font-black text-lg flex items-center justify-center shrink-0 shadow-md">
              04
            </div>
            <div class="space-y-2 flex-grow">
              <div class="flex items-center gap-3">
                <h3 class="text-xl font-bold text-slate-900">Instant SMS / WhatsApp Notification to the Family</h3>
                <span class="text-xs bg-slate-100 text-slate-600 font-semibold px-2.5 py-0.5 rounded-full border border-slate-200">Automated Dispatch</span>
              </div>
              <p class="text-slate-600 text-sm leading-relaxed">
                The family receives an automated WhatsApp or SMS notification: <em>"HeartSync PIMH: Your loved one has sent an update from Ward 5. Click to view: [pims-family.vercel.app/portal?id=...]"</em>. <strong>Zero Installation:</strong> No app downloads from the Play Store, no passwords to forget. The link opens directly in any standard mobile browser (Chrome, Safari).
              </p>
            </div>
          </div>

          <!-- Step 5 -->
          <div class="bg-white rounded-2xl p-6 sm:p-8 border border-slate-200/80 shadow-sm flex flex-col md:flex-row gap-6 items-start">
            <div class="w-12 h-12 rounded-2xl bg-teal-600 text-white font-black text-lg flex items-center justify-center shrink-0 shadow-md">
              05
            </div>
            <div class="space-y-2 flex-grow">
              <div class="flex items-center gap-3">
                <h3 class="text-xl font-bold text-slate-900">The Family Experiences the Connection</h3>
                <span class="text-xs bg-slate-100 text-slate-600 font-semibold px-2.5 py-0.5 rounded-full border border-slate-200">Mobile Portal</span>
              </div>
              <p class="text-slate-600 text-sm leading-relaxed">
                The family watches high-definition video of their loved one smiling and speaking. The portal displays empathetic guidance in both <strong class="text-teal-700">Urdu and English</strong>, including current health status, doctor reassurance, and culturally supportive suggestions on positive words of encouragement and prayers (دعا).
              </p>
            </div>
          </div>

          <!-- Step 6 -->
          <div class="bg-white rounded-2xl p-6 sm:p-8 border border-slate-200/80 shadow-sm flex flex-col md:flex-row gap-6 items-start">
            <div class="w-12 h-12 rounded-2xl bg-teal-600 text-white font-black text-lg flex items-center justify-center shrink-0 shadow-md">
              06
            </div>
            <div class="space-y-2 flex-grow">
              <div class="flex items-center gap-3">
