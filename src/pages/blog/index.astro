---
import Layout from "../../layouts/Layout.astro";
import { getBlogPostSummaries } from "../../lib/content/getAllBlogPosts";
import { blogCategories } from "../../data/blogArchitecture";
import BlogCard from "../../components/blog/BlogCard.astro";
import BlogCTA from "../../components/blog/BlogCTA.astro";

// Fetch posts
const allPosts = await getBlogPostSummaries();

// Find featured
const featuredPost = allPosts.find(p => p.featured) || allPosts[0];

// Categorize for hub
const latestPosts = allPosts.filter(p => p.id !== featuredPost?.id).slice(0, 6);
const enterprisePosts = allPosts.filter(p => p.primaryCategory === "enterprise-learning").slice(0, 3);
const kajabiPosts = allPosts.filter(p => p.primaryCategory === "kajabi").slice(0, 3);

// Active categories
const activeCategories = blogCategories.filter(cat => cat.publicVisibility && allPosts.some(p => p.primaryCategory === cat.id));

// All posts for search/filter (serialized for client-side JS)
const allPostsJson = JSON.stringify(allPosts.map(p => ({
  title: p.title,
  slug: p.slug,
  excerpt: p.excerpt,
  category: p.category,
  readingTime: p.readingTime,
  publishedAt: p.publishedAt,
  heroImage: p.heroImage,
  heroImageAlt: p.heroImageAlt,
  tags: p.tags,
})));

// Unique categories from posts
const postCategories = [...new Set(allPosts.map(p => p.category).filter(Boolean))];

const seoTitle = "TheEduAssist Blog | Practical Guidance for Learning Experiences";
const seoDescription = "Explore research-informed guidance on learning strategy, instructional design, course development, LMS implementation, Kajabi, and enterprise learning.";
---

<Layout
  title={seoTitle}
  description={seoDescription}
  canonicalPath="/blog/"
  robots="index, follow"
>
  <main class="w-full flex-grow flex flex-col bg-slate-50 overflow-hidden">
    <!-- Hero Section -->
    <section class="w-full py-16 md:py-24 px-6 md:px-12 max-w-7xl mx-auto flex flex-col items-center text-center">
      <div class="mb-4 text-sm font-semibold text-brand-green uppercase tracking-wider">
        TheEduAssist Blog
      </div>
      <h1 class="text-3xl md:text-5xl lg:text-6xl font-bold text-brand-blue mb-6 max-w-4xl">
        Practical Guidance for Building and Improving Learning Experiences
      </h1>
      <p class="text-lg md:text-xl text-slate-700 max-w-3xl mb-8">
        Explore research-informed guidance on learning strategy, instructional design, course development, LMS implementation, Kajabi, enterprise learning, responsible AI, accessibility and global delivery.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="#latest-articles" class="px-8 py-3 bg-brand-green text-white font-semibold rounded-md shadow-sm hover:bg-green-600 transition-colors focus:ring-2 focus:ring-offset-2 focus:ring-brand-green focus:outline-none">
          Browse Latest Articles
        </a>
        <a href="/services/" class="px-8 py-3 bg-white text-brand-blue font-semibold rounded-md shadow-sm border border-slate-200 hover:bg-slate-50 transition-colors focus:ring-2 focus:ring-offset-2 focus:ring-brand-blue focus:outline-none">
          Explore Services
        </a>
      </div>
    </section>

    <!-- Short Answer Section -->
    <section class="w-full py-12 px-6 md:px-12 max-w-4xl mx-auto bg-white rounded-xl shadow-sm border border-slate-100 mb-16">
      <h2 class="text-xl md:text-2xl font-bold text-brand-blue mb-4 text-center">
        What Will You Find in the TheEduAssist Blog?
      </h2>
      <p class="text-slate-700 text-center text-lg leading-relaxed">
        The Blog provides practical guidance for organizations, training teams, course businesses and learning professionals planning, building, modernizing or managing digital learning.
      </p>
    </section>

    <!-- Featured Post -->
    {featuredPost && (
      <section class="w-full py-12 px-6 md:px-12 max-w-7xl mx-auto mb-16">
        <div class="flex flex-col md:flex-row gap-8 bg-white rounded-xl shadow-sm border border-slate-100 overflow-hidden group">
          {featuredPost.heroImage && (
            <div class="md:w-1/2 h-64 md:h-auto relative overflow-hidden">
              <a href={`/blog/${featuredPost.slug}/`} class="block w-full h-full" tabindex="-1">
                <img
                  src={featuredPost.heroImage}
                  alt={featuredPost.heroImageAlt || featuredPost.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  width="800"
                  height="600"
                  loading="eager"
                />
              </a>
            </div>
          )}
          <div class="md:w-1/2 p-8 flex flex-col justify-center">
            <div class="flex items-center gap-3 mb-4">
              <span class="px-3 py-1 bg-slate-100 text-brand-blue text-xs font-semibold rounded-full uppercase tracking-wider">
                Featured Article
              </span>
            </div>
            <h2 class="text-2xl md:text-4xl font-bold text-brand-blue mb-4">
              <a href={`/blog/${featuredPost.slug}/`} class="hover:text-brand-green transition-colors">
                {featuredPost.title}
              </a>
            </h2>
            <p class="text-slate-600 text-lg mb-6 line-clamp-3">
              {featuredPost.excerpt}
            </p>
            <div class="flex items-center gap-4 text-sm text-slate-500">
              {featuredPost.author && (
                <div class="flex items-center gap-2">
                  <span class="font-medium">{featuredPost.author}</span>
                </div>
              )}
              {featuredPost.publishedAt && (
                <time datetime={featuredPost.publishedAt}>
                  {new Date(featuredPost.publishedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                </time>
              )}
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- Search and Filter -->
    <section class="w-full py-8 px-6 md:px-12 max-w-7xl mx-auto mb-8">
      <div class="flex flex-col md:flex-row gap-4 items-center">
        <input
          id="search-input"
          type="text"
          placeholder="Search articles..."
          class="w-full md:w-1/2 px-4 py-3 rounded-lg border border-slate-200 bg-white shadow-sm focus:outline-none focus:ring-2 focus:ring-brand-green text-slate-700"
        />
        <select
          id="category-filter"
          class="w-full md:w-1/4 px-4 py-3 rounded-lg border border-slate-200 bg-white shadow-sm focus:outline-none focus:ring-2 focus:ring-brand-green text-slate-700"
        >
          <option value="">All Categories</option>
          {postCategories.map(cat => (
            <option value={cat}>{cat}</option>
          ))}
        </select>
        <button
          id="clear-filters"
          class="px-6 py-3 bg-slate-100 text-brand-blue font-medium rounded-lg border border-slate-200 hover:bg-slate-200 transition-colors"
        >
          Clear
        </button>
      </div>
    </section>

    <!-- Search Results -->
    <section id="search-results" class="w-full px-6 md:px-12 max-w-7xl mx-auto mb-16 hidden">
      <h2 class="text-2xl font-bold text-brand-blue mb-6">Search Results</h2>
      <div id="search-results-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8"></div>
      <p id="no-results" class="text-slate-500 text-center py-12 hidden">No articles found. Try a different search term.</p>
    </section>

    <!-- Browse by Topic -->
    {activeCategories.length > 0 && (
      <section id="browse-section" class="w-full py-12 px-6 md:px-12 max-w-7xl mx-auto mb-16">
        <h2 class="text-2xl md:text-3xl font-bold text-brand-blue mb-8 text-center">Browse by Topic</h2>
        <div class="flex flex-wrap gap-4 justify-center">
          {activeCategories.map(cat => (
            <a href={cat.href} class="px-6 py-3 bg-white text-brand-blue font-medium rounded-full shadow-sm border border-slate-200 hover:bg-brand-green hover:text-white hover:border-brand-green transition-colors">
              {cat.title}
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Latest Articles -->
    {latestPosts.length > 0 && (
      <section id="latest-articles" class="w-full py-16 px-6 md:px-12 max-w-7xl mx-auto bg-slate-50 scroll-mt-20">
        <div class="flex justify-between items-end mb-8">
          <h2 class="text-2xl md:text-3xl font-bold text-brand-blue">Latest Articles</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {latestPosts.map(post => (
            <BlogCard
              title={post.title}
              slug={post.slug}
              excerpt={post.excerpt}
              category={post.category}
              readTimeMinutes={post.readingTime}
              publishedAt={post.publishedAt}
              image={post.heroImage}
              imageAlt={post.heroImageAlt}
              tags={post.tags}
            />
          ))}
        </div>
      </section>
    )}

    <!-- Enterprise Learning -->
    {enterprisePosts.length > 0 && (
      <section class="w-full py-16 px-6 md:px-12 max-w-7xl mx-auto border-t border-slate-200">
        <div class="flex justify-between items-end mb-8">
          <h2 class="text-2xl md:text-3xl font-bold text-brand-blue">Enterprise Learning</h2>
          <a href="/blog/category/enterprise-learning/" class="text-brand-green font-semibold hover:underline hidden md:block">View all →</a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {enterprisePosts.map(post => (
            <BlogCard
              title={post.title}
              slug={post.slug}
              excerpt={post.excerpt}
              category={post.category}
              readTimeMinutes={post.readingTime}
              publishedAt={post.publishedAt}
              image={post.heroImage}
              imageAlt={post.heroImageAlt}
              tags={post.tags}
            />
          ))}
        </div>
        <a href="/blog/category/enterprise-learning/" class="text-brand-green font-semibold hover:underline block md:hidden mt-6 text-center">View all Enterprise Learning →</a>
      </section>
    )}

    <!-- Kajabi -->
    {kajabiPosts.length > 0 && (
      <section class="w-full py-16 px-6 md:px-12 max-w-7xl mx-auto border-t border-slate-200">
        <div class="flex justify-between items-end mb-8">
          <h2 class="text-2xl md:text-3xl font-bold text-brand-blue">Kajabi & Course Business</h2>
          <a href="/blog/category/kajabi/" class="text-brand-green font-semibold hover:underline hidden md:block">View all →</a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {kajabiPosts.map(post => (
            <BlogCard
              title={post.title}
              slug={post.slug}
              excerpt={post.excerpt}
              category={post.category}
              readTimeMinutes={post.readingTime}
              publishedAt={post.publishedAt}
              image={post.heroImage}
              imageAlt={post.heroImageAlt}
              tags={post.tags}
            />
          ))}
        </div>
        <a href="/blog/category/kajabi/" class="text-brand-green font-semibold hover:underline block md:hidden mt-6 text-center">View all Kajabi →</a>
      </section>
    )}

    <!-- Authors / Editorial Standards -->
    <section class="w-full py-16 px-6 md:px-12 max-w-7xl mx-auto bg-white rounded-xl shadow-sm border border-slate-100 mb-16 text-center">
      <h2 class="text-2xl md:text-3xl font-bold text-brand-blue mb-4">Editorial Standards</h2>
      <p class="text-slate-700 text-lg max-w-3xl mx-auto mb-8">
        We prioritize practical, research-informed, and expert-reviewed content. Our editorial team ensures all guidance is clear, accurate, and actionable.
      </p>
      <a href="/editorial-policy/" class="px-6 py-3 bg-slate-100 text-brand-blue font-semibold rounded-md shadow-sm border border-slate-200 hover:bg-slate-200 transition-colors inline-block">
        Read Our Editorial Policy
      </a>
    </section>

    <!-- Final CTA -->
    <div class="mt-8 mb-20 px-6 md:px-12 max-w-7xl mx-auto w-full">
      <BlogCTA />
    </div>
  </main>
</Layout>

<script define:vars={{ allPostsJson }}>
  const allPosts = JSON.parse(allPostsJson);
  const searchInput = document.getElementById('search-input');
  const categoryFilter = document.getElementById('category-filter');
  const clearBtn = document.getElementById('clear-filters');
  const searchResults = document.getElementById('search-results');
  const searchResultsGrid = document.getElementById('search-results-grid');
  const noResults = document.getElementById('no-results');
  const browseSection = document.getElementById('browse-section');
  const latestArticles = document.getElementById('latest-articles');

  function renderCard(post) {
    return `
      <div class="bg-white rounded-xl shadow-sm border border-slate-100 overflow-hidden hover:shadow-md transition-shadow">
        ${post.heroImage ? `<a href="/blog/${post.slug}/"><img src="${post.heroImage}" alt="${post.heroImageAlt || post.title}" class="w-full h-48 object-cover" /></a>` : '<div class="w-full h-48 bg-slate-100"></div>'}
        <div class="p-6">
          ${post.category ? `<span class="text-xs font-semibold text-brand-green uppercase tracking-wider">${post.category}</span>` : ''}
          <h3 class="text-lg font-bold text-brand-blue mt-2 mb-2"><a href="/blog/${post.slug}/" class="hover:text-brand-green transition-colors">${post.title}</a></h3>
          <p class="text-slate-600 text-sm line-clamp-3">${post.excerpt}</p>
          <div class="mt-4 flex items-center gap-3 text-xs text-slate-400">
            ${post.readingTime ? `<span>${post.readingTime} min read</span>` : ''}
            ${post.publishedAt ? `<span>${new Date(post.publishedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</span>` : ''}
          </div>
          <a href="/blog/${post.slug}/" class="mt-4 inline-block text-brand-green font-semibold text-sm hover:underline">Read Article →</a>
        </div>
      </div>
    `;
  }

  function filterPosts() {
    const query = searchInput.value.toLowerCase().trim();
    const category = categoryFilter.value.toLowerCase();

    if (!query && !category) {
      searchResults.classList.add('hidden');
      if (browseSection) browseSection.classList.remove('hidden');
      if (latestArticles) latestArticles.classList.remove('hidden');
      return;
    }

    const filtered = allPosts.filter(post => {
      const matchesSearch = !query || 
        post.title?.toLowerCase().includes(query) || 
        post.excerpt?.toLowerCase().includes(query);
      const matchesCategory = !category || 
        post.category?.toLowerCase() === category;
      return matchesSearch && matchesCategory;
    });

    searchResults.classList.remove('hidden');
    if (browseSection) browseSection.classList.add('hidden');
    if (latestArticles) latestArticles.classList.add('hidden');

    if (filtered.length === 0) {
      searchResultsGrid.innerHTML = '';
      noResults.classList.remove('hidden');
    } else {
      noResults.classList.add('hidden');
      searchResultsGrid.innerHTML = filtered.map(renderCard).join('');
    }
  }

  searchInput.addEventListener('input', filterPosts);
  categoryFilter.addEventListener('change', filterPosts);
  clearBtn.addEventListener('click', () => {
    searchInput.value = '';
    categoryFilter.value = '';
    filterPosts();
  });
</script>