---
import Layout from "../../layouts/Layout.astro";
import { getBlogPostSummaries } from "../../lib/content/getAllBlogPosts";
import { blogCategories } from "../../data/blogArchitecture";
import BlogCard from "../../components/blog/BlogCard.astro";
import BlogCTA from "../../components/blog/BlogCTA.astro";

// Fetch posts
const allPosts = await getBlogPostSummaries();

// Find featured
const featuredPost = allPosts.find(p => p.featured) || allPosts[0];

// Categorize for hub
const latestPosts = allPosts.filter(p => p.id !== featuredPost?.id).slice(0, 6);
const enterprisePosts = allPosts.filter(p => p.category === "enterprise-learning").slice(0, 3);
const kajabiPosts = allPosts.filter(p => p.category === "kajabi").slice(0, 3);

// Active categories
const activeCategories = blogCategories.filter(cat => cat.publicVisibility && allPosts.some(p => p.category === cat.id));

// All posts for search/filter (serialized for client-side JS)
const allPostsJson = JSON.stringify(allPosts.map(p => ({
  title: p.title,
  slug: p.slug,
  excerpt: p.excerpt,
  category: blogCategories.find(c => c.id === p.category)?.title || p.category,
  categoryId: p.category,
  readingTime: p.readingTime,
  publishedAt: p.publishedAt,
  heroImage: p.heroImage,
  heroImageAlt: p.heroImageAlt,
  tags: p.tags,
})));

// Unique categories from posts
const postCategories = activeCategories;

import { collectionPageSchema, breadcrumbSchema } from "../../lib/seo/schema";

const seoTitle = "TheEduAssist Blog | Practical Guidance for Learning Experiences";
const seoDescription = "Explore research-informed guidance on learning strategy, instructional design, course development, LMS implementation, Kajabi, and enterprise learning.";

const jsonLd = [
  breadcrumbSchema([
    { name: "Home", urlPath: "/" },
    { name: "Blog", urlPath: "/blog/" }
  ]),
  collectionPageSchema(
    seoTitle,
    seoDescription,
    "/blog/"
  )
];
---

<Layout
  title={seoTitle}
  description={seoDescription}
  canonicalPath="/blog/"
  robots="index, follow"
  jsonLd={jsonLd}
>
  <main class="w-full flex-grow flex flex-col bg-slate-50 overflow-hidden">
    <!-- Hero Section -->
    <section class="w-full py-16 md:py-24 px-6 md:px-12 max-w-7xl mx-auto flex flex-col items-center text-center">
      <div class="mb-4 text-sm font-semibold text-brand-green uppercase tracking-wider">
        TheEduAssist Blog
      </div>
      <h1 class="text-3xl md:text-5xl lg:text-6xl font-bold text-brand-blue mb-6 max-w-4xl">
        Practical Guidance for Building and Improving Learning Experiences
      </h1>
      <p class="text-lg md:text-xl text-slate-700 max-w-3xl mb-8">
        Explore research-informed guidance on learning strategy, instructional design, course development, LMS implementation, Kajabi, enterprise learning, responsible AI, accessibility and global delivery.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <button id="view-all-hero-btn" type="button" class="w-full sm:w-auto px-8 py-3 bg-brand-green text-white font-semibold rounded-md shadow-sm hover:bg-emerald-600 active:bg-emerald-700 transition-colors focus:ring-2 focus:ring-offset-2 focus:ring-brand-green focus:outline-none flex items-center justify-center gap-2 cursor-pointer">
          <span>Read All Articles</span>
          <span class="bg-white/20 text-white text-xs px-2.5 py-0.5 rounded-full font-bold">{allPosts.length}</span>
        </button>
        <a href="#latest-articles" class="w-full sm:w-auto px-8 py-3 bg-brand-blue text-white font-semibold rounded-md shadow-sm hover:bg-slate-800 active:bg-slate-900 active:text-white transition-colors focus:ring-2 focus:ring-offset-2 focus:ring-brand-green focus:outline-none text-center">
          Browse Latest Articles
        </a>
        <a href="/services/" class="w-full sm:w-auto px-8 py-3 bg-white text-brand-blue font-semibold rounded-md shadow-sm border border-slate-200 hover:bg-slate-50 active:bg-slate-100 active:text-brand-blue transition-colors focus:ring-2 focus:ring-offset-2 focus:ring-brand-blue focus:outline-none text-center">
          Explore Services
        </a>
      </div>
    </section>

    <!-- Short Answer Section -->
    <section class="w-full py-12 px-6 md:px-12 max-w-4xl mx-auto bg-white rounded-xl shadow-sm border border-slate-100 mb-16">
      <h2 class="text-xl md:text-2xl font-bold text-brand-blue mb-4 text-center">
        What Will You Find in the TheEduAssist Blog?
      </h2>
      <p class="text-slate-700 text-center text-lg leading-relaxed">
        The Blog provides practical guidance for organizations, training teams, course businesses and learning professionals planning, building, modernizing or managing digital learning.
      </p>
    </section>

    <!-- Featured Post -->
    {featuredPost && (
      <section class="w-full py-12 px-6 md:px-12 max-w-7xl mx-auto mb-16">
        <div class="flex flex-col md:flex-row gap-8 bg-white rounded-xl shadow-sm border border-slate-100 overflow-hidden group">
          <div class="md:w-1/2 h-64 md:h-auto relative overflow-hidden bg-slate-100">
            <a href={`/blog/${featuredPost.slug}/`} class="block w-full h-full" tabindex="-1">
              {featuredPost.heroImage ? (
                <img
                  src={featuredPost.heroImage}
                  alt={featuredPost.heroImageAlt || featuredPost.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  width="800"
                  height="600"
                  loading="eager"
                />
              ) : (
                <div class="absolute inset-0 bg-gradient-to-br from-brand-blue/5 to-brand-green/10 flex items-center justify-center p-8 text-center text-brand-blue/40 group-hover:scale-105 transition-transform duration-500">
                  <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
                    <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
                  </svg>
                </div>
              )}
            </a>
          </div>
          <div class="md:w-1/2 p-8 flex flex-col justify-center">
            <div class="flex items-center gap-3 mb-4">
              <span class="px-3 py-1 bg-slate-100 text-brand-blue text-xs font-semibold rounded-full uppercase tracking-wider">
                Featured Article
              </span>
            </div>
            <h2 class="text-2xl md:text-4xl font-bold text-brand-blue mb-4">
              <a href={`/blog/${featuredPost.slug}/`} class="hover:text-brand-green transition-colors">
                {featuredPost.title}
              </a>
            </h2>
            <p class="text-slate-600 text-lg mb-6 line-clamp-3">
              {featuredPost.excerpt}
            </p>
            <div class="flex items-center gap-4 text-sm text-slate-500">
              {featuredPost.author && (
                <div class="flex items-center gap-2">
                  <span class="font-medium">{featuredPost.author}</span>
                </div>
              )}
              {featuredPost.publishedAt && (
                <time datetime={featuredPost.publishedAt}>
                  {new Date(featuredPost.publishedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                </time>
              )}
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- Search and Filter -->
    <section class="w-full py-8 px-6 md:px-12 max-w-7xl mx-auto mb-8">
      <div class="flex flex-col md:flex-row gap-4 items-center">
        <input
          id="search-input"
          type="text"
          placeholder="Search articles..."
          class="w-full md:w-5/12 px-4 py-3 rounded-lg border border-slate-200 bg-white shadow-sm focus:outline-none focus:ring-2 focus:ring-brand-green text-slate-700"
        />
        <select
          id="category-filter"
          class="w-full md:w-3/12 px-4 py-3 rounded-lg border border-slate-200 bg-white shadow-sm focus:outline-none focus:ring-2 focus:ring-brand-green text-slate-700"
        >
          <option value="">All Categories</option>
          {postCategories.map(cat => (
            <option value={cat.id}>{cat.title}</option>
          ))}
        </select>
        <button
          id="view-all-filter-btn"
          type="button"
          class="w-full md:w-auto px-6 py-3 bg-brand-green text-white font-medium rounded-lg shadow-sm hover:bg-emerald-600 transition-colors whitespace-nowrap flex items-center justify-center gap-2 cursor-pointer"
        >
          <span>All Articles</span>
          <span class="bg-white/20 text-white text-xs px-2 py-0.5 rounded-full font-bold">{allPosts.length}</span>
        </button>
        <button
          id="clear-filters"
          type="button"
          class="w-full md:w-auto px-6 py-3 bg-slate-100 text-brand-blue font-medium rounded-lg border border-slate-200 hover:bg-slate-200 transition-colors"
        >
          Clear
        </button>
      </div>
    </section>

    <!-- Search / All Results -->
    <section id="search-results" class="w-full px-6 md:px-12 max-w-7xl mx-auto mb-16 hidden scroll-mt-24">
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8 pb-4 border-b border-slate-200">
        <div>
          <h2 id="results-heading" class="text-2xl md:text-3xl font-bold text-brand-blue">All Articles</h2>
          <p id="results-count" class="text-sm text-slate-500 mt-1"></p>
        </div>
        <div class="flex items-center gap-4">
          <a href="/blog/page/1/" class="text-sm font-semibold text-brand-green hover:underline flex items-center gap-1">
            <span>Browse Paginated Archives →</span>
          </a>
        </div>
      </div>
      <div id="search-results-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8"></div>
      
      <!-- Load More / Show All Controls -->
      <div id="load-more-container" class="mt-12 text-center hidden flex flex-col sm:flex-row justify-center items-center gap-4">
        <button
          id="load-more-btn"
          type="button"
          class="w-full sm:w-auto px-8 py-3.5 bg-brand-blue text-white font-semibold rounded-xl shadow-md hover:bg-slate-800 transition-all duration-300 cursor-pointer"
        >
          Load More Articles
        </button>
        <button
          id="show-all-remaining-btn"
          type="button"
          class="w-full sm:w-auto px-6 py-3.5 bg-white text-brand-blue font-medium rounded-xl border border-slate-200 shadow-sm hover:bg-slate-50 transition-all duration-300 cursor-pointer"
        >
          Show All at Once
        </button>
      </div>

      <p id="no-results" class="text-slate-500 text-center py-12 hidden">No articles found. Try a different search term.</p>
    </section>

    <!-- Browse by Topic -->
    {activeCategories.length > 0 && (
      <section id="browse-section" class="w-full py-12 px-6 md:px-12 max-w-7xl mx-auto mb-16">
        <h2 class="text-2xl md:text-3xl font-bold text-brand-blue mb-8 text-center">Browse by Topic</h2>
        <div class="flex flex-wrap gap-4 justify-center">
          {activeCategories.map(cat => (
            <a href={cat.href} class="px-6 py-3 bg-white text-brand-blue font-medium rounded-full shadow-sm border border-slate-200 hover:bg-brand-green hover:text-white hover:border-brand-green transition-colors">
              {cat.title}
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Latest Articles -->
    {latestPosts.length > 0 && (
      <section id="latest-articles" class="w-full py-16 px-6 md:px-12 max-w-7xl mx-auto bg-slate-50 scroll-mt-20">
        <div class="flex justify-between items-end mb-8">
          <h2 class="text-2xl md:text-3xl font-bold text-brand-blue">Latest Articles</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {latestPosts.map(post => (
            <BlogCard
              title={post.title}
              slug={post.slug}
              excerpt={post.excerpt}
              category={blogCategories.find(c => c.id === post.category)?.title || post.category}
              readTimeMinutes={post.readingTime}
              publishedAt={post.publishedAt}
              image={post.heroImage}
              imageAlt={post.heroImageAlt}
              tags={post.tags}
            />
          ))}
        </div>
        <div class="mt-12 text-center">
          <button id="view-all-latest-btn" type="button" class="inline-flex items-center gap-2 px-8 py-4 bg-brand-blue text-white font-semibold text-base md:text-lg rounded-xl shadow-md hover:bg-emerald-600 hover:shadow-lg transition-all duration-300 cursor-pointer">
            <span>Explore All {allPosts.length} Articles</span>
            <span class="bg-white/20 text-white text-xs px-2.5 py-1 rounded-full font-bold">{allPosts.length}</span>
            <svg class="w-5 h-5 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </button>
        </div>
      </section>
    )}

    <!-- Enterprise Learning -->
    {enterprisePosts.length > 0 && (
      <section class="w-full py-16 px-6 md:px-12 max-w-7xl mx-auto border-t border-slate-200">
        <div class="flex justify-between items-end mb-8">
          <h2 class="text-2xl md:text-3xl font-bold text-brand-blue">Enterprise Learning</h2>
          <a href="/blog/category/enterprise-learning/" class="text-brand-green font-semibold hover:underline hidden md:block">View all →</a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {enterprisePosts.map(post => (
            <BlogCard
              title={post.title}
              slug={post.slug}
              excerpt={post.excerpt}
              category={blogCategories.find(c => c.id === post.category)?.title || post.category}
              readTimeMinutes={post.readingTime}
              publishedAt={post.publishedAt}
              image={post.heroImage}
              imageAlt={post.heroImageAlt}
              tags={post.tags}
            />
          ))}
        </div>
        <a href="/blog/category/enterprise-learning/" class="text-brand-green font-semibold hover:underline block md:hidden mt-6 text-center">View all Enterprise Learning →</a>
      </section>
    )}

    <!-- Kajabi -->
    {kajabiPosts.length > 0 && (
      <section class="w-full py-16 px-6 md:px-12 max-w-7xl mx-auto border-t border-slate-200">
        <div class="flex justify-between items-end mb-8">
          <h2 class="text-2xl md:text-3xl font-bold text-brand-blue">Kajabi & Course Business</h2>
          <a href="/blog/category/kajabi/" class="text-brand-green font-semibold hover:underline hidden md:block">View all →</a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {kajabiPosts.map(post => (
            <BlogCard
              title={post.title}
              slug={post.slug}
              excerpt={post.excerpt}
              category={blogCategories.find(c => c.id === post.category)?.title || post.category}
              readTimeMinutes={post.readingTime}
              publishedAt={post.publishedAt}
              image={post.heroImage}
              imageAlt={post.heroImageAlt}
              tags={post.tags}
            />
          ))}
        </div>
        <a href="/blog/category/kajabi/" class="text-brand-green font-semibold hover:underline block md:hidden mt-6 text-center">View all Kajabi →</a>
      </section>
    )}

    <!-- Authors / Editorial Standards -->
    <section class="w-full py-16 px-6 md:px-12 max-w-7xl mx-auto bg-white rounded-xl shadow-sm border border-slate-100 mb-16 text-center">
      <h2 class="text-2xl md:text-3xl font-bold text-brand-blue mb-4">Editorial Standards</h2>
      <p class="text-slate-700 text-lg max-w-3xl mx-auto mb-8">
        We prioritize practical, research-informed, and expert-reviewed content. Our editorial team ensures all guidance is clear, accurate, and actionable.
      </p>
      <a href="/editorial-policy/" class="px-6 py-3 bg-slate-100 text-brand-blue font-semibold rounded-md shadow-sm border border-slate-200 hover:bg-slate-200 transition-colors inline-block">
        Read Our Editorial Policy
      </a>
    </section>

    <!-- Final CTA -->
    <div class="mt-8 mb-20 px-6 md:px-12 max-w-7xl mx-auto w-full">
      <BlogCTA />
    </div>
  </main>
</Layout>

<script define:vars={{ allPostsJson }}>
  const allPosts = JSON.parse(allPostsJson);
  const searchInput = document.getElementById('search-input');
  const categoryFilter = document.getElementById('category-filter');
  const clearBtn = document.getElementById('clear-filters');
  const searchResults = document.getElementById('search-results');
  const searchResultsGrid = document.getElementById('search-results-grid');
  const resultsHeading = document.getElementById('results-heading');
  const resultsCount = document.getElementById('results-count');
  const noResults = document.getElementById('no-results');
  const browseSection = document.getElementById('browse-section');
  const latestArticles = document.getElementById('latest-articles');
  const loadMoreContainer = document.getElementById('load-more-container');
  const loadMoreBtn = document.getElementById('load-more-btn');
  const showAllRemainingBtn = document.getElementById('show-all-remaining-btn');

  const viewAllHeroBtn = document.getElementById('view-all-hero-btn');
  const viewAllFilterBtn = document.getElementById('view-all-filter-btn');
  const viewAllLatestBtn = document.getElementById('view-all-latest-btn');

  const PAGE_SIZE = 18;
  let currentlyRendered = 0;
  let currentActiveList = [];

  function renderCard(post) {
    return `
      <article class="blog-card bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden flex flex-col h-full group relative transition-all duration-300 hover:shadow-xl hover:-translate-y-1">
        <a href="/blog/${post.slug}/" class="absolute inset-0 z-0" aria-label="Read ${post.title}"></a>

        <div class="relative w-full aspect-[16/9] overflow-hidden bg-slate-100 pointer-events-none">
          ${post.heroImage ?
            `<img loading="lazy" src="${post.heroImage}" alt="${post.heroImageAlt || post.title}" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />`
            :
            `<div class="absolute inset-0 bg-gradient-to-br from-brand-blue/5 to-brand-green/10 flex items-center justify-center p-6 text-center text-brand-blue/40 group-hover:from-brand-blue/10 group-hover:to-brand-green/20 transition-colors duration-500">
              <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="opacity-50">
                <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
                <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
              </svg>
            </div>`
          }
        </div>

        <div class="p-6 flex flex-col flex-grow relative z-20 bg-white pointer-events-none">
          <div class="flex items-center justify-between mb-3 pointer-events-auto">
            <a href="/blog/category/${(post.category || 'Article').toLowerCase().replace(/[^a-z0-9]+/g, '-')}/" class="relative z-30 text-xs font-semibold uppercase tracking-wider text-[var(--color-primary)] hover:text-brand-green hover:underline transition-colors truncate max-w-[100%] pointer-events-auto">${post.category || 'Article'}</a>
          </div>
          <h3 class="text-xl font-bold text-slate-800 mb-3 group-hover:text-[var(--color-primary)] transition-colors line-clamp-2 pointer-events-none">
            ${post.title}
          </h3>
          <p class="text-slate-600 text-sm mb-4 line-clamp-3 pointer-events-none">${post.excerpt}</p>
          <div class="mt-auto flex items-center justify-between text-xs text-slate-500 pt-4 border-t border-slate-100 pointer-events-none">
            <div class="flex items-center gap-2">
              ${post.publishedAt ? `<time datetime="${post.publishedAt}">${new Date(post.publishedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</time>` : ''}
              ${post.publishedAt && post.readingTime ? `<span class="text-slate-300">•</span>` : ''}
              ${post.readingTime ? `<span class="inline-flex items-center text-sm text-slate-500 whitespace-nowrap"><svg class="w-4 h-4 mr-1.5 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>${post.readingTime} min read</span>` : ''}
            </div>
            <span class="font-medium text-[var(--color-primary)] flex items-center group-hover:text-[var(--color-accent)] transition-colors">
              Read Article
              <svg class="w-3 h-3 ml-1 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
            </span>
          </div>
        </div>
      </article>
    `;
  }

  function showArticlesBatch(posts, reset = true) {
    if (reset) {
      currentActiveList = posts;
      currentlyRendered = 0;
      searchResultsGrid.innerHTML = '';
    }
    
    const nextBatch = currentActiveList.slice(currentlyRendered, currentlyRendered + PAGE_SIZE);
    searchResultsGrid.insertAdjacentHTML('beforeend', nextBatch.map(renderCard).join(''));
    currentlyRendered += nextBatch.length;
    
    if (resultsCount) {
      resultsCount.textContent = `Showing ${currentlyRendered} of ${currentActiveList.length} articles`;
    }
    
    if (currentlyRendered < currentActiveList.length) {
      loadMoreContainer.classList.remove('hidden');
      loadMoreBtn.textContent = `Load More Articles (${currentActiveList.length - currentlyRendered} remaining)`;
    } else {
      loadMoreContainer.classList.add('hidden');
    }
  }

  function displayAllArticles() {
    searchInput.value = '';
    categoryFilter.value = '';
    if (resultsHeading) resultsHeading.textContent = `All Articles (${allPosts.length})`;
    searchResults.classList.remove('hidden');
    noResults.classList.add('hidden');
    if (browseSection) browseSection.classList.add('hidden');
    if (latestArticles) latestArticles.classList.add('hidden');
    showArticlesBatch(allPosts, true);
    searchResults.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function filterPosts() {
    const query = searchInput.value.toLowerCase().trim();
    const category = categoryFilter.value.toLowerCase();

    if (!query && !category) {
      searchResults.classList.add('hidden');
      loadMoreContainer.classList.add('hidden');
      if (browseSection) browseSection.classList.remove('hidden');
      if (latestArticles) latestArticles.classList.remove('hidden');
      return;
    }

    const filtered = allPosts.filter(post => {
      const matchesSearch = !query || 
        post.title?.toLowerCase().includes(query) || 
        post.excerpt?.toLowerCase().includes(query);
      const matchesCategory = !category || 
        post.categoryId === category;
      return matchesSearch && matchesCategory;
    });

    searchResults.classList.remove('hidden');
    if (browseSection) browseSection.classList.add('hidden');
    if (latestArticles) latestArticles.classList.add('hidden');

    if (resultsHeading) {
      if (query && category) {
        resultsHeading.textContent = `Search results for "${query}" in ${category}`;
      } else if (query) {
        resultsHeading.textContent = `Search results for "${query}"`;
      } else {
        const catObj = postCategories.find(c => c.id === category);
        resultsHeading.textContent = catObj ? catObj.title : `Articles`;
      }
    }

    if (filtered.length === 0) {
      searchResultsGrid.innerHTML = '';
      loadMoreContainer.classList.add('hidden');
      if (resultsCount) resultsCount.textContent = '';
      noResults.classList.remove('hidden');
    } else {
      noResults.classList.add('hidden');
      showArticlesBatch(filtered, true);
    }
  }

  if (loadMoreBtn) {
    loadMoreBtn.addEventListener('click', () => {
      showArticlesBatch(currentActiveList, false);
    });
  }

  if (showAllRemainingBtn) {
    showAllRemainingBtn.addEventListener('click', () => {
      const remaining = currentActiveList.slice(currentlyRendered);
      searchResultsGrid.insertAdjacentHTML('beforeend', remaining.map(renderCard).join(''));
      currentlyRendered = currentActiveList.length;
      if (resultsCount) {
        resultsCount.textContent = `Showing all ${currentActiveList.length} articles`;
      }
      loadMoreContainer.classList.add('hidden');
    });
  }

  if (viewAllHeroBtn) viewAllHeroBtn.addEventListener('click', displayAllArticles);
  if (viewAllFilterBtn) viewAllFilterBtn.addEventListener('click', displayAllArticles);
  if (viewAllLatestBtn) viewAllLatestBtn.addEventListener('click', displayAllArticles);

  searchInput.addEventListener('input', filterPosts);
  categoryFilter.addEventListener('change', filterPosts);
  clearBtn.addEventListener('click', () => {
    searchInput.value = '';
    categoryFilter.value = '';
    filterPosts();
  });
</script>
