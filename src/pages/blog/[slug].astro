---
export const prerender = true;
import { getCollection, getEntry, render } from 'astro:content';
import BlogArticleLayout from '../../layouts/BlogArticleLayout.astro';
import BlogTableOfContents from '../../components/blog/BlogTableOfContents.astro';
import RelatedArticles from '../../components/blog/RelatedArticles.astro';
import BlogCTA from '../../components/blog/BlogCTA.astro';
import ArticleShareButtons from '../../components/blog/ArticleShareButtons.astro';
import BlogFAQs from '../../components/blog/BlogFAQs.astro';
import { getFullBlogPostsForAuditOnly, isPublicBlogSummary } from '../../lib/content/getAllBlogPosts';

export async function getStaticPaths() {
  const posts = await getFullBlogPostsForAuditOnly();
  // Filter for valid public posts locally to make sure we don't index drafts or tests
  const publicPosts = posts.filter(isPublicBlogSummary);

  const paths: any[] = [];
  
  publicPosts.forEach(post => {
    if (post.slug) {
      const slugValue = typeof post.slug === 'object' && post.slug !== null && 'current' in post.slug ? post.slug.current : post.slug;
      paths.push({ params: { slug: slugValue }, props: { slug: slugValue } });
    }
  });
  
  return paths;
}

const { slug } = Astro.params;

const allPosts = await getFullBlogPostsForAuditOnly();
const publicPosts = allPosts.filter(isPublicBlogSummary).sort((a, b) => {
  const dateA = new Date(a.publishedAt || '').getTime();
  const dateB = new Date(b.publishedAt || '').getTime();
  return dateB - dateA; // Descending (newest first)
});

const post = publicPosts.find(p => p.slug === slug || p.id === slug);

if (!post) {
  return new Response("Not found", { status: 404 });
}

const collectionPost = await getEntry('blog', post.id!);
if (!collectionPost) {
  return new Response("Content not found", { status: 404 });
}

const { Content, headings } = await render(collectionPost);

const currentIndex = publicPosts.findIndex(p => p.slug === post.slug);
const prevPost = publicPosts[currentIndex + 1];
const nextPost = publicPosts[currentIndex - 1];

const hasDirectAnswer = !!post.shortAnswer;
const showToc = headings.length >= 2;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Blog",
      "item": "https://www.theeduassist.com/blog/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": (post.category || 'General').replace(/-/g, ' ').replace(/\b\w/g, (l: string) => l.toUpperCase()),
      "item": `https://www.theeduassist.com/blog/category/${(post.category || 'general').toLowerCase().replace(/[^a-z0-9]+/g, '-')}/`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": post.title,
      "item": `https://www.theeduassist.com/blog/${post.slug}/`
    }
  ]
};

const schemaData: Record<string, any> = {
  "@context": "https://schema.org",
  "@type": post.contentType === 'press-release' ? "NewsArticle" : "Article",
  "headline": post.title,
  "description": post.excerpt,
  "datePublished": post.datePublished,
  "dateModified": post.dateModified || post.datePublished,
  "author": {
    "@type": post.author?.schemaType || "Organization",
    "name": "TheEduAssist Editorial Team",
    "url": "https://www.theeduassist.com/authors/editorial-team/"
  },
  "publisher": {
    "@type": "Organization",
    "name": "TheEduAssist",
    "logo": {
      "@type": "ImageObject",
      "url": "https://www.theeduassist.com/brand/theeduassist-logo-official.svg"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://www.theeduassist.com${post.canonical}`
  }
};

if (post.featuredImage) {
    schemaData.image = [post.featuredImage];
}
---

<BlogArticleLayout
  title={`${post.title} | TheEduAssist`}
  description={post.excerpt}
  canonicalPath={post.canonical}
  image={post.featuredImage}
  type="article"
  publishDate={post.datePublished}
  modifiedDate={post.dateModified}
  authorName={post.author?.name}
  robots={post.robots}
  jsonLd={[schemaData, breadcrumbSchema]}
>
  <main class="w-full flex-grow flex flex-col bg-slate-50 relative pb-20">
    <article class="w-full">
      <!-- Article Header -->
      <header class="w-full bg-white pt-16 pb-12 px-6 md:px-12 border-b border-slate-200">
        <div class="max-w-4xl mx-auto">
          <!-- Breadcrumbs -->
          <nav class="flex items-center text-sm font-medium text-slate-500 mb-6 space-x-2" aria-label="Breadcrumb">
            <a href="/blog/" class="hover:text-brand-green transition-colors">Blog</a>
            <span>›</span>
            <a href={`/blog/category/${(post.category || 'general').toLowerCase().replace(/[^a-z0-9]+/g, '-')}/`} class="text-brand-blue font-semibold hover:text-brand-green transition-colors capitalize">
              {(post.category || 'General').replace(/-/g, ' ')}
            </a>
          </nav>

          <div class="mb-4 text-sm font-bold text-brand-green uppercase tracking-wider">
            {(post.category || 'General').replace(/-/g, ' ')}
          </div>

          <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-brand-blue leading-[1.15] tracking-tight mb-6">
            {post.title}
          </h1>

          {post.excerpt && (
            <p class="text-xl md:text-2xl text-slate-600 mb-8 leading-relaxed font-normal max-w-3xl">
              {post.excerpt}
            </p>
          )}

          <!-- Author and Meta -->
          <div class="flex flex-wrap items-center gap-6 py-6 border-t border-slate-100">
            {post.author && (
              <div class="flex items-center gap-3">
                <div class="flex flex-col">
                  <a href="/authors/editorial-team/" class="text-sm font-semibold text-brand-blue hover:text-brand-green hover:underline transition-colors">TheEduAssist Editorial Team</a>
                </div>
              </div>
            )}

            <div class="flex flex-col">
              <span class="text-xs text-slate-500 uppercase tracking-wider font-semibold">Published</span>
              <time class="text-sm font-medium text-slate-700" datetime={post.datePublished || post.publishedAt}>
                {new Date(post.datePublished || post.publishedAt || '').toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
              </time>
            </div>

            {post.dateModified && post.dateModified !== post.datePublished && (
              <div class="flex flex-col">
                <span class="text-xs text-slate-500 uppercase tracking-wider font-semibold">Updated</span>
                <time class="text-sm font-medium text-slate-700" datetime={post.dateModified}>
                  {new Date(post.dateModified).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                </time>
              </div>
            )}

            <div class="flex flex-col">
              <span class="text-xs text-slate-500 uppercase tracking-wider font-semibold">Reading Time</span>
              <span class="text-sm font-medium text-slate-700">{post.readingTime} min read</span>
            </div>
          </div>
        </div>
      </header>

      <!-- Featured Image -->
      {(post.featuredImage || post.heroImage) && (
        <div class="w-full max-w-5xl mx-auto px-6 md:px-12 -mt-8 relative z-10">
          <img
            src={post.featuredImage || post.heroImage}
            alt={post.featuredImageAlt || post.heroImageAlt || post.title}
            class="w-full h-auto aspect-video object-cover rounded-xl shadow-md border border-slate-200 bg-slate-100"
            width="1024"
            height="576"
          />
        </div>
      )}

      <!-- Layout -->
      <div class="w-full max-w-[1200px] mx-auto px-6 md:px-12 py-12 flex flex-col lg:flex-row relative gap-12">

        <!-- Sidebar TOC -->
        <aside class="hidden lg:block w-64 shrink-0">
          <div class="sticky top-24">
            {showToc && <BlogTableOfContents headings={headings} />}
          </div>
        </aside>

        <!-- Main Content -->
        <div class="w-full max-w-[780px] flex-grow">

          {/* Mobile TOC */}
          <div class="lg:hidden mb-8">
            {showToc && <BlogTableOfContents headings={headings} />}
          </div>

          {post.aiSummary && (
             <div class="mb-10">
               <div class="bg-brand-blue/5 border border-brand-blue/10 rounded-xl p-6 md:p-8">
                 <h2 class="text-xl font-bold text-brand-blue mb-4">Quick Answer</h2>
                 <p class="text-[18px] text-slate-700 leading-[1.8]">{post.aiSummary}</p>
               </div>
             </div>
          )}

          {hasDirectAnswer && !post.aiSummary && (
            <div class="bg-brand-blue/5 border border-brand-blue/10 rounded-xl p-6 md:p-8 mb-10">
              <h2 class="text-xl font-bold text-brand-blue mb-4">The Short Answer</h2>
              <div class="prose prose-slate prose-brand max-w-none">
                <p>{post.shortAnswer}</p>
              </div>
            </div>
          )}

          <div class="prose prose-slate prose-brand max-w-none prose-headings:scroll-mt-28 prose-a:text-brand-green hover:prose-a:text-brand-blue prose-img:rounded-xl text-[18px] md:text-[19px] leading-[1.8] text-slate-800 prose-h2:text-3xl md:prose-h2:text-4xl prose-h2:font-bold prose-h2:tracking-tight prose-h2:mt-16 prose-h2:mb-6 prose-h3:text-2xl md:prose-h3:text-[28px] prose-h3:font-bold prose-h3:mt-10 prose-h3:mb-4 prose-p:mb-6 prose-ul:my-6 prose-li:my-2 prose-blockquote:border-brand-green prose-blockquote:bg-slate-50 prose-blockquote:py-2 prose-blockquote:px-6 prose-blockquote:rounded-r-xl prose-blockquote:font-medium prose-blockquote:text-brand-blue prose-blockquote:not-italic prose-table:overflow-x-auto prose-table:block md:prose-table:table">
            <Content />
          </div>

          <!-- Sources -->
          {post.sources && post.sources.length > 0 && (
            <div class="mt-16 pt-8 border-t border-slate-200">
              <h2 class="text-[32px] font-bold text-slate-800 mb-6 mt-12">Sources & References</h2>
              <ol class="list-decimal list-outside ml-5 space-y-4 text-base text-slate-600">
                {post.sources.map((source: any) => (
                  <li class="pl-2">
                    {source.url ? (
                      <a href={source.url} target="_blank" rel="noopener noreferrer" class="text-brand-green hover:text-brand-blue hover:underline transition-colors">
                        {source.label || source.title || source.url}
                      </a>
                    ) : (
                      <span>{source.label || source.title}</span>
                    )}
                  </li>
                ))}
              </ol>
            </div>
          )}

          <!-- Share Buttons -->
          <div class="mt-12">
            <ArticleShareButtons url={`https://www.theeduassist.com/blog/${post.slug}/`} title={post.title} />
          </div>

          <!-- Reading Progress Bar -->
          <div id="progress-bar" class="fixed top-0 left-0 h-1 bg-brand-green z-50 transition-all duration-150" style="width: 0%"></div>

        </div>

      </div>
    </article>

    <!-- Author block at bottom -->
    {post.author && (
      <section class="w-full py-12 px-6 md:px-12 bg-white border-y border-slate-200">
        <div class="max-w-4xl mx-auto flex flex-col md:flex-row items-center md:items-start gap-6">
          <div class="text-center md:text-left">
            <h3 class="text-xl font-bold text-brand-blue mb-2">Written by TheEduAssist Editorial Team</h3>
            <p class="text-slate-600 mb-4">Practical guidance for building and improving learning experiences.</p>
            <a href="/authors/editorial-team/" class="text-brand-green font-medium hover:underline">View full profile</a>
          </div>
        </div>
      </section>
    )}

    <!-- Previous / Next Navigation -->
    {(prevPost || nextPost) && (
      <div class="w-full px-6 md:px-12 max-w-4xl mx-auto py-12 border-t border-slate-200">
        <div class="flex flex-col md:flex-row justify-between gap-6">
          {prevPost && (
            <a href={`/blog/${prevPost.slug}/`} class="flex-1 p-6 bg-white rounded-xl border border-slate-200 hover:border-brand-green hover:shadow-md transition-all group">
              <span class="text-xs text-slate-400 uppercase tracking-wider font-semibold">← Previous</span>
              <p class="mt-2 font-bold text-brand-blue group-hover:text-brand-green transition-colors line-clamp-2">{prevPost.title}</p>
            </a>
          )}
          {nextPost && (
            <a href={`/blog/${nextPost.slug}/`} class="flex-1 p-6 bg-white rounded-xl border border-slate-200 hover:border-brand-green hover:shadow-md transition-all group text-right">
              <span class="text-xs text-slate-400 uppercase tracking-wider font-semibold">Next →</span>
              <p class="mt-2 font-bold text-brand-blue group-hover:text-brand-green transition-colors line-clamp-2">{nextPost.title}</p>
            </a>
          )}
        </div>
      </div>
    )}

    <!-- Related Articles -->
    {post.relatedArticleSlugs && post.relatedArticleSlugs.length > 0 && (
      <RelatedArticles currentSlug={post.slug} relatedSlugs={post.relatedArticleSlugs} />
    )}

    <!-- Final CTA -->
    <div class="py-16 px-6 md:px-12 max-w-7xl mx-auto w-full">
      <BlogCTA />
    </div>

  </main>

  <!-- Back to Top Button -->
  <button 
    id="back-to-top" 
    class="fixed bottom-8 right-8 bg-brand-green text-white w-12 h-12 rounded-full shadow-lg flex items-center justify-center opacity-0 transition-opacity duration-300 hover:opacity-90 z-50"
    aria-label="Back to top"
  >
    ↑
  </button>

  <script>
    // Reading Progress Bar
    const progressBar = document.getElementById('progress-bar');
    window.addEventListener('scroll', () => {
      const scrollTop = window.scrollY;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const progress = (scrollTop / docHeight) * 100;
      if (progressBar) progressBar.style.width = `${progress}%`;
    });

    // Back to Top Button
    const backToTop = document.getElementById('back-to-top');
    window.addEventListener('scroll', () => {
      if (window.scrollY > 300) {
        backToTop?.classList.remove('opacity-0');
        backToTop?.classList.add('opacity-100');
      } else {
        backToTop?.classList.remove('opacity-100');
        backToTop?.classList.add('opacity-0');
      }
    });
    backToTop?.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  </script>

</BlogArticleLayout>