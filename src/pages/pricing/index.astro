---
export const prerender = true;
import Layout from "../../layouts/Layout.astro";
import AIAnswerBlock from "../../components/ai/AIAnswerBlock.astro";
import ElearningCostEstimator from "../../components/pricing/ElearningCostEstimator.astro";

const title = "Investment & Scoping Architecture | TheEduAssist";
const description = "Transparent, fixed-milestone scoping for custom eLearning, Kajabi platforms, and enterprise LMS architectures. Guaranteed SOW delivery with zero hidden scope fees.";
const canonicalPath = "https://www.theeduassist.com/pricing/";

const engagementModels = [
  {
    title: "Course Clarity & Architecture Sprint",
    category: "creator",
    model: "Project-Based SOW",
    bestFor: "Creators, Subject-Matter Experts, and organizations planning a high-impact course before committing to full production.",
    desc: "A strategy-first engagement to translate raw expertise, documents, or workshop slides into an actionable curriculum architecture based on Bloom's Taxonomy.",
    features: [
      "Audience persona & learning outcome mapping",
      "Module & lesson scaffolding (Action Mapping)",
      "Cognitive load chunking & milestone structuring",
      "LMS platform selection & tech architecture recommendation",
      "Launch readiness audit & production blueprint",
      "24–48 hour rapid scope turnaround"
    ],
    timeline: "1–2 Weeks",
    badge: "Strategy Sprint",
    ctaText: "Request Architecture Scope",
    ctaLink: "/book-free-audit/"
  },
  {
    title: "Flagship Academy & Turnkey Multi-LMS Build",
    category: "creator",
    model: "Turnkey Milestone SOW",
    bestFor: "Academies, founders, high-growth institutions, and training providers deploying a bespoke, turnkey learning ecosystem across Kajabi, LearnWorlds, Thinkific, Skool, or Canvas LMS.",
    desc: "Complete end-to-end design and build: from Bloom's Taxonomy curriculum scripting and motion slide decks to fillable student workbooks, custom multi-platform LMS engineering, automated student funnels, and checkout architecture.",
    features: [
      "Full instructional curriculum design & lesson scripting",
      "High-retention visual slide decks & branded motion assets",
      "Interactive fillable PDF student workbooks & action guides",
      "Turnkey platform deployment (Kajabi, LearnWorlds, Thinkific, Skool, Canvas)",
      "Custom theme styling, checkout gates & student community setup",
      "Automated student onboarding & milestone email nurture sequences",
      "Multi-device responsive QA & cross-browser validation",
      "60-day post-launch warranty with dedicated technical support"
    ],
    timeline: "4–8 Weeks",
    badge: "Most Popular Flagship",
    ctaText: "Discuss Turnkey LMS Build",
    ctaLink: "/book-free-audit/"
  },
  {
    title: "Audit-Ready Corporate Compliance Architecture",
    category: "compliance",
    model: "Turnkey SCORM License / Managed Academy",
    bestFor: "Employers and multi-state organizations needing mandatory annual anti-harassment, OSHA safety, and cybersecurity compliance to avoid statutory fines up to $50,000+.",
    desc: "Certified, anti-skipping SCORM 1.2, SCORM 2004, and cmi5 courseware built to strict California SB 1343/553, NYS 201-g, OSHA, and UK Worker Protection standards, complete with automated seat-time tracking and audit-ready verification logs.",
    features: [
      "Turnkey SCORM 1.2, 2004 & cmi5 packages compatible with any LMS",
      "Anti-scrubbing timeline locks enforcing statutory seat times (60m/120m)",
      "Scenario-based decision branches satisfying legal interactivity mandates",
      "Randomized 80% passing quiz gates with automated remediation loops",
      "Timestamped digital completion certificates with unique verification IDs",
      "Annual Regulatory Protection Retainer options for automatic legislative updates",
      "Turnkey Managed Compliance Academy option for companies without an internal LMS"
    ],
    timeline: "3–5 Business Days",
    badge: "Statutory Compliance",
    ctaText: "Explore Compliance Scoping",
    ctaLink: "/contact-us/"
  },
  {
    title: "Enterprise & Public Sector Workforce SOW",
    category: "enterprise",
    model: "Custom SOW / Formal RFP Tender",
    bestFor: "Government agencies, corporate L&D leaders, and public sector departments needing accessible, auditable workforce training.",
    desc: "Custom-engineered digital learning modules built to strict statutory compliance, universal accessibility mandates, and multi-agency LMS standards.",
    features: [
      "Section 508 & WCAG 2.1 Level AA VPAT 2.4 compliance",
      "SCORM 1.2, SCORM 2004 4th Edition, and xAPI packaging",
      "Scenario-based branching simulations & ethical decision trees",
      "Canvas, Blackboard, Moodle, Docebo & Cornerstone LMS integration",
      "Bilateral NDA execution & zero AI model training on client IP",
      "Dedicated Enterprise Account Director & weekly agile sprints",
      "Auditable completion logging & compliance reporting"
    ],
    timeline: "Custom Milestone SOW",
    badge: "Government & Enterprise",
    ctaText: "Submit RFP / Procurement Desk",
    ctaLink: "/trust-centre/procurement/"
  },
  {
    title: "Managed Learning & Advisory Retainer",
    category: "retainer",
    model: "Dedicated Monthly Retainer",
    bestFor: "Organizations and high-growth academies requiring continuous curriculum updates, LMS administration, and ongoing quality assurance.",
    desc: "A dedicated operational extension of your team to maintain, optimize, and expand your digital learning ecosystem after initial launch.",
    features: [
      "Ongoing module updates & content conversions",
      "LMS technical administration & user flow optimization",
      "Continuous student experience & UX improvements",
      "Monthly accessibility & browser compatibility audits",
      "Rapid-turnaround bug remediation & technical support",
      "Quarterly curriculum review & executive reporting"
    ],
    timeline: "Monthly / Annual Retainer",
    badge: "Operational Partnership",
    ctaText: "Discuss Managed Support",
    ctaLink: "/contact-us/"
  }
];

const costDrivers = [
  {
    factor: "01. Level of Interactivity",
    desc: "Ranging from Level 1 (Passive text/video) to Level 2 (Knowledge checks & multimedia), Level 3 (Scenario-based branching), and Level 4 (Complex software simulations and gamified sandboxes)."
  },
  {
    factor: "02. Compliance & Accessibility",
    desc: "Standard commercial delivery versus auditable Section 508 VPAT 2.4 documentation, WCAG 2.1 AA screen-reader verification (JAWS/NVDA), and synchronized closed captions (.vtt)."
  },
  {
    factor: "03. Asset Production & Media",
    desc: "Whether curriculum source materials and media are client-supplied, or if TheEduAssist engineers bespoke motion animations, custom vector diagrams, and professional voice synthesis."
  },
  {
    factor: "04. Platform Infrastructure",
    desc: "Turnkey Kajabi/LearnWorlds setup versus multi-tenant enterprise LMS integration (Cornerstone, Canvas, Moodle, Docebo) and custom headless LMS API connections."
  }
];

const faqs = [
  { question: "Why does TheEduAssist use custom scoping instead of fixed-fee price tags?", answer: "Enterprise learning programs, government compliance modules, and high-ticket flagship academies have vastly different technical, pedagogical, and accessibility requirements. Rigid fixed pricing leads to cut corners or bloated scope fees. We provide transparent, guaranteed fixed-fee Statements of Work (SOW) based on exact project milestones." },
  { question: "How does TheEduAssist price mandatory corporate compliance training?", answer: "We offer three transparent compliance engagement models: Tier 1 Turnkey SCORM Packages ($1,950–$3,500 one-time with unlimited internal employee seats), Tier 2 Annual Regulatory Protection Retainers ($1,800–$3,600/year for automated legislative updates), and Tier 3 Managed Compliance Academies ($2,500 setup + $450–$1,250/mo for companies requiring a fully managed, hosted LMS with automated audit reporting)." },
  { question: "How quickly do you provide formal SOW proposals or RFP responses?", answer: "Our solutions architecture team reviews requests and returns formal Statements of Work, milestone timelines, and RFP capability matrices within 24 to 48 business hours." },
  { question: "Can you execute bilateral Non-Disclosure Agreements (NDAs)?", answer: "Yes. We routinely work under strict bilateral NDAs with corporate leaders and public agencies before reviewing proprietary documentation or internal SOPs." },
  { question: "Do you offer post-launch warranties?", answer: "Yes. All bespoke course development and LMS builds include a 60-day post-launch warranty covering any LMS compatibility bug fixes and technical adjustments." },
  { question: "Can you build exclusively on Kajabi, and which other LMS platforms do you support?", answer: "Yes. TheEduAssist is an expert Kajabi solutions partner, providing custom website styling, product architecture, offer checkouts, email automation, and student onboarding. In addition to Kajabi, our engineering team regularly builds, migrates, and integrates courses across Thinkific, LearnWorlds, Skool, Canvas LMS, Blackboard Learn, Moodle, Docebo, and TalentLMS. Whatever platform your organization runs on, we engineer native, production-ready modules." }
];

import { breadcrumbSchema, faqPageSchema } from "../../lib/seo/schema";

const jsonLd = [
  breadcrumbSchema([
    { name: "Home", urlPath: "/" },
    { name: "Pricing", urlPath: "/pricing/" }
  ]),
  faqPageSchema(faqs)
];
---

<Layout title={title} description={description} canonicalPath="/pricing/" jsonLd={jsonLd}>
  <!-- Hero Section -->
  <section class="bg-gradient-to-b from-brand-navy via-slate-900 to-brand-navy py-24 pb-16 text-white text-center relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_30%,rgba(34,197,94,0.1),transparent_70%)] pointer-events-none"></div>
    <div class="container mx-auto px-4 max-w-4xl relative z-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-green/20 text-brand-green text-xs font-bold uppercase tracking-wider mb-6 border border-brand-green/30">
        Transparent Scoping & Guaranteed Milestone SOWs
      </div>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold mb-6 tracking-tight">
        Investment & Scoping Architecture
      </h1>
      <p class="text-lg md:text-xl text-slate-300 mb-8 max-w-3xl mx-auto leading-relaxed">
        Bespoke instructional design, turnkey course builds, and enterprise public sector training. Every project is scoped with guaranteed fixed-fee milestones, zero hidden costs, and rapid 24–48h SLA turnaround.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <a href="/trust-centre/procurement/" class="bg-[#77BA55] text-slate-950 px-8 py-3.5 rounded-lg font-black text-base hover:bg-white hover:text-brand-navy transition-all shadow-md w-full sm:w-auto">
          Submit Enterprise RFP / SOW Desk &rarr;
        </a>
        <a href="/book-free-audit/" class="bg-white/10 text-white border border-white/20 px-8 py-3.5 rounded-lg font-bold text-base hover:bg-white/20 transition-all w-full sm:w-auto">
          Book 24–48h Project Review
        </a>
      </div>
    </div>
  </section>

  <!-- Interactive Project Cost & Timeline Estimator -->
  <section class="py-12 md:py-16 bg-slate-100 border-b border-slate-200">
    <div class="container mx-auto px-4 max-w-7xl">
      <ElearningCostEstimator />
    </div>
  </section>

  <!-- Engagement Tiers Grid -->
  <section class="py-20 bg-slate-50 border-b border-slate-200">
    <div class="container mx-auto px-4 max-w-7xl">
      <div class="text-center max-w-3xl mx-auto mb-10">
        <h2 class="text-3xl md:text-4xl font-extrabold text-brand-navy mb-4">Five Structured Engagement Models</h2>
        <p class="text-slate-600 text-base md:text-lg">
          Select the model that fits your organization's scale—from rapid strategy sprints and statutory compliance to turnkey digital academies and enterprise workforce deployments.
        </p>
      </div>

      <!-- Audience Filter Tabs -->
      <div class="flex items-center justify-center gap-2 flex-wrap mb-10" id="pricing-audience-tabs">
        <button type="button" data-filter="all" class="audience-tab-btn active px-4 py-2 rounded-full text-xs font-bold border-2 border-[#77BA55] bg-[#77BA55]/15 text-brand-navy shadow-xs transition-all">
          All Solutions (5)
        </button>
        <button type="button" data-filter="creator" class="audience-tab-btn px-4 py-2 rounded-full text-xs font-bold border border-slate-200 bg-white text-slate-700 hover:border-slate-400 transition-all">
          🎓 Course Creators & Academies
        </button>
        <button type="button" data-filter="compliance" class="audience-tab-btn px-4 py-2 rounded-full text-xs font-bold border border-slate-200 bg-white text-slate-700 hover:border-slate-400 transition-all">
          ⚖️ Corporate Compliance & SCORM
        </button>
        <button type="button" data-filter="enterprise" class="audience-tab-btn px-4 py-2 rounded-full text-xs font-bold border border-slate-200 bg-white text-slate-700 hover:border-slate-400 transition-all">
          🏛️ Enterprise & Public Sector
        </button>
      </div>

      <!-- South Asia Regional Client Desk Banner (Shown for PK and IN) -->
      <div id="south-asia-pricing-notice" class="hidden mb-10 p-5 rounded-2xl bg-emerald-50 border border-emerald-200 text-slate-900 max-w-4xl mx-auto shadow-xs">
        <div class="flex items-start gap-3">
          <span class="px-2.5 py-1 rounded-full bg-emerald-600 text-white text-[11px] font-bold uppercase tracking-wider shrink-0 mt-0.5">Regional Desk</span>
          <div class="space-y-1">
            <h4 class="text-sm font-bold text-slate-900">Custom Milestone Scoping for South Asia & Regional Clients</h4>
            <p class="text-xs text-slate-600 leading-relaxed">
              For organizations and academies across Pakistan, India, and South Asia, TheEduAssist provides customized project milestones and local currency payment arrangements.
            </p>
            <div class="pt-2 flex items-center gap-4">
              <a href="/contact-us/?ref=south-asia-desk" class="text-xs font-bold text-emerald-800 hover:underline">
                Speak With Regional Accounts Desk &rarr;
              </a>
            </div>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8" id="pricing-cards-grid">
        {engagementModels.map(pkg => (
          <div class="pricing-model-card bg-white rounded-2xl shadow-sm border border-slate-200 p-8 flex flex-col justify-between hover:border-brand-green/50 hover:shadow-md transition-all relative" data-category={pkg.category}>
            <div>
              <div class="flex justify-between items-center mb-4">
                <span class="inline-block bg-slate-100 text-brand-navy text-xs font-bold uppercase tracking-wider py-1 px-3 rounded-full border border-slate-200">
                  {pkg.badge}
                </span>
                <span class="text-xs font-mono text-slate-500 font-semibold">{pkg.timeline}</span>
              </div>
              <h3 class="text-2xl font-bold text-brand-navy mb-1">{pkg.title}</h3>
              <div class="text-sm font-bold text-brand-green uppercase tracking-wide mb-4">{pkg.model}</div>
              
              <div class="mb-6 pb-6 border-b border-slate-100">
                <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-1">Target Fit:</span>
                <p class="text-sm text-slate-700">{pkg.bestFor}</p>
              </div>

              <p class="text-sm text-slate-600 mb-6 leading-relaxed">{pkg.desc}</p>

              <div class="mb-8">
                <span class="text-xs font-bold text-brand-navy uppercase tracking-wider block mb-3">Included Scope & Deliverables:</span>
                <ul class="space-y-2.5">
                  {pkg.features.map(feat => (
                    <li class="flex items-start text-sm text-slate-600">
                      <svg class="w-4 h-4 text-brand-green mr-2.5 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
                      </svg>
                      <span>{feat}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <div class="pt-6 border-t border-slate-100">
              <a href={pkg.ctaLink} class="block text-center w-full px-6 py-3.5 bg-brand-navy text-white font-bold rounded-lg hover:bg-slate-800 transition-colors shadow-sm text-sm">
                {pkg.ctaText} &rarr;
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Multi-LMS Platform Coverage Matrix -->
  <section class="py-20 bg-white border-b border-slate-200" aria-labelledby="multi-lms-heading">
    <div class="container mx-auto px-4 max-w-7xl">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-xs font-bold text-teal-700 uppercase tracking-wider bg-teal-50 px-3 py-1 rounded-full border border-teal-200">
          Cross-Platform Compatibility
        </span>
        <h2 id="multi-lms-heading" class="text-3xl md:text-4xl font-extrabold text-brand-navy mt-3 mb-4">
          Universal LMS & Learning Platform Coverage
        </h2>
        <p class="text-slate-600 text-base md:text-lg">
          Whether you run an all-in-one creator funnel, an accredited university master shell, or an enterprise compliance portal, TheEduAssist engineers native, production-tested course modules.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Card 1: Creator & All-in-One LMS -->
        <div class="card-glow-lift bg-slate-50 rounded-2xl p-8 border border-slate-200 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full bg-blue-100 text-blue-800">
                Creator & Academy
              </span>
              <span class="text-xs text-slate-500 font-medium">Turnkey Funnels</span>
            </div>
            <h3 class="text-xl font-bold text-brand-navy mb-3">All-in-One Creator Platforms</h3>
            <p class="text-slate-600 text-xs sm:text-sm mb-6 leading-relaxed">
              Complete course portals with integrated marketing funnels, checkout offer pages, and gamified student communities.
            </p>
            <div class="space-y-3 mb-6">
              <div class="text-xs font-bold text-slate-400 uppercase tracking-wider">Supported Platforms:</div>
              <div class="flex flex-wrap gap-1.5">
                {['Kajabi', 'Thinkific', 'LearnWorlds', 'Skool', 'Teachable', 'Circle.so', 'Mighty Networks'].map(platform => (
                  <span class="px-2.5 py-1 bg-white border border-slate-200 rounded-lg text-xs font-semibold text-slate-800 shadow-2xs">
                    {platform}
                  </span>
                ))}
              </div>
            </div>
            <ul class="space-y-2 text-xs text-slate-700 border-t border-slate-200 pt-4">
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-[#77BA55]"></span>
                <span>Custom Liquid theme & CSS styling</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-[#77BA55]"></span>
                <span>Checkout bumps & 1-click upsells</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-[#77BA55]"></span>
                <span>Automated student onboarding sequences</span>
              </li>
            </ul>
          </div>
          <div class="mt-6 pt-4 border-t border-slate-200">
            <a href="/kajabi-services/" class="text-xs font-bold text-[#27496D] hover:text-[#77BA55] inline-flex items-center">
              Explore Creator Services &rarr;
            </a>
          </div>
        </div>

        <!-- Card 2: Academic & Higher Education LMS -->
        <div class="card-glow-lift bg-slate-50 rounded-2xl p-8 border border-slate-200 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full bg-purple-100 text-purple-800">
                Academic & Higher Ed
              </span>
              <span class="text-xs text-slate-500 font-medium">QM Accredited</span>
            </div>
            <h3 class="text-xl font-bold text-brand-navy mb-3">Colleges & Universities</h3>
            <p class="text-slate-600 text-xs sm:text-sm mb-6 leading-relaxed">
              Curriculum conversions that meet collegiate accreditation, pedagogical alignment, and statutory disability compliance.
            </p>
            <div class="space-y-3 mb-6">
              <div class="text-xs font-bold text-slate-400 uppercase tracking-wider">Supported Platforms:</div>
              <div class="flex flex-wrap gap-1.5">
                {['Canvas LMS', 'Blackboard Learn', 'Moodle', 'Brightspace (D2L)', 'Open edX'].map(platform => (
                  <span class="px-2.5 py-1 bg-white border border-slate-200 rounded-lg text-xs font-semibold text-slate-800 shadow-2xs">
                    {platform}
                  </span>
                ))}
              </div>
            </div>
            <ul class="space-y-2 text-xs text-slate-700 border-t border-slate-200 pt-4">
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-[#77BA55]"></span>
                <span>Quality Matters (QM) rubric mapping</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-[#77BA55]"></span>
                <span>Section 508 & WCAG 2.1 AA screen reader checks</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-[#77BA55]"></span>
                <span>Master syllabus conversion into LMS modules</span>
              </li>
            </ul>
          </div>
          <div class="mt-6 pt-4 border-t border-slate-200">
            <a href="/enterprise-solutions/higher-education-and-universities/" class="text-xs font-bold text-[#27496D] hover:text-[#77BA55] inline-flex items-center">
              Explore Higher Ed Solutions &rarr;
            </a>
          </div>
        </div>

        <!-- Card 3: Corporate Enterprise & Workforce LMS -->
        <div class="card-glow-lift bg-slate-50 rounded-2xl p-8 border border-slate-200 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full bg-teal-100 text-teal-800">
                Corporate & Enterprise
              </span>
              <span class="text-xs text-slate-500 font-medium">Auditable Compliance</span>
            </div>
            <h3 class="text-xl font-bold text-brand-navy mb-3">Enterprise Workforce Training</h3>
            <p class="text-slate-600 text-xs sm:text-sm mb-6 leading-relaxed">
              Standard-compliant training packages engineered for Fortune 500, government departments, and multinational workforces.
            </p>
            <div class="space-y-3 mb-6">
              <div class="text-xs font-bold text-slate-400 uppercase tracking-wider">Supported Platforms:</div>
              <div class="flex flex-wrap gap-1.5">
                {['Docebo', 'TalentLMS', 'Cornerstone', 'SAP SuccessFactors', 'Workday', '360Learning'].map(platform => (
                  <span class="px-2.5 py-1 bg-white border border-slate-200 rounded-lg text-xs font-semibold text-slate-800 shadow-2xs">
                    {platform}
                  </span>
                ))}
              </div>
            </div>
            <ul class="space-y-2 text-xs text-slate-700 border-t border-slate-200 pt-4">
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-[#77BA55]"></span>
                <span>SCORM 1.2, SCORM 2004 4th Ed & xAPI CMI5</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-[#77BA55]"></span>
                <span>HRIS automated employee onboarding tracks</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-[#77BA55]"></span>
                <span>Auditable statutory compliance logging & reporting</span>
              </li>
            </ul>
          </div>
          <div class="mt-6 pt-4 border-t border-slate-200">
            <a href="/enterprise-solutions/" class="text-xs font-bold text-[#27496D] hover:text-[#77BA55] inline-flex items-center">
              Explore Enterprise Solutions &rarr;
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- How Projects Are Scoped: The 4 Cost Drivers -->
  <section class="py-20 bg-white border-b border-slate-200">
    <div class="container mx-auto px-4 max-w-6xl">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-xs font-bold text-brand-green uppercase tracking-wider bg-emerald-50 px-3 py-1 rounded-full border border-emerald-100">Scoping Transparency</span>
        <h2 class="text-3xl md:text-4xl font-extrabold text-brand-navy mt-3 mb-4">The 4 Key Cost Drivers in Every Project</h2>
        <p class="text-slate-600">We scope every engagement transparently around four objective technical and instructional parameters:</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {costDrivers.map(item => (
          <div class="p-6 rounded-xl bg-slate-50 border border-slate-200">
            <h3 class="text-lg font-bold text-brand-navy mb-2">{item.factor}</h3>
            <p class="text-sm text-slate-600 leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>

      <!-- RFP Matrix Download Callout -->
