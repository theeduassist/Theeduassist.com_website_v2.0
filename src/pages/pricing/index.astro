  <script>
    function initPricingTabsAndGeo() {
      // 1. Audience Filter Tabs
      const tabBtns = document.querySelectorAll('#pricing-audience-tabs .audience-tab-btn');
      const cards = document.querySelectorAll<HTMLElement>('.pricing-model-card');

      tabBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          tabBtns.forEach(b => {
            b.classList.remove('active', 'border-2', 'border-[#77BA55]', 'bg-[#77BA55]/15', 'text-brand-navy', 'shadow-xs');
            b.classList.add('border', 'border-slate-200', 'bg-white', 'text-slate-700');
          });

          btn.classList.add('active', 'border-2', 'border-[#77BA55]', 'bg-[#77BA55]/15', 'text-brand-navy', 'shadow-xs');
          btn.classList.remove('border', 'border-slate-200', 'bg-white', 'text-slate-700');

          const filter = btn.getAttribute('data-filter') || 'all';

          cards.forEach(card => {
            const cat = card.getAttribute('data-category');
            if (filter === 'all') {
              card.classList.remove('hidden');
            } else if (filter === 'creator') {
              if (cat === 'creator' || cat === 'retainer') {
                card.classList.remove('hidden');
              } else {
                card.classList.add('hidden');
              }
            } else if (filter === 'compliance') {
              if (cat === 'compliance' || cat === 'retainer') {
                card.classList.remove('hidden');
              } else {
                card.classList.add('hidden');
              }
            } else if (filter === 'enterprise') {
              if (cat === 'enterprise' || cat === 'retainer') {
                card.classList.remove('hidden');
              } else {
                card.classList.add('hidden');
              }
            }
          });
        });
      });

      // 2. South Asia Regional Client Desk Display
      const saNotice = document.getElementById('south-asia-pricing-notice');
      if (!saNotice) return;

      const storedCountry = sessionStorage.getItem('theeduassist_user_country');
      const tz = (Intl && Intl.DateTimeFormat) ? Intl.DateTimeFormat().resolvedOptions().timeZone : '';

      if (storedCountry === 'PK' || storedCountry === 'IN' || tz.includes('Karachi') || tz.includes('Calcutta') || tz.includes('Kolkata')) {
        saNotice.classList.remove('hidden');
      } else if (!storedCountry) {
        // Asynchronous lookup if not yet cached
        fetch('https://api.country.is/')
          .then(res => res.json())
          .then(data => {
            if (data && (data.country === 'PK' || data.country === 'IN')) {
              sessionStorage.setItem('theeduassist_user_country', data.country);
              saNotice.classList.remove('hidden');
            }
          })
          .catch(() => {});
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initPricingTabsAndGeo);
    } else {
      initPricingTabsAndGeo();
    }
  </script>
</Layout>
