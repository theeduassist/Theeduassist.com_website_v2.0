---
import Layout from "../../layouts/Layout.astro";
import ContactHero from "../../components/contact/ContactHero.astro";
import ContactOptions from "../../components/contact/ContactOptions.astro";
import ContactFAQ from "../../components/contact/ContactFAQ.astro";
import AIAnswerBlock from "../../components/ai/AIAnswerBlock.astro";
import TrustBadgesStrip from "../../components/ui/TrustBadgesStrip.astro";
import { webPageSchema, breadcrumbSchema } from '../../lib/seo/schema';

const aiAnswers = [
  { q: "How can someone contact TheEduAssist?", a: "The best way to contact TheEduAssist is to book a free 24-48 hour audit through the site, use the live sales chat, or email Info@theeduassist.com directly." }
];

const jsonLd = [
  webPageSchema(
    "Contact TheEduAssist | E-Learning Design Agency",
    "Contact TheEduAssist for online course creation, Kajabi setup, LMS migration, AI-powered e-learning support, content conversion, funnels, automation, and course launch support.",
    "/contact-us/"
  ),
  breadcrumbSchema([
    { name: "Home", urlPath: "/" },
    { name: "Contact", urlPath: "/contact-us/" }
  ])
];

const trustChips = [
  "Course Creation",
  "Kajabi Setup",
  "LMS Migration",
  "AI E-Learning Support",
  "Content Conversion",
  "Funnels & Automation"
];
---
<Layout
  title="Contact TheEduAssist | E-Learning Design Agency"
  description="Contact TheEduAssist for online course creation, Kajabi setup, LMS migration, AI-powered e-learning support, content conversion, funnels, automation, and course launch support."
  canonicalPath="/contact-us/"
  jsonLd={jsonLd}
>

  <ContactHero
    title="Contact TheEduAssist"
    subtitle="Have a course idea, Kajabi setup, LMS migration, training content, or online learning system that needs structure? Get a 24-48 Hour Review and we’ll help you find the right next step."
    primaryCtaLabel="Get 24–48 Hour Review"
    primaryCtaLink="/book-free-audit/"
    secondaryCtaLabel="Email Us"
    secondaryCtaLink="mailto:Info@theeduassist.com?subject=TheEduAssist%20Project%20Inquiry&body=Hi%20TheEduAssist%2C%0A%0AI%20would%20like%20to%20discuss%20a%20course%2C%20Kajabi%2C%20LMS%2C%20content%20conversion%2C%20or%20e-learning%20project.%0A%0AMy%20project%20details%3A%0A"
    email="Info@theeduassist.com"
    trustChips={trustChips}
  />

  <ContactOptions email="Info@theeduassist.com" />

  <!-- Enterprise Verification & Cross-Border Delivery Guarantee -->
  <TrustBadgesStrip variant="light" />

  <!-- Global Remote Studio & Active Client Coverage -->
  <section class="py-10 bg-white border-b border-slate-200">
    <div class="max-w-6xl mx-auto px-4">
      <div class="bg-gradient-to-r from-slate-900 to-[#27496D] text-white rounded-2xl p-6 sm:p-8 shadow-lg flex flex-col lg:flex-row items-center justify-between gap-6">
        <div class="max-w-2xl">
          <div class="flex items-center gap-2 mb-2">
            <span class="w-2.5 h-2.5 rounded-full bg-[#77BA55] animate-pulse"></span>
            <span class="text-xs font-bold uppercase tracking-wider text-[#77BA55]">Borderless Global Remote Studio</span>
          </div>
          <h3 class="text-xl sm:text-2xl font-extrabold text-white">How We Work: Agile Remote Delivery With Global Coverage</h3>
          <p class="text-slate-300 text-sm mt-2 leading-relaxed">
            TheEduAssist operates as a borderless global remote learning studio with core production and engineering hubs in Pakistan. We eliminate agency real-estate bloat to provide direct access to senior instructional designers, with round-the-clock delivery sprints and dedicated time-zone overlap for North America, the UK, Europe, Australia, and the GCC.
          </p>
        </div>
        <div class="grid grid-cols-2 gap-3 w-full lg:w-auto shrink-0 text-xs">
          <div class="p-3 bg-white/10 rounded-xl border border-white/10">
            <div class="font-bold text-white mb-0.5">🇺🇸 US / Canada</div>
            <div class="text-slate-300 text-[11px]">EST & PST Overlap</div>
          </div>
          <div class="p-3 bg-white/10 rounded-xl border border-white/10">
            <div class="font-bold text-white mb-0.5">🇬🇧 UK & Europe</div>
            <div class="text-slate-300 text-[11px]">GMT / CET Hours</div>
          </div>
          <div class="p-3 bg-white/10 rounded-xl border border-white/10">
            <div class="font-bold text-white mb-0.5">🇦🇪 GCC / Middle East</div>
            <div class="text-slate-300 text-[11px]">Riyadh / Dubai Time</div>
          </div>
          <div class="p-3 bg-white/10 rounded-xl border border-white/10">
            <div class="font-bold text-white mb-0.5">🇦🇺 Australia / NZ</div>
            <div class="text-slate-300 text-[11px]">AEST Sprint Syncs</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Form Section -->
  <section class="py-12 md:py-16 bg-slate-50 border-t border-slate-200" id="review-form">
    <div class="max-w-4xl mx-auto px-4">
      <div class="bg-white p-4 md:p-8 rounded-xl border border-slate-200 shadow-sm overflow-hidden text-center">

        <h2 class="text-3xl font-bold mb-3 text-slate-900">Get a 24–48 Hour Review</h2>
        <p class="text-slate-600 max-w-2xl mx-auto text-base mb-8">
          Share your course, Kajabi, LMS, content, or launch challenge. TheEduAssist team will review your request and reply with the best service path, estimated scope, and next step.
        </p>

        <div class="w-full mx-auto relative rounded-lg border border-slate-100" style="overflow-x: hidden;">
          <iframe
            src="https://docs.google.com/forms/d/e/1FAIpQLSceDHOuoN8pGLzkG80JDiQFFtZRr9mxQTHkVRZnWqe3pnesDA/viewform?embedded=true"
            width="100%"
            height="1600"
            class="border-0 bg-white w-full h-[1800px] sm:h-[1600px]"
            title="TheEduAssist 24–48 Hour Course Review Form"
            loading="lazy"
          >Loading…</iframe>
        </div>

        <div class="mt-8 text-center border-t border-slate-100 pt-6">
          <p class="text-slate-600 mb-4">Having trouble viewing the form?</p>
          <a
            href="https://docs.google.com/forms/d/e/1FAIpQLSceDHOuoN8pGLzkG80JDiQFFtZRr9mxQTHkVRZnWqe3pnesDA/viewform"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center bg-white text-blue-600 border border-blue-200 hover:bg-blue-50 px-6 py-3 rounded-md font-semibold transition-colors focus-ring"
          >
            Open Review Form in New Tab
          </a>
        </div>
      </div>
    </div>
  </section>

  <AIAnswerBlock questions={aiAnswers} />

  <ContactFAQ />

</Layout>
