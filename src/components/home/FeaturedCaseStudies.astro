---
import { caseStudies as fallbackCaseStudies } from '../../data/caseStudies';

const targetSlugs = [
  'sqa-aligned-vocational-training',
  'business-analytics-corporate-training',
  'language-courses-book-publisher'
];


const fallbackStudyMap = new Map();
if (Array.isArray(fallbackCaseStudies)) {
  for (const study of fallbackCaseStudies) {
    if (study && study.slug) {
      fallbackStudyMap.set(study.slug, study);
    }
  }
}

// Ensure the exact three case studies are displayed.
// Use static fallback.
const featuredCaseStudies = targetSlugs.map(slug => {
  const fallbackStudy = fallbackStudyMap.get(slug);

  if (fallbackStudy) {
    return {
      title: fallbackStudy.title,
      slug: fallbackStudy.slug,
      summary: fallbackStudy.summary,
      industry: fallbackStudy.industry,
      clientType: fallbackStudy.clientType,
      location: fallbackStudy.location,
      topOutcome: fallbackStudy.outcomes?.[0] || 'LMS-Ready Interactive Deployment',
      sprintCount: fallbackStudy.sprintModel?.sprints?.length || 6,
      imageUrl: null
    };
  }

  // This should ideally never hit if the fallbacks exist.
  return null;
}).filter(Boolean);
---
<section class="py-24 bg-brand-softBg border-y border-brand-border/30 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-primary/10 border border-brand-primary/20 text-brand-primary text-xs font-bold uppercase tracking-wider mb-3">
        Real Client Deployments
      </div>
      <h2 class="text-3xl md:text-4xl font-bold text-brand-navy mb-4">Enterprise & Institutional Case Studies</h2>
      <p class="text-lg text-brand-textMuted max-w-2xl mx-auto">Explore how we engineer measurable learning architectures for public sector institutes, corporate teams, and digital publishers.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
      {featuredCaseStudies.map(study => (
        <a href={`/case-studies/${study.slug}/`} class="group bg-white rounded-2xl border border-brand-border hover:border-brand-accent/50 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col overflow-hidden focus-ring h-full">
          <!-- Card Header Visual Treatment -->
          <div class="p-6 bg-gradient-to-br from-slate-900 to-brand-navy text-white relative overflow-hidden border-b border-brand-border/50">
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class="inline-block bg-white/10 text-white text-[11px] font-bold px-2.5 py-0.5 rounded border border-white/15 uppercase tracking-wide">
                {study.clientType}
              </span>
              <span class="text-xs text-brand-green font-semibold flex items-center gap-1">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                {study.location}
              </span>
            </div>
            <div class="text-xs text-slate-300 uppercase tracking-wider font-mono">
              Sprint Model &bull; {study.sprintCount} Sprints
            </div>
          </div>

          <!-- Content -->
          <div class="p-6 md:p-8 flex-grow flex flex-col">
            <div class="mb-4">
               <span class="inline-block bg-brand-softBg text-brand-primary text-xs font-bold px-3 py-1 rounded-full mb-3 uppercase tracking-wider">{study.industry}</span>
               <h3 class="text-xl font-bold text-brand-navy group-hover:text-brand-accent transition-colors line-clamp-2">{study.title}</h3>
            </div>

            <p class="text-brand-textMuted line-clamp-3 mb-6 text-sm leading-relaxed">
              {study.summary}
            </p>

            <!-- Key Outcome Highlight -->
            <div class="mb-6 p-3 bg-brand-softBg/60 rounded-lg border border-brand-border/40">
              <span class="text-[10px] font-bold uppercase tracking-wider text-brand-navy/60 block mb-1">Key Verified Outcome</span>
              <p class="text-xs font-semibold text-brand-navy flex items-start gap-1.5">
                <svg class="w-4 h-4 text-brand-green shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
                <span>{study.topOutcome}</span>
              </p>
            </div>

            <div class="mt-auto pt-4 border-t border-brand-border/50 text-brand-primary font-bold text-sm flex items-center group-hover:text-brand-accent transition-colors">
              Read Full Case Study <span class="ml-2 transition-transform group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
            </div>
          </div>
        </a>
      ))}
    </div>

    <div class="text-center">
      <a href="/case-studies/" class="inline-flex justify-center items-center bg-transparent border-2 border-brand-primary text-brand-primary px-8 py-4 rounded-md font-bold text-lg hover-lift click-press focus-ring transition-all hover:bg-brand-softBg">
        View All Case Studies <span class="ml-2" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>
