---
import { ArrowRight } from "lucide-react";

interface Props {
  isReferenceHome?: boolean;
}
const { isReferenceHome = false } = Astro.props;

---
<section class="relative bg-brand-navy text-white overflow-hidden py-20 lg:py-32" aria-labelledby="home-hero-heading">
  <div class="absolute inset-0 z-0 opacity-10">
    <svg class="absolute w-full h-full" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
      <defs>
        <pattern id="hero-grid" width="40" height="40" patternUnits="userSpaceOnUse">
          <path d="M 40 0 L 0 0 0 40" fill="none" stroke="currentColor" stroke-width="1"/>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#hero-grid)" />
    </svg>
  </div>

  <!-- Glowing background gradient highlight -->
  <div class="absolute -top-40 -left-40 w-96 h-96 bg-brand-green/15 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-40 -right-40 w-96 h-96 bg-blue-500/15 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 flex flex-col lg:flex-row items-center gap-12 lg:gap-16">
    <div class="w-full lg:w-1/2 space-y-8">
      <span class="inline-block text-brand-green font-semibold tracking-wide uppercase text-sm">Learning Transformation, Technology and Course Development</span>
      <h1 id="home-hero-heading" class="text-4xl sm:text-5xl lg:text-6xl font-bold leading-tight">
        {isReferenceHome ? "Welcome to TheEduAssist - Digital Learning Solutions" : "Build Learning Experiences That Are Structured, Scalable and Ready to Use"}
      </h1>
      <p class="text-lg text-slate-300 max-w-2xl leading-relaxed">
        {isReferenceHome ? "Explore our comprehensive overview of e-learning design, instructional strategies, and learning management systems customized for your organization's unique requirements." : "TheEduAssist helps organizations, academies, creators and training teams turn expertise, existing content and learning goals into professional courses, LMS experiences, Kajabi systems and digital learning programs."}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 pt-4">
        <a href="/book-free-audit/" class="inline-flex justify-center items-center px-6 py-3.5 border border-transparent text-base font-semibold rounded-md text-brand-navy bg-brand-green hover:bg-green-500 transition-all duration-300 hover:shadow-lg hover:shadow-brand-green/20 hover:-translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-brand-green focus:ring-offset-brand-navy">
          Get a 24–48 Hour Review
          <ArrowRight className="ml-2 -mr-1 w-5 h-5 transition-transform group-hover:translate-x-1" />
        </a>
        <a href="/services/" class="inline-flex justify-center items-center px-6 py-3.5 border border-slate-600 text-base font-semibold rounded-md text-white hover:bg-slate-800 hover:border-slate-400 transition-all duration-300 hover:-translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-slate-500 focus:ring-offset-brand-navy">
          Explore Our Services
        </a>
      </div>
      <p class="text-sm text-slate-400 font-medium pt-6 lg:pt-8 border-t border-slate-700/50">
        Course strategy • Custom eLearning • LMS implementation • Kajabi • Content conversion • Learning support
      </p>
    </div>
    <div class="w-full lg:w-1/2 flex justify-center items-center">
      <div class="bg-white/5 backdrop-blur-sm border border-white/10 rounded-3xl p-8 w-full max-w-lg shadow-2xl transition-transform hover:scale-[1.01] duration-500">
        
        <!-- Stats -->
        <div class="grid grid-cols-2 gap-6 mb-8 pb-8 border-b border-white/10">
          <div class="text-center">
            <div class="text-3xl font-extrabold text-brand-green mb-1">500+</div>
            <div class="text-sm text-slate-300">Courses Built</div>
          </div>
          <div class="text-center">
            <div class="text-3xl font-extrabold text-brand-green mb-1">150+</div>
            <div class="text-sm text-slate-300">Happy Clients</div>
          </div>
          <div class="text-center">
            <div class="text-3xl font-extrabold text-brand-green mb-1">15+</div>
            <div class="text-sm text-slate-300">LMS Platforms</div>
          </div>
          <div class="text-center">
            <div class="text-3xl font-extrabold text-brand-green mb-1">48hr</div>
            <div class="text-sm text-slate-300">Review Turnaround</div>
          </div>
        </div>

        <!-- Process Steps -->
        <div class="space-y-4">
          <div class="flex items-center gap-4 bg-white/5 rounded-xl p-4">
            <div class="w-8 h-8 bg-brand-green/20 rounded-lg flex items-center justify-center text-brand-green font-bold text-sm shrink-0">1</div>
            <div>
              <div class="font-semibold text-white text-sm">Share Your Content</div>
              <div class="text-xs text-slate-400">SOPs, videos, docs, slides</div>
            </div>
          </div>
          <div class="flex items-center gap-4 bg-white/5 rounded-xl p-4">
            <div class="w-8 h-8 bg-blue-500/20 rounded-lg flex items-center justify-center text-blue-400 font-bold text-sm shrink-0">2</div>
            <div>
              <div class="font-semibold text-white text-sm">We Design & Build</div>
              <div class="text-xs text-slate-400">Courses, LMS, Kajabi systems</div>
            </div>
          </div>
          <div class="flex items-center gap-4 bg-white/5 rounded-xl p-4">
            <div class="w-8 h-8 bg-amber-500/20 rounded-lg flex items-center justify-center text-amber-400 font-bold text-sm shrink-0">3</div>
            <div>
              <div class="font-semibold text-white text-sm">Launch & Scale</div>
              <div class="text-xs text-slate-400">Live, working, ready to grow</div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>