---
import { ArrowRight, Building2, UserRound, GraduationCap } from "lucide-react";

const pathways = [
  {
    badge: "Enterprise & GCC Industry",
    title: "For Enterprises, Gov & Industrial Contractors",
    description: "Build auditable compliance training, Section 508 accessibility, bilingual Arabic/English HSE safety, and enterprise SCORM/xAPI systems.",
    highlights: ["Bilingual HSE Safety (Arabic/English)", "Section 508 / Gov RFP Support", "SAP & Oracle LMS Integration"],
    cta: "Explore Enterprise Solutions",
    url: "/enterprise-solutions/",
    icon: Building2
  },
  {
    badge: "Universities & Higher Ed",
    title: "For Colleges, Deans & University Faculty",
    description: "Transform academic syllabi into accredited master course shells, ensure Quality Matters (QM) alignment, and engineer Canvas/Blackboard modules.",
    highlights: ["Canvas & Blackboard Master Shells", "Quality Matters (QM) Alignment", "University PO & W-8BEN-E Ready"],
    cta: "Explore University Solutions",
    url: "/enterprise-solutions/higher-education-and-universities/",
    icon: GraduationCap
  },
  {
    badge: "Creators & Academies",
    title: "For Creators, Coaches and Scale Academies",
    description: "Turn expertise into structured courses, interactive student communities, Kajabi systems, and high-converting learner funnels.",
    highlights: ["Kajabi Pipelines & Portals", "Curriculum Architecture", "Fast 24-48 Hr Course Reviews"],
    cta: "Explore Kajabi & Academy Support",
    url: "/kajabi-services/",
    icon: UserRound
  }
];
---
<section class="py-20 lg:py-32 bg-white" aria-labelledby="audience-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 id="audience-heading" class="text-3xl md:text-4xl font-bold text-brand-navy tracking-tight">Choose the Support That Matches What You Are Building</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {pathways.map((pathway) => (
        <div class="group relative flex flex-col bg-slate-50 rounded-2xl p-8 border border-slate-200 transition-all duration-300 hover:shadow-xl hover:-translate-y-1 hover:border-brand-primary/40 h-full overflow-hidden">
          <div class="flex items-center justify-between mb-6">
            <div class="w-12 h-12 rounded-xl bg-brand-navy text-white flex items-center justify-center transition-transform duration-300 group-hover:scale-110 shadow-md">
              <pathway.icon className="w-6 h-6" />
            </div>
            <span class="text-xs font-bold uppercase tracking-wider px-3 py-1 bg-brand-softBg text-brand-primary rounded-full border border-brand-primary/20">
              {pathway.badge}
            </span>
          </div>

          <h3 class="text-xl font-bold text-brand-navy mb-4 group-hover:text-brand-primary transition-colors">{pathway.title}</h3>
          <p class="text-slate-600 mb-6 flex-grow leading-relaxed text-sm sm:text-base">{pathway.description}</p>

          <ul class="space-y-2 mb-8 border-t border-slate-200/80 pt-4 text-xs sm:text-sm text-slate-700 font-medium">
            {pathway.highlights.map((highlight) => (
              <li class="flex items-center">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-green mr-2.5"></span>
                {highlight}
              </li>
            ))}
          </ul>

          <a href={pathway.url} class="inline-flex items-center text-brand-navy font-bold hover:text-brand-accent transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-brand-green rounded-sm mt-auto pt-2">
            {pathway.cta}
            <ArrowRight className="ml-2 w-4 h-4 transition-transform group-hover:translate-x-1.5" />
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
