---
import { CheckCircle2 } from 'lucide-react';

const needs = [
  "Employee onboarding",
  "Workforce upskilling",
  "Customer education",
  "Partner training",
  "Internal academies",
  "Product and service training",
  "Content modernization",
  "LMS implementation",
  "Learning operations support"
];
---
<section class="py-24 bg-white relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="flex flex-col lg:flex-row items-center gap-16">

      <!-- Content Side -->
      <div class="w-full lg:w-1/2">
        <h2 class="text-3xl md:text-4xl font-bold text-brand-navy mb-6 leading-tight">
          Build Learning Systems for Teams, Customers and Partners
        </h2>
        <p class="text-lg text-brand-textMuted leading-relaxed mb-10">
          TheEduAssist helps organizations turn internal knowledge, subject-matter expertise and existing training content into structured digital learning systems that are easier to deliver, maintain and scale.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-10">
          {needs.map(need => (
            <div class="flex items-start">
              <CheckCircle2 className="w-5 h-5 text-brand-accent mt-0.5 shrink-0 mr-3" aria-hidden="true" />
              <span class="text-brand-textMain font-medium">{need}</span>
            </div>
          ))}
        </div>

        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/enterprise-solutions/" class="inline-flex justify-center items-center bg-brand-primary text-white px-8 py-4 rounded-md font-bold text-lg hover-lift click-press focus-ring transition-all hover:bg-brand-accent shadow-sm">
            Explore Enterprise Solutions
          </a>
          <a href="/book-free-audit/" class="inline-flex justify-center items-center bg-transparent border-2 border-brand-primary text-brand-primary px-8 py-4 rounded-md font-bold text-lg hover-lift click-press focus-ring transition-all hover:bg-brand-softBg">
            Get a 24–48 Hour Review
          </a>
        </div>
      </div>

      <!-- Visual Side -->
      <div class="w-full lg:w-1/2">
        <div class="bg-brand-softBg border border-brand-border rounded-2xl p-8 lg:p-12 shadow-sm relative">
          <!-- Abstract representation of structured organizational learning -->
       <!-- Stats & Process Visual -->
          <div class="flex flex-col gap-6">
            <!-- Stats -->
            <div class="grid grid-cols-2 gap-4">
              <div class="bg-white rounded-xl p-4 text-center border border-brand-border shadow-sm">
                <div class="text-2xl font-extrabold text-brand-accent">500+</div>
                <div class="text-xs text-brand-textMuted mt-1">Courses Built</div>
              </div>
              <div class="bg-white rounded-xl p-4 text-center border border-brand-border shadow-sm">
                <div class="text-2xl font-extrabold text-brand-accent">150+</div>
                <div class="text-xs text-brand-textMuted mt-1">Happy Clients</div>
              </div>
              <div class="bg-white rounded-xl p-4 text-center border border-brand-border shadow-sm">
                <div class="text-2xl font-extrabold text-brand-accent">15+</div>
                <div class="text-xs text-brand-textMuted mt-1">LMS Platforms</div>
              </div>
              <div class="bg-white rounded-xl p-4 text-center border border-brand-border shadow-sm">
                <div class="text-2xl font-extrabold text-brand-accent">48hr</div>
                <div class="text-xs text-brand-textMuted mt-1">Review Turnaround</div>
              </div>
            </div>
            <!-- Process Steps -->
            <div class="space-y-3">
              <div class="flex items-center gap-4 bg-white p-4 rounded-lg shadow-sm border border-brand-border/50">
                <div class="w-8 h-8 rounded-lg bg-brand-accent/10 flex items-center justify-center text-brand-accent font-bold text-sm shrink-0">1</div>
                <div>
                  <div class="font-semibold text-brand-navy text-sm">Share Your Content</div>
                  <div class="text-xs text-brand-textMuted">SOPs, videos, docs</div>
                </div>
              </div>
              <div class="flex items-center gap-4 bg-white p-4 rounded-lg shadow-sm border border-brand-border/50">
                <div class="w-8 h-8 rounded-lg bg-blue-500/10 flex items-center justify-center text-blue-500 font-bold text-sm shrink-0">2</div>
                <div>
                  <div class="font-semibold text-brand-navy text-sm">We Design & Build</div>
                  <div class="text-xs text-brand-textMuted">Courses, LMS, Kajabi</div>
                </div>
              </div>
              <div class="flex items-center gap-4 bg-white p-4 rounded-lg shadow-sm border border-brand-border/50">
                <div class="w-8 h-8 rounded-lg bg-green-500/10 flex items-center justify-center text-green-500 font-bold text-sm shrink-0">3</div>
                <div>
                  <div class="font-semibold text-brand-navy text-sm">Launch & Scale</div>
                  <div class="text-xs text-brand-textMuted">Live, working, ready to grow</div>
                </div>
              </div>
            </div>
          </div>
      </div>

    </div>
  </div>
</section>
