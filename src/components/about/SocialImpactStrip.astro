---
import { Heart, ArrowRight, ShieldCheck, Hospital, ExternalLink } from "lucide-react";
---

<section class="py-16 md:py-24 bg-gradient-to-r from-slate-900 via-[#11324D] to-[#0D3B4C] text-white relative overflow-hidden" aria-labelledby="pro-bono-heading">
  <div class="absolute -right-20 -bottom-20 w-80 h-80 bg-teal-500/15 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      <div class="lg:col-span-8 space-y-4">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-teal-400 animate-pulse"></span>
          <span class="text-xs font-bold uppercase tracking-wider text-teal-300">Pro-Bono Humanitarian Pledge</span>
        </div>
        <h2 id="pro-bono-heading" class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
          Technology with a Soul: Project HeartSync
        </h2>
        <p class="text-slate-200 text-sm sm:text-base leading-relaxed max-w-2xl">
          We believe advanced software and instructional design must elevate humanity. TheEduAssist dedicates engineering capacity to pro-bono healthcare tools—including <strong class="text-teal-300">Project HeartSync</strong>, connecting 1,400+ psychiatric inpatients at Punjab Institute of Mental Health (PIMH Lahore) with their distant families across Pakistan.
        </p>
        <div class="flex flex-wrap gap-4 pt-2 text-xs font-semibold text-teal-200">
          <span>✓ 1,400+ Beds Supported</span>
          <span>•</span>
          <span>✓ 10,000+ Relatives Comforted Annually</span>
          <span>•</span>
          <span>✓ 100% Free Public Welfare Service</span>
        </div>
      </div>

      <div class="lg:col-span-4 flex flex-col sm:flex-row lg:flex-col gap-3 justify-center">
        <a 
          href="/social-impact/heartsync/" 
          class="btn-shimmer inline-flex items-center justify-center px-6 py-3.5 rounded-xl font-bold text-sm bg-teal-500 hover:bg-teal-400 text-slate-950 shadow-lg transition-all text-center"
        >
          Read Full HeartSync Showcase
          <ArrowRight className="w-4 h-4 ml-2" />
        </a>
        <a 
          href="https://pims-family.vercel.app" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="inline-flex items-center justify-center px-6 py-3.5 rounded-xl font-bold text-sm bg-white/10 hover:bg-white/20 border border-white/20 text-white transition-all text-center"
        >
          Live Family Portal Demo
          <ExternalLink className="w-4 h-4 ml-2" />
        </a>
      </div>
    </div>
  </div>
</section>
