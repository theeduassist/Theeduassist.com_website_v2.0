---
interface Props {
  cityData: any;
}

const { cityData } = Astro.props;
---

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
  <!-- Hero Section -->
  <div class="mb-16 text-center max-w-4xl mx-auto">
    {cityData.localLanguage?.nativeGreeting && (
      <div class="inline-block px-4 py-1.5 mb-4 bg-brand-softBg text-brand-primary border border-brand-accent/30 rounded-full text-sm font-semibold tracking-wide">
        {cityData.localLanguage.nativeGreeting}
      </div>
    )}
    <h1 class="text-4xl md:text-5xl font-bold text-brand-navy mb-6">{cityData.h1 || `E-Learning Development Services in ${cityData.cityName}`}</h1>
    <p class="text-xl text-slate-600 leading-relaxed">{cityData.heroIntro || cityData.shortHero}</p>
    {cityData.localLanguage?.culturalEthos && (
      <p class="mt-3 text-sm text-slate-500 italic font-medium">
        Cultural Learning Ethos: {cityData.localLanguage.culturalEthos}
      </p>
    )}
  </div>

  <!-- Quick Answer -->
  {cityData.quickAnswer && (
    <div class="bg-brand-softBg border border-brand-accent/20 rounded-xl p-8 mb-16 shadow-sm max-w-4xl mx-auto">
      <h2 class="text-2xl font-bold text-brand-navy mb-4">Quick Answer</h2>
      <p class="text-slate-700 font-medium">{cityData.quickAnswer}</p>
    </div>
  )}

  <!-- Business Districts & Higher Education Ecosystem -->
  {cityData.topPlacesAndHubs && (
    <div class="mb-20 bg-slate-50 border border-slate-200 rounded-2xl p-8 sm:p-10 shadow-sm">
      <h2 class="text-3xl font-bold text-brand-navy mb-8 text-center">Business Districts & Education Ecosystem in {cityData.cityName}</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
        {cityData.topPlacesAndHubs.commercialDistricts && cityData.topPlacesAndHubs.commercialDistricts.length > 0 && (
          <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
            <h3 class="text-lg font-bold text-brand-primary mb-4 flex items-center gap-2">
              <svg class="w-5 h-5 text-brand-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
              Key Commercial & Innovation Districts
            </h3>
            <div class="flex flex-wrap gap-2">
              {cityData.topPlacesAndHubs.commercialDistricts.map(hub => (
                <span class="bg-slate-100 text-slate-700 text-sm px-3 py-1 rounded-md font-medium">{hub}</span>
              ))}
            </div>
          </div>
        )}
        {cityData.topPlacesAndHubs.academicInstitutions && cityData.topPlacesAndHubs.academicInstitutions.length > 0 && (
          <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
            <h3 class="text-lg font-bold text-brand-primary mb-4 flex items-center gap-2">
              <svg class="w-5 h-5 text-brand-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"></path></svg>
              Academic & Higher Education Hubs
            </h3>
            <div class="flex flex-wrap gap-2">
              {cityData.topPlacesAndHubs.academicInstitutions.map(inst => (
                <span class="bg-slate-100 text-slate-700 text-sm px-3 py-1 rounded-md font-medium">{inst}</span>
              ))}
            </div>
          </div>
        )}
      </div>
    </div>
  )}

  <!-- Enterprise Learning Evolution Context -->
  {cityData.cityHistoryAndLearning && (
    <div class="mb-20 bg-white border border-slate-200 rounded-2xl p-8 sm:p-10 shadow-sm">
      <h2 class="text-3xl font-bold text-brand-navy mb-4">Enterprise Learning Evolution in {cityData.cityName}</h2>
      <p class="text-slate-700 leading-relaxed mb-4 text-base sm:text-lg">{cityData.cityHistoryAndLearning.historicalContext}</p>
      <p class="text-slate-600 leading-relaxed text-sm sm:text-base">{cityData.cityHistoryAndLearning.trainingEvolution}</p>
    </div>
  )}

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 mb-20">
    <!-- Local Training Needs -->
    <div>
      <h2 class="text-3xl font-bold text-brand-navy mb-6">Local Training Needs in {cityData.cityName}</h2>
      <div class="prose max-w-none text-slate-700">
        <p class="leading-relaxed">{cityData.localTrainingNeeds || cityData.commonTrainingNeeds}</p>
      </div>
    </div>

    <!-- Who We Help -->
    <div class="bg-slate-50 p-8 rounded-xl border border-slate-100">
      <h2 class="text-2xl font-bold text-brand-navy mb-6">Who We Help in {cityData.cityName}</h2>
      <div class="flex flex-wrap gap-2">
        {(cityData.whoWeHelp || cityData.buyerTypes || []).map(buyer => (
          <span class="bg-white text-brand-primary border border-slate-200 px-3 py-1 rounded-full text-sm font-medium">{buyer}</span>
        ))}
      </div>
    </div>
  </div>

  <!-- What We Help Build -->
  {cityData.whatWeHelpBuild && cityData.whatWeHelpBuild.length > 0 && (
    <div class="mb-20">
      <h2 class="text-3xl font-bold text-brand-navy mb-8 text-center">What We Help {cityData.cityName} Clients Build</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 max-w-5xl mx-auto">
        {cityData.whatWeHelpBuild.map(item => (
          <div class="flex items-start p-4 bg-white border border-slate-200 rounded-lg shadow-sm">
            <svg class="w-6 h-6 text-brand-accent mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            <span class="text-slate-700 font-medium">{item}</span>
          </div>
        ))}
      </div>
    </div>
  )}

  <!-- LMS Guidance Section -->
  {cityData.lmsGuidance && (
    <div class="bg-brand-navy text-white rounded-2xl p-10 mb-20 shadow-lg relative overflow-hidden">
      <div class="relative z-10 max-w-4xl mx-auto text-center">
        <h2 class="text-3xl font-bold mb-6">LMS & Platform Guidance for {cityData.cityName}</h2>
        <p class="text-lg text-slate-300 leading-relaxed">{cityData.lmsGuidance}</p>
      </div>
    </div>
  )}

  <!-- Popular Services -->
  {cityData.popularServices && cityData.popularServices.length > 0 && (
    <div class="mb-20">
      <h2 class="text-3xl font-bold text-brand-navy mb-8 text-center border-b pb-4">Popular Services for {cityData.cityName} Clients</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {cityData.popularServices.map(service => (
          <a href={service.link || "/services/"} class="block bg-white p-6 rounded-xl border border-slate-200 hover:border-brand-accent shadow-sm transition-all group">
            <h3 class="text-xl font-bold text-brand-primary group-hover:text-brand-accent mb-3">{service.name || service}</h3>
            {service.description && <p class="text-slate-600 text-sm leading-relaxed">{service.description}</p>}
          </a>
        ))}
      </div>
    </div>
  )}

  <!-- Complete Learning Lifecycle -->
  {cityData.learningLifecycle && cityData.learningLifecycle.length > 0 && (
    <div class="mb-20 bg-slate-50 p-10 rounded-2xl border border-slate-100">
      <h2 class="text-3xl font-bold text-brand-navy mb-10 text-center">Our Complete Learning Lifecycle</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {cityData.learningLifecycle.map((step, index) => (
          <div class="relative">
            <div class="text-5xl font-extrabold text-brand-accent/20 absolute -top-4 -left-2 z-0">{index + 1}</div>
            <div class="relative z-10 pl-6">
              <h3 class="text-xl font-bold text-brand-primary mb-2">{step.stage}</h3>
              <p class="text-slate-600">{step.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  )}

  <!-- Local Language & Cultural Search Terms -->
  {cityData.languageLocalizationNeeds && (
    <div class="mb-20 bg-slate-50 p-8 rounded-xl border border-slate-100">
      <h2 class="text-2xl font-bold text-brand-navy mb-4">Regional Market & Linguistic Alignment</h2>
      <p class="text-slate-700 leading-relaxed">{cityData.languageLocalizationNeeds}</p>
    </div>
  )}

  <!-- Regional Compliance & Regulatory Standards -->
  {cityData.regionalCompliance && (
    <div class="mb-20 bg-emerald-50/50 border border-emerald-200/60 rounded-xl p-8">
      <div class="flex items-start">
        <div class="p-3 bg-emerald-100 rounded-lg text-emerald-800 mr-4 flex-shrink-0">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
        </div>
        <div>
          <h2 class="text-2xl font-bold text-brand-navy mb-2">Regional Compliance & Standards for {cityData.cityName}</h2>
          <p class="text-slate-700 leading-relaxed">{cityData.regionalCompliance}</p>
        </div>
      </div>
    </div>
  )}
  <!-- Related Resources (Contextual internal links) -->
  <div class="mb-20">
    <h2 class="text-3xl font-bold text-brand-navy mb-8">Related Resources</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
            <h3 class="text-xl font-bold text-brand-primary mb-4">Related Work & Case Studies</h3>
            <ul class="space-y-3">
                <li><a href="/case-studies/business-analytics-corporate-training/" class="text-brand-accent hover:underline font-medium">Corporate LMS Training Conversion</a></li>
                <li><a href="/case-studies/language-courses-book-publisher/" class="text-brand-accent hover:underline font-medium">Publisher Content to eLearning Conversion</a></li>
                <li><a href="/case-studies/sqa-aligned-vocational-training/" class="text-brand-accent hover:underline font-medium">Vocational Training eLearning Design</a></li>
            </ul>
        </div>
        <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
            <h3 class="text-xl font-bold text-brand-primary mb-4">Latest Insights</h3>
            <ul class="space-y-3">
                <li><a href="/blog/best-learning-management-systems/" class="text-brand-accent hover:underline font-medium">10 Best Learning Management Systems Compared</a></li>
                <li><a href="/blog/lms-implementation-guide/" class="text-brand-accent hover:underline font-medium">LMS Implementation Guide</a></li>
                <li><a href="/blog/employee-training-lms-technology/" class="text-brand-accent hover:underline font-medium">How to Boost Employee Training with LMS</a></li>
            </ul>
        </div>
    </div>
  </div>

  <!-- Global & Regional Learning Hub Network (Extensive Topic Cluster Interlinking) -->
  <div class="mb-20 bg-slate-50 border border-slate-200/80 rounded-2xl p-8 sm:p-10 shadow-sm">
    <div class="max-w-3xl mb-8">
      <span class="text-xs uppercase tracking-widest text-brand-primary font-bold bg-white px-3 py-1 rounded-full border border-slate-200">Global Learning Delivery Network</span>
      <h2 class="text-2xl sm:text-3xl font-bold text-brand-navy mt-3 mb-2">Connected eLearning Hubs & Innovation Corridors</h2>
      <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
        TheEduAssist delivers custom course creation, enterprise LMS migration, and university-grade digital curricula across interconnected regional and international technology corridors.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 text-sm">
      <!-- Cluster 1: North America Tech & Enterprise -->
      <div class="bg-white p-5 rounded-xl border border-slate-200/70 shadow-2xs">
        <h3 class="font-bold text-brand-navy mb-3 flex items-center gap-1.5 text-xs uppercase tracking-wider text-brand-primary">
          <span class="w-2 h-2 rounded-full bg-blue-500"></span>
          North America Tech Hubs
        </h3>
        <ul class="space-y-2 text-slate-600">
          <li><a href="/locations/new-york-elearning-development/" class="hover:text-brand-primary hover:underline transition-colors">New York, NY</a></li>
          <li><a href="/locations/san-francisco-elearning-development/" class="hover:text-brand-primary hover:underline transition-colors">San Francisco, CA</a></li>
          <li><a href="/locations/san-jose-elearning-development/" class="hover:text-brand-primary hover:underline transition-colors">San Jose / Silicon Valley</a></li>
          <li><a href="/locations/chicago-elearning-development/" class="hover:text-brand-primary hover:underline transition-colors">Chicago, IL</a></li>
          <li><a href="/locations/dallas-elearning-development/" class="hover:text-brand-primary hover:underline transition-colors">Dallas, TX</a></li>
          <li><a href="/locations/austin-elearning-development/" class="hover:text-brand-primary hover:underline transition-colors">Austin, TX</a></li>
          <li><a href="/locations/boston-elearning-development/" class="hover:text-brand-primary hover:underline transition-colors">Boston, MA</a></li>
          <li><a href="/locations/seattle-elearning-development/" class="hover:text-brand-primary hover:underline transition-colors">Seattle, WA</a></li>
        </ul>
      </div>

      <!-- Cluster 2: Europe & UK Corporate L&D -->
      <div class="bg-white p-5 rounded-xl border border-slate-200/70 shadow-2xs">
        <h3 class="font-bold text-brand-navy mb-3 flex items-center gap-1.5 text-xs uppercase tracking-wider text-brand-primary">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          Europe & UK L&D Centers
        </h3>
        <ul class="space-y-2 text-slate-600">
          <li><a href="/locations/london-elearning-development/" class="hover:text-brand-primary hover:underline transition-colors">London, UK</a></li>
          <li><a href="/locations/amsterdam-elearning-development/" class="hover:text-brand-primary hover:underline transition-colors">Amsterdam, Netherlands</a></li>
          <li><a href="/locations/frankfurt-elearning-development/" class="hover:text-brand-primary hover:underline transition-colors">Frankfurt am Main, Germany</a></li>
          <li><a href="/locations/dublin-elearning-development/" class="hover:text-brand-primary hover:underline transition-colors">Dublin, Ireland</a></li>
          <li><a href="/locations/paris-elearning-development/" class="hover:text-brand-primary hover:underline transition-colors">Paris, France</a></li>
          <li><a href="/locations/berlin-elearning-development/" class="hover:text-brand-primary hover:underline transition-colors">Berlin, Germany</a></li>
          <li><a href="/locations/zurich-elearning-development/" class="hover:text-brand-primary hover:underline transition-colors">Zurich, Switzerland</a></li>
          <li><a href="/locations/stockholm-elearning-development/" class="hover:text-brand-primary hover:underline transition-colors">Stockholm, Sweden</a></li>
        </ul>
      </div>

      <!-- Cluster 3: Middle East / GCC Strategic Vision -->
      <div class="bg-white p-5 rounded-xl border border-slate-200/70 shadow-2xs">
        <h3 class="font-bold text-brand-navy mb-3 flex items-center gap-1.5 text-xs uppercase tracking-wider text-brand-primary">
          <span class="w-2 h-2 rounded-full bg-amber-500"></span>
          Middle East & GCC Hubs
        </h3>
        <ul class="space-y-2 text-slate-600">
          <li><a href="/locations/dubai-elearning-development/" class="hover:text-brand-primary hover:underline transition-colors">Dubai, UAE</a></li>
          <li><a href="/locations/riyadh-elearning-development/" class="hover:text-brand-primary hover:underline transition-colors">Riyadh, Saudi Arabia</a></li>
          <li><a href="/locations/abu-dhabi-elearning-development/" class="hover:text-brand-primary hover:underline transition-colors">Abu Dhabi, UAE</a></li>
          <li><a href="/locations/jeddah-elearning-development/" class="hover:text-brand-primary hover:underline transition-colors">Jeddah, Saudi Arabia</a></li>
          <li><a href="/locations/doha-elearning-development/" class="hover:text-brand-primary hover:underline transition-colors">Doha, Qatar</a></li>
        </ul>
      </div>

      <!-- Cluster 4: Asia-Pacific & Canadian Innovation -->
      <div class="bg-white p-5 rounded-xl border border-slate-200/70 shadow-2xs">
        <h3 class="font-bold text-brand-navy mb-3 flex items-center gap-1.5 text-xs uppercase tracking-wider text-brand-primary">
          <span class="w-2 h-2 rounded-full bg-indigo-500"></span>
          Asia-Pacific & Canada
        </h3>
        <ul class="space-y-2 text-slate-600">
          <li><a href="/locations/singapore-elearning-development/" class="hover:text-brand-primary hover:underline transition-colors">Singapore (SIT & University Corridor)</a></li>
          <li><a href="/locations/sydney-elearning-development/" class="hover:text-brand-primary hover:underline transition-colors">Sydney, Australia</a></li>
          <li><a href="/locations/melbourne-elearning-development/" class="hover:text-brand-primary hover:underline transition-colors">Melbourne, Australia</a></li>
          <li><a href="/locations/brisbane-elearning-development/" class="hover:text-brand-primary hover:underline transition-colors">Brisbane, Australia</a></li>
          <li><a href="/locations/tokyo-elearning-development/" class="hover:text-brand-primary hover:underline transition-colors">Tokyo, Japan</a></li>
          <li><a href="/locations/seoul-elearning-development/" class="hover:text-brand-primary hover:underline transition-colors">Seoul, South Korea</a></li>
          <li><a href="/locations/toronto-elearning-development/" class="hover:text-brand-primary hover:underline transition-colors">Toronto, Canada</a></li>
          <li><a href="/locations/vancouver-elearning-development/" class="hover:text-brand-primary hover:underline transition-colors">Vancouver, Canada</a></li>
        </ul>
      </div>
    </div>

    <!-- Core Delivery Architecture Links -->
    <div class="mt-8 pt-6 border-t border-slate-200 flex flex-wrap items-center justify-between gap-4 text-xs font-semibold text-slate-700">
      <div class="flex flex-wrap items-center gap-3">
        <span class="text-slate-400 uppercase tracking-wider">Core Capabilities:</span>
        <a href="/services/custom-elearning-development/" class="text-brand-primary hover:underline">Custom SCORM Course Authoring</a>
        <span>•</span>
        <a href="/services/lms-implementation-migration/" class="text-brand-primary hover:underline">Enterprise LMS Migration</a>
        <span>•</span>
        <a href="/kajabi-services/" class="text-brand-primary hover:underline">Kajabi Architecture</a>
        <span>•</span>
        <a href="/services/ai-powered-elearning/" class="text-brand-primary hover:underline">AI Instructional Design</a>
        <span>•</span>
        <a href="/services/course-localization-translation/" class="text-brand-primary hover:underline">Global Localization</a>
      </div>
      <a href="/locations/" class="text-brand-primary hover:underline flex items-center font-bold">
        Directory of All Global Locations &rarr;
      </a>
    </div>
  </div>

  <!-- FAQs -->
  {cityData.faqQuestions && cityData.faqQuestions.length > 0 && (
    <div class="mb-20">
      <h2 class="text-3xl font-bold text-brand-navy mb-8 border-b pb-4">Frequently Asked Questions</h2>
      <div class="space-y-4 max-w-4xl mx-auto">
        {cityData.faqQuestions.map(faq => (
          <div class="bg-white border border-slate-200 p-6 rounded-lg shadow-sm">
            <h3 class="text-lg font-bold text-brand-primary mb-3">{faq.q}</h3>
            <p class="text-slate-700 leading-relaxed">{faq.a}</p>
          </div>
        ))}
      </div>
    </div>
  )}

  <!-- CTA Section -->
  <div class="bg-brand-softBg border border-brand-accent/20 rounded-2xl p-10 text-center shadow-md">
    <h2 class="text-3xl font-bold text-brand-navy mb-4">Ready to start your project in {cityData.cityName}?</h2>
    <p class="text-lg text-slate-700 mb-8 max-w-2xl mx-auto">
        Tell us what you are building, improving, migrating, converting, or launching. TheEduAssist will review your course, Kajabi setup, LMS, content, funnel, or training workflow and recommend the right next step.
    </p>
    <a href={cityData.ctaPrimary?.link || "/book-free-audit/"} class="inline-block bg-brand-accent text-slate-950 font-extrabold py-3 px-10 rounded-lg hover:bg-brand-primary hover:text-white transition-colors text-lg shadow-sm">
        {cityData.ctaPrimary?.text || "Get a 24–48 Hour Review"}
    </a>

    <div class="mt-6 flex flex-wrap justify-center gap-4 text-sm font-medium">
      {(cityData.ctaSecondary || [
            { text: "Explore Services", link: "/services/" },
            { text: "Compare Platforms", link: "/platforms/" },
            { text: "View Case Studies", link: "/case-studies/" }
      ]).map((cta, index, arr) => (
        <Fragment>
          <a href={cta.link} class="text-slate-600 hover:text-brand-accent">{cta.text}</a>
          {index < arr.length - 1 && <span class="text-slate-300">|</span>}
        </Fragment>
      ))}
    </div>
  </div>

</div>
