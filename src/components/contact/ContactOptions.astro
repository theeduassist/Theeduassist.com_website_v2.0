---
import Button from '../ui/Button.astro';

export interface Props {
  email: string;
}

const { email } = Astro.props;
---

<section class="py-16 bg-slate-50">
  <div class="max-w-6xl mx-auto px-4">
    <h2 class="text-3xl font-bold text-center text-slate-900 mb-12">Choose the Best Way to Reach Us</h2>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">

      <!-- Card 1: Enterprise & Gov RFP Desk -->
      <div class="bg-gradient-to-b from-brand-navy to-slate-900 text-white p-7 rounded-xl border border-brand-green/30 shadow-md flex flex-col h-full relative overflow-hidden">
        <div class="absolute top-3 right-3">
          <span class="px-2 py-0.5 rounded text-[10px] font-bold tracking-wider uppercase bg-brand-green/20 text-brand-green border border-brand-green/30">Priority Desk</span>
        </div>
        <div class="w-12 h-12 bg-white/10 text-brand-green rounded-full flex items-center justify-center mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        </div>
        <h3 class="text-xl font-bold text-white mb-2">Enterprise & Gov RFP</h3>
        <p class="text-slate-300 text-sm mb-4 flex-grow">
          <strong class="font-medium text-brand-green">Best for:</strong> Government agencies, public sector tenders, and corporate L&D workforce RFPs under strict NDA.
        </p>
        <div class="space-y-2 mt-auto">
          <a href="/trust-centre/procurement/" class="inline-flex justify-center items-center w-full py-2.5 px-4 rounded-lg bg-brand-green text-brand-navy font-bold text-sm hover:bg-green-400 transition-colors">
            Procurement Portal &rarr;
          </a>
          <a href="/downloads/enterprise-capability-statement/" target="_blank" rel="noopener noreferrer" class="block text-center text-xs text-slate-400 hover:text-white underline underline-offset-2">
            Download Capability Deck (PDF)
          </a>
        </div>
      </div>

      <!-- Card 2 -->
      <div class="bg-white p-7 rounded-xl border border-slate-200 shadow-sm flex flex-col h-full">
        <div class="w-12 h-12 bg-blue-50 text-blue-600 rounded-full flex items-center justify-center mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
        </div>
        <h3 class="text-xl font-bold text-slate-900 mb-2">24–48h Review</h3>
        <p class="text-slate-600 text-sm mb-6 flex-grow">
          <strong class="font-medium text-slate-800">Best for:</strong> Course, Kajabi, LMS, content conversion, AI support, funnel, or launch projects.
        </p>
        <Button href="/book-free-audit/" variant="primary" class="w-full text-center">Get 24–48h Review</Button>
      </div>

      <!-- Card 3 -->
      <div class="bg-white p-7 rounded-xl border border-slate-200 shadow-sm flex flex-col h-full">
        <div class="w-12 h-12 bg-blue-50 text-blue-600 rounded-full flex items-center justify-center mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
        </div>
        <h3 class="text-xl font-bold text-slate-900 mb-2">Book Strategy Call</h3>
        <p class="text-slate-600 text-sm mb-6 flex-grow">
          <strong class="font-medium text-slate-800">Best for:</strong> Discussing your project scope, timeline, and next steps on a quick video call.
        </p>
        <Button href="https://calendly.com/eduassist-talk/30min" target="_blank" rel="noopener noreferrer" variant="outline" class="w-full text-center">Book a Video Call</Button>
      </div>

      <!-- Card 4 -->
      <div class="bg-white p-7 rounded-xl border border-slate-200 shadow-sm flex flex-col h-full">
        <div class="w-12 h-12 bg-blue-50 text-blue-600 rounded-full flex items-center justify-center mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </div>
        <h3 class="text-xl font-bold text-slate-900 mb-2">Direct Email</h3>
        <p class="text-slate-600 text-sm mb-4 flex-grow">
          <strong class="font-medium text-slate-800">Best for:</strong> General questions, vendor paperwork, and partnership inquiries.
        </p>
        <div class="mb-4">
           <a href="mailto:Info@theeduassist.com?subject=TheEduAssist%20Project%20Inquiry" class="text-blue-600 hover:text-blue-800 text-sm font-medium transition-colors break-all">{email}</a>
        </div>
        <Button href="mailto:Info@theeduassist.com?subject=TheEduAssist%20Project%20Inquiry" variant="outline" class="w-full text-center">Email Our Team</Button>
      </div>

    </div>
  </div>
</section>
