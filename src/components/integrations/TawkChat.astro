---
import { tawkConfig } from '../../config/tawk';
const { enabled, embedUrl, hideDefaultLauncher } = tawkConfig;
---
{enabled && (
  <script is:inline set:html={`
    window.Tawk_API = window.Tawk_API || {};
    window.Tawk_LoadStart = new Date();

    function loadTawkScript() {
      if (window._tawkLoaded) return;
      window._tawkLoaded = true;

      var s1 = document.createElement("script");
      var s0 = document.getElementsByTagName("script")[0];
      s1.async = true;
      s1.src = '${embedUrl}';
      s1.charset = 'UTF-8';
      // Notice: No crossorigin attribute to prevent CORS rejection from CDN
      if (s0 && s0.parentNode) {
        s0.parentNode.insertBefore(s1, s0);
      } else {
        document.body.appendChild(s1);
      }
    }

    window.loadTawkNow = loadTawkScript;

    // Load on user interaction or idle callback
    var interactionEvents = ['pointerdown', 'touchstart', 'scroll', 'keydown'];
    function onUserInteraction() {
      interactionEvents.forEach(function(evt) {
        window.removeEventListener(evt, onUserInteraction);
      });
      loadTawkScript();
    }
    interactionEvents.forEach(function(evt) {
      window.addEventListener(evt, onUserInteraction, { once: true, passive: true });
    });

    if ('requestIdleCallback' in window) {
      window.requestIdleCallback(function() {
        setTimeout(loadTawkScript, 3500);
      }, { timeout: 5000 });
    } else {
      window.addEventListener('load', function() {
        setTimeout(loadTawkScript, 3500);
      });
    }

    window.Tawk_API.onLoad = function () {
      try {
        if (${hideDefaultLauncher}) {
          window.Tawk_API.hideWidget();
        }
        if (window.innerWidth < 768) {
          window.Tawk_API.minimize();
        }
      } catch (error) {
        // silent
      }
    };
  `} />
)}

<style>
  @media (max-width: 767px) {
    #tawk-bubble-container {
      bottom: 60px !important;
    }
  }
</style>