---
export interface Props {
  headings: any[];
}

const { headings } = Astro.props;
const tocHeadings = headings.filter(h => h.depth === 2 || h.depth === 3);
---
{tocHeadings.length > 0 && (
  <nav class="bg-slate-50/95 border border-slate-200/80 rounded-2xl p-5 shadow-xs">
    <div class="flex items-center gap-2 mb-3 pb-3 border-b border-slate-200/80">
      <svg class="w-4 h-4 text-brand-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"></path>
      </svg>
      <h3 class="text-xs font-bold text-brand-navy uppercase tracking-wider">Table of Contents</h3>
    </div>
    <ul class="space-y-2 text-xs max-h-[35vh] overflow-y-auto pr-1.5 custom-scrollbar">
      {tocHeadings.map(heading => (
        <li class={heading.depth === 3 ? "pl-3 text-slate-500" : ""}>
          <a
            href={`#${heading.slug}`}
            class="text-slate-600 hover:text-brand-primary transition-colors hover:underline block leading-snug"
          >
            {heading.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

