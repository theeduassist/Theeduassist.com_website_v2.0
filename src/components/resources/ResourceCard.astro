---
export interface Props {
  resource: any;
}

const { resource } = Astro.props;
const data = resource.data;
---
<a href={`/resources/${data.category}/${resource.data.slug || resource.id.split('/').pop()}/`} class="group block bg-white rounded-xl border border-slate-200 overflow-hidden hover:border-brand-primary shadow-sm hover:shadow-md transition-all h-full flex flex-col">
  {data.featuredImage && (
    <div class="aspect-video w-full overflow-hidden bg-slate-100">
      <img
        src={data.featuredImage}
        alt={data.featuredImageAlt || data.title}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        loading="lazy"
      />
    </div>
  )}
  <div class="p-6 flex flex-col flex-grow">
    <div class="flex items-center gap-2 mb-3">
      {data.resourceType && (
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-brand-primary/10 text-brand-primary uppercase tracking-wider">
          {data.resourceType}
        </span>
      )}
      <span class="text-xs text-slate-500 capitalize">{data.category.replace(/-/g, ' ')}</span>
    </div>

    <h3 class="text-xl font-bold text-brand-navy mb-3 group-hover:text-brand-primary transition-colors line-clamp-2">
      {data.title}
    </h3>

    <p class="text-slate-600 text-sm mb-4 line-clamp-3">
      {data.summary || data.description}
    </p>

    <div class="mt-auto pt-4 border-t border-slate-100 flex items-center justify-between">
      <span class="text-brand-primary text-sm font-medium flex items-center group-hover:underline">
        Read Resource
        <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
      </span>
    </div>
  </div>
</a>
