---
import BlogTableOfContents from './BlogTableOfContents.astro';

interface Props {
  aiSummary?: string;
  keyTakeaways?: string[];
  excerpt?: string;
  headings?: { depth: number; slug: string; text: string; }[];
}

const { aiSummary, keyTakeaways = [], excerpt, headings = [] } = Astro.props;

const summaryContent = aiSummary || excerpt;
const showAiSummary = !!summaryContent;
const showToc = headings && headings.length >= 2;

if (!showAiSummary && !showToc) {
  return null;
}
---

<div class="mb-12 mt-8" id="article-tabs">
  <div class="flex border-b border-slate-200 mb-6" role="tablist" aria-label="Article Features">
    {showAiSummary && (
      <button
        id="tab-summary"
        class="pb-3 px-6 text-center font-semibold text-brand-blue border-b-2 border-brand-green bg-transparent hover:text-brand-green transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-green"
        role="tab"
        aria-selected="true"
        aria-controls="panel-summary"
      >
        AI Summary
      </button>
    )}
    {showToc && (
      <button
        id="tab-toc"
        class={`pb-3 px-6 text-center font-medium text-slate-600 hover:text-brand-blue bg-transparent transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-green ${!showAiSummary ? 'border-b-2 border-brand-green font-semibold text-brand-blue' : 'border-b-2 border-transparent'}`}
        role="tab"
        aria-selected={!showAiSummary ? "true" : "false"}
        aria-controls="panel-toc"
      >
        Table of Contents
      </button>
    )}
  </div>

  <div class="py-2">
    {showAiSummary && (
      <div id="panel-summary" role="tabpanel" aria-labelledby="tab-summary" tabindex="0" class="focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-green rounded-sm">
        <div class="prose prose-slate prose-brand max-w-none">
          <h3 class="text-lg font-bold text-brand-blue mt-0 mb-3">Quick Answer</h3>
          <p class="text-[18px] text-slate-700 leading-[1.8] mb-6">{summaryContent}</p>

          {keyTakeaways && keyTakeaways.length > 0 && (
            <div class="bg-brand-blue/5 border border-brand-blue/10 rounded-lg p-5">
              <h3 class="text-brand-blue font-bold text-lg mb-3 mt-0">Key Takeaways</h3>
              <ul class="mb-0 space-y-2">
                {keyTakeaways.map(takeaway => (
                  <li>{takeaway}</li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </div>
    )}

    {showToc && (
      <div id="panel-toc" role="tabpanel" aria-labelledby="tab-toc" tabindex="0" class={`${showAiSummary ? 'hidden' : ''} focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-green rounded-sm`}>
        <BlogTableOfContents headings={headings} />
      </div>
    )}
  </div>
</div>

<script>
  function setupTabs() {
    const tabContainer = document.getElementById('article-tabs');
    if (!tabContainer) return;

    const tabList = tabContainer.querySelector('[role="tablist"]');
    const tabs = Array.from(tabContainer.querySelectorAll('[role="tab"]')) as HTMLButtonElement[];
    const panels = Array.from(tabContainer.querySelectorAll('[role="tabpanel"]')) as HTMLDivElement[];

    if (!tabList || tabs.length === 0 || panels.length === 0) return;

    let tabFocus = 0;

    tabList.addEventListener('keydown', (e: any) => {
      if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
        tabs[tabFocus].setAttribute('tabindex', '-1');
        if (e.key === 'ArrowRight') {
          tabFocus++;
          if (tabFocus >= tabs.length) {
            tabFocus = 0;
          }
        } else if (e.key === 'ArrowLeft') {
          tabFocus--;
          if (tabFocus < 0) {
            tabFocus = tabs.length - 1;
          }
        }
        tabs[tabFocus].setAttribute('tabindex', '0');
        tabs[tabFocus].focus();
      }
    });

    tabs.forEach(tab => {
      tab.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLButtonElement;

        // Reset all
        tabs.forEach(t => {
          t.setAttribute('aria-selected', 'false');
          t.classList.remove('border-brand-green', 'font-semibold', 'text-brand-blue');
          t.classList.add('border-transparent', 'font-medium', 'text-slate-600');
        });

        panels.forEach(p => p.classList.add('hidden'));

        // Activate selected
        target.setAttribute('aria-selected', 'true');
        target.classList.remove('border-transparent', 'font-medium', 'text-slate-600');
        target.classList.add('border-brand-green', 'font-semibold', 'text-brand-blue');

        const panelId = target.getAttribute('aria-controls');
        if (panelId) {
            const panel = document.getElementById(panelId);
            if (panel) panel.classList.remove('hidden');
        }
      });
    });
  }

  setupTabs();
  document.addEventListener('astro:page-load', setupTabs);
</script>
