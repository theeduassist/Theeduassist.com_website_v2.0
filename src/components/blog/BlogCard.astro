---
import ReadTimeBadge from './ReadTimeBadge.astro';
import { getBlogUrl, normalizeStringArray } from '../../utils/blog';

interface Props {
  title: string;
  slug: string;
  excerpt?: string;
  aiSummary?: string;
  category: string;
  readTimeMinutes?: number;
  publishedAt?: string;
  image?: string;
  imageAlt?: string;
  tags?: string[];
}

const { title, slug, excerpt, aiSummary, category, readTimeMinutes, publishedAt, image, imageAlt, tags = [] } = Astro.props;

const pubDate = publishedAt ? new Date(publishedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) : null;

// Safe excerpt fallback if missing
const safeExcerpt = aiSummary || excerpt || "Read this article to learn more about our e-learning strategies and course building Articles.";

// Filter out internal CMS statuses
const hiddenStatuses = ['review pending', 'draft', 'internal', 'admin', 'private', 'test', 'do not publish'];
const displayCategory = category && !hiddenStatuses.includes(category.toLowerCase()) ? category : 'Article';

const normalizedTags = normalizeStringArray(tags);
const displayTags = normalizedTags.filter(tag => !hiddenStatuses.includes(tag.toLowerCase()));

// Get a valid URL; if null, throw error locally instead of silently making a broken link
const postUrl = getBlogUrl({slug});
if (!postUrl || postUrl === '#') {
  throw new Error(`BlogCard rendered with invalid or missing slug: "${slug}" for post "${title}"`);
}
---
<article
  class="blog-card bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden hover:shadow-md transition-shadow flex flex-col h-full group relative"
  data-title={title}
  data-excerpt={safeExcerpt}
  data-category={category}
  data-tags={normalizedTags.join(',')}
>
  <a href={postUrl} class="block relative w-full aspect-[16/9] overflow-hidden bg-slate-100">
    {image ? (
      <img
        src={image}
        alt={imageAlt || title}
        loading="lazy"
        decoding="async"
        class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
      />
    ) : (
      <div class="absolute inset-0 bg-gradient-to-br from-brand-blue/5 to-brand-green/10 flex items-center justify-center p-6 text-center text-brand-blue/40">
        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
          <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
        </svg>
      </div>
    )}
  </a>

  <div class="p-6 flex flex-col flex-grow">
    <div class="flex items-center justify-between mb-3">
      <span class="text-xs font-semibold uppercase tracking-wider text-[var(--color-primary)] truncate max-w-[70%]">
        {displayCategory}
      </span>
      {readTimeMinutes && readTimeMinutes > 0 && (
        <ReadTimeBadge minutes={readTimeMinutes} />
      )}
    </div>

    <h3 class="text-xl font-bold text-slate-800 mb-3 group-hover:text-[var(--color-primary)] transition-colors line-clamp-2">
      <a href={postUrl} class="after:absolute after:inset-0">
        {title}
      </a>
    </h3>

    <p class="text-slate-600 text-sm mb-4 line-clamp-3">
      {safeExcerpt}
    </p>

    <div class="mt-auto flex items-center justify-between text-xs text-slate-500 pt-4 border-t border-slate-100 relative z-10">
      {pubDate ? (
        <time datetime={publishedAt}>{pubDate}</time>
      ) : (
        <span></span>
      )}

      <a href={postUrl} class="font-medium text-[var(--color-primary)] flex items-center group-hover:text-[var(--color-accent)] transition-colors">
        Read Article
        <svg class="w-3 h-3 ml-1 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</article>
