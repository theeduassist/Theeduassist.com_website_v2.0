---
export interface FAQItem {
  question: string;
  answer: string | any; // String in Markdown or  obj
  showOnPage?: boolean;
  showOnSite?: boolean;
  orderRank?: string | number;
  sortOrder?: number;
}

interface Props {
  relatedFaqs?: FAQItem[];
  blogFaqs?: FAQItem[];
}

const { relatedFaqs = [], blogFaqs = [] } = Astro.props;

const sortedRelatedFaqs = (relatedFaqs || [])
  .filter(faq => faq && faq.showOnSite !== false && faq.question && faq.answer)
  .sort((a, b) => {
    if (a.orderRank != null && b.orderRank != null) {
      if (a.orderRank < b.orderRank) return -1;
      if (a.orderRank > b.orderRank) return 1;
      return 0;
    }
    if (a.orderRank != null) return -1;
    if (b.orderRank != null) return 1;
    return 0;
  });

const sortedBlogFaqs = (blogFaqs || [])
  .filter(faq => faq && faq.showOnPage !== false && faq.question && faq.answer)
  .sort((a, b) => {
    if (a.sortOrder != null && b.sortOrder != null) {
      return a.sortOrder - b.sortOrder;
    }
    if (a.sortOrder != null) return -1;
    if (b.sortOrder != null) return 1;
    return 0;
  });

const allFaqs = [...sortedRelatedFaqs, ...sortedBlogFaqs];

if (allFaqs.length === 0) {
  return null;
}
---
{allFaqs.length > 0 ? (
  <section class="mt-16 pt-8 border-t border-slate-200" id="faqs" aria-label="Frequently Asked Questions">
    <div class="mb-6">
      <h2 class="text-2xl md:text-3xl font-bold text-slate-800">Frequently Asked Questions</h2>
    </div>
    <div class="space-y-4">
      {allFaqs.map((faq, index) => (
        <details
          open
          class="group border border-slate-200 rounded-xl bg-white p-5 md:p-6 transition-all duration-200 hover:border-brand-green/50 shadow-2xs"
          id={`faq-${index}`}
        >
          <summary class="flex justify-between items-center cursor-pointer font-bold text-base md:text-lg text-slate-800 list-none select-none">
            <span class="pr-4 flex items-start gap-3">
              <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-emerald-100 text-brand-green font-bold text-xs shrink-0 mt-0.5">Q</span>
              <span>{faq.question}</span>
            </span>
            <span class="w-7 h-7 rounded-full bg-slate-100 group-hover:bg-emerald-50 flex items-center justify-center shrink-0 text-slate-500 group-hover:text-brand-green transition-colors">
              <svg
                class="w-4 h-4 transform transition-transform duration-200 group-open:rotate-180"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </span>
          </summary>
          <div class="mt-4 pt-4 border-t border-slate-100 text-slate-600 text-sm md:text-base leading-relaxed pl-9">
            {typeof faq.answer === 'string' ? (
              <p class="whitespace-pre-line">{faq.answer}</p>
            ) : (
              <div>{faq.answer}</div>
            )}
          </div>
        </details>
      ))}
    </div>
  </section>
) : null}
