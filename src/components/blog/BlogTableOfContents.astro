---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings?: Heading[];
}

const { headings = [] } = Astro.props;

// Display H2 and H3 to show hierarchy
const displayHeadings = headings.filter(h => h.depth === 2 || h.depth === 3);
---
{displayHeadings.length > 0 && (
  <div class="toc-container w-full">
    {/* Desktop Left Rail TOC (rendered when placed in the side rail) */}
    <nav class="hidden lg:block max-h-[calc(100vh-8rem)] overflow-y-auto pr-4" aria-label="Table of contents">
      <h3 class="text-sm font-bold text-slate-400 uppercase tracking-wider mb-4 px-3">Table of Contents</h3>
      <ul class="space-y-1 text-base">
        {displayHeadings.map(heading => (
          <li>
            <a
              href={`#${heading.slug}`}
              class={`toc-link block py-2 px-3 rounded-md transition-all border-l-2 border-transparent text-slate-600 hover:border-brand-green hover:text-brand-green hover:bg-green-50 text-sm font-medium ${heading.depth === 3 ? "ml-4 text-[13px]" : ""}`}
              data-toc-link
              data-slug={heading.slug}
            >
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    {/* Mobile Collapsible TOC (rendered when placed in the main content area) */}
    <details class="lg:hidden border border-slate-200 rounded-xl bg-white overflow-hidden group w-full">
      <summary class="px-6 py-4 font-semibold text-brand-blue cursor-pointer flex justify-between items-center bg-slate-50 group-open:border-b border-slate-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-green">
        Table of Contents
        <span class="transition-transform duration-200 group-open:rotate-180">▼</span>
      </summary>
      <nav class="px-6 py-4" aria-label="Table of contents (Mobile)">
        <ul class="space-y-2 text-base">
          {displayHeadings.map(heading => (
            <li>
              <a
                href={`#${heading.slug}`}
                class={`toc-link block py-2 text-slate-600 hover:text-brand-green text-sm font-medium transition-colors ${heading.depth === 3 ? "ml-4 text-[13px]" : ""}`}
                data-toc-link
                data-slug={heading.slug}
              >
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </details>
  </div>
)}

<style is:global>
  .prose h2, .prose h3, .prose h4 {
    scroll-margin-top: 6rem;
  }
  @media (prefers-reduced-motion: no-preference) {
    html {
      scroll-behavior: smooth;
    }
  }
  .lg\:block .toc-link.active {
    border-left-color: var(--color-brand-green, #16a34a) !important;
    color: var(--color-brand-green, #16a34a) !important;
    background-color: #f0fdf4 !important;
    font-weight: 600;
  }

  details .toc-link.active {
    color: var(--color-brand-green, #16a34a) !important;
    font-weight: 600;
  }
</style>

<script>
  function setupToc() {
    const tocLinks = document.querySelectorAll('.toc-link');
    if (!tocLinks.length) return;

    // Active section highlighting
    const headingElements: Element[] = [];
    tocLinks.forEach(link => {
      const slug = link.getAttribute('data-slug');
      if (slug) {
        const el = document.getElementById(slug);
        if (el) headingElements.push(el);
      }
    });

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            tocLinks.forEach(link => link.classList.remove('active'));
            const activeLink = document.querySelector(`.toc-link[data-slug="${entry.target.id}"]`);
            if (activeLink) activeLink.classList.add('active');
          }
        });
      },
      { rootMargin: '-10% 0px -80% 0px', threshold: 0 }
    );

    headingElements.forEach(el => observer.observe(el));

    // Track clicks and close mobile TOC on click
    tocLinks.forEach(link => {
      link.addEventListener('click', () => {
        const details = link.closest('details');
        if (details) {
          details.removeAttribute('open');
        }

        if (window.dataLayer && typeof window.trackEvent === 'function') {
          window.trackEvent('article_toc_click', {
            target_id: link.getAttribute('href')
          });
        }
      });
    });
  }

  setupToc();
  document.addEventListener('astro:page-load', setupToc);
</script>