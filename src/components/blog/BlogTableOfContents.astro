---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings?: Heading[];
}

const { headings = [] } = Astro.props;
---
{headings.length > 0 && (
  <nav class="bg-transparent" aria-label="Table of contents">
    <div>
      <ul class="space-y-1 text-base">
        {headings.map(heading => (
          <li style={`padding-left: ${(heading.depth - 2) * 16}px`}>
            <a
              href={`#${heading.slug}`}
              class={`toc-link block py-2 px-3 rounded-md transition-all border-l-2 border-transparent hover:border-brand-green hover:text-brand-green hover:bg-green-50 ${heading.depth === 2 ? 'font-semibold text-slate-700' : 'text-slate-500 text-sm'}`}
              data-toc-link
              data-slug={heading.slug}
            >
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>
)}

<style is:global>
  .prose h2, .prose h3, .prose h4 {
    scroll-margin-top: 6rem;
  }
  @media (prefers-reduced-motion: no-preference) {
    html {
      scroll-behavior: smooth;
    }
  }
  .toc-link.active {
    border-left-color: var(--color-brand-green, #16a34a) !important;
    color: var(--color-brand-green, #16a34a) !important;
    background-color: #f0fdf4 !important;
    font-weight: 600;
  }
</style>

<script>
  function setupToc() {
    const tocLinks = document.querySelectorAll('.toc-link');
    if (!tocLinks.length) return;

    // Active section highlighting
    const headingElements: Element[] = [];
    tocLinks.forEach(link => {
      const slug = link.getAttribute('data-slug');
      if (slug) {
        const el = document.getElementById(slug);
        if (el) headingElements.push(el);
      }
    });

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            tocLinks.forEach(link => link.classList.remove('active'));
            const activeLink = document.querySelector(`.toc-link[data-slug="${entry.target.id}"]`);
            if (activeLink) activeLink.classList.add('active');
          }
        });
      },
      { rootMargin: '-10% 0px -80% 0px', threshold: 0 }
    );

    headingElements.forEach(el => observer.observe(el));

    // Track clicks
    tocLinks.forEach(link => {
      link.addEventListener('click', () => {
        if (window.dataLayer && typeof window.trackEvent === 'function') {
          window.trackEvent('article_toc_click', {
            target_id: link.getAttribute('href')
          });
        }
      });
    });
  }

  setupToc();
  document.addEventListener('astro:page-load', setupToc);
</script>