---
// src/components/partners/CourseVAModels.astro
---

<section id="staffing-models" class="py-24 bg-white border-b border-slate-200 relative overflow-hidden">
  <!-- Subtle ambient decorative glow -->
  <div class="absolute top-1/3 -right-24 w-96 h-96 bg-brand-primary/5 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-10 -left-24 w-96 h-96 bg-brand-accent/5 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-14">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-brand-primary/10 text-brand-primary mb-4">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-primary opacity-75 motion-reduce:hidden"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-brand-primary"></span>
        </span>
        Flexible Course Staffing & Delivery
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-brand-navy tracking-tight mb-5">
        Hire a Dedicated Course VA or Tap Our Team <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-primary to-brand-accent">Pay-As-You-Go</span>
      </h2>
      <p class="text-base sm:text-lg text-slate-600 leading-relaxed">
        Stop losing hours training unvetted offshore freelancers. Hire pre-trained full-time or half-time e-learning virtual specialists for daily execution, or hire our entire technical team on a pure on-demand, pay-as-you-go basis.
      </p>

      <!-- Interactive Tab Toggle Controls -->
      <div class="mt-8 inline-flex p-1.5 rounded-2xl bg-slate-100 border border-slate-200 shadow-inner">
        <button
          type="button"
          id="tab-btn-dedicated"
          class="tab-toggle-btn active-tab px-5 py-2.5 rounded-xl font-bold text-xs sm:text-sm transition-all duration-200 shadow-sm"
          aria-controls="panel-dedicated"
          aria-selected="true"
        >
          Dedicated Course VA (Full & Half Time)
        </button>
        <button
          type="button"
          id="tab-btn-payg"
          class="tab-toggle-btn px-5 py-2.5 rounded-xl font-bold text-xs sm:text-sm text-slate-600 hover:text-brand-navy transition-all duration-200"
          aria-controls="panel-payg"
          aria-selected="false"
        >
          Pay-As-You-Go / On-Demand Team
        </button>
      </div>
    </div>

    <!-- TAB PANEL 1: Dedicated VAs (Full-Time & Half-Time) -->
    <div id="panel-dedicated" class="tab-panel transition-opacity duration-300">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-stretch max-w-5xl mx-auto mb-16">
        
        <!-- Full-Time Dedicated Specialist Card -->
        <div class="relative bg-gradient-to-b from-brand-navy to-slate-900 text-white p-8 sm:p-10 rounded-3xl border-2 border-brand-accent/40 shadow-2xl flex flex-col justify-between overflow-hidden group hover:-translate-y-1.5 transition-transform duration-300">
          <div class="absolute -right-16 -top-16 w-48 h-48 bg-brand-accent/20 rounded-full blur-2xl pointer-events-none group-hover:scale-125 transition-transform duration-500"></div>
          
          <div>
            <div class="flex items-center justify-between gap-3 mb-5">
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-extrabold bg-brand-accent text-slate-950 uppercase tracking-wider shadow-sm">
                ★ Most Popular For Scaling
              </span>
              <span class="text-xs text-brand-secondary font-semibold flex items-center gap-1">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                Immediate Kickoff
              </span>
            </div>

            <h3 class="text-2xl sm:text-3xl font-extrabold text-white mb-2">
              Full-Time Course Specialist (VA)
            </h3>
            <p class="text-brand-secondary text-sm font-semibold mb-4">
              40 Hours / Week &bull; 160 Hours / Month Dedicated
            </p>
            <p class="text-slate-300 text-sm leading-relaxed mb-6">
              A 100% dedicated team member embedded in your Slack or Teams. Manages daily LMS operations, student onboarding, video uploads, community triage, and weekly course launches without eating up your calendar.
            </p>

            <div class="p-4 rounded-2xl bg-white/5 border border-white/10 mb-6 backdrop-blur-xs">
              <span class="text-xs font-bold text-white uppercase tracking-wider block mb-2">The Unfair Advantage:</span>
              <p class="text-xs text-slate-300 leading-relaxed">
                <strong class="text-white">Senior Technical Backing:</strong> If your dedicated specialist ever encounters custom Liquid code, complex CSS, or broken Zapier/webhook logic, our senior engineers solve it at <em>zero additional cost</em>.
              </p>
            </div>

            <ul class="space-y-3 text-xs sm:text-sm text-slate-200 mb-8">
              <li class="flex items-start gap-2.5">
                <span class="text-emerald-400 font-bold shrink-0 mt-0.5">&check;</span>
                <span><strong>100% Dedicated to Your Brand:</strong> Zero shared clients; full focus on your course portal.</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="text-emerald-400 font-bold shrink-0 mt-0.5">&check;</span>
                <span><strong>Full LMS Administration:</strong> Kajabi, Thinkific, Teachable, LearnWorlds, Skool, & WordPress.</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="text-emerald-400 font-bold shrink-0 mt-0.5">&check;</span>
                <span><strong>Student Experience & Moderation:</strong> Prompt community replies, ticket triage, and onboarding help.</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="text-emerald-400 font-bold shrink-0 mt-0.5">&check;</span>
                <span><strong>Email & Funnel Updates:</strong> Scheduling broadcasts, setting up coupons, and checkout link verification.</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="text-emerald-400 font-bold shrink-0 mt-0.5">&check;</span>
                <span><strong>Zero Overhead:</strong> No recruiter fees, no payroll taxes, with guaranteed replacement continuity.</span>
              </li>
            </ul>
          </div>

          <div>
            <a
              href="#partner-intake"
              class="w-full text-center py-3.5 px-6 rounded-xl bg-brand-accent hover:bg-brand-accent/90 text-slate-950 font-extrabold text-sm transition-all shadow-lg shadow-brand-accent/30 hover:scale-[1.02] block focus-ring"
            >
              Hire Full-Time Specialist &rarr;
            </a>
            <p class="text-[11px] text-slate-400 text-center mt-2.5">
              Wholesale agency & creator rates &bull; 14-day risk-free transition period
            </p>
          </div>
        </div>

        <!-- Half-Time Dedicated Specialist Card -->
        <div class="bg-slate-50 p-8 sm:p-10 rounded-3xl border border-slate-200/90 shadow-sm flex flex-col justify-between group hover:-translate-y-1.5 transition-transform duration-300">
          <div>
            <div class="flex items-center justify-between gap-3 mb-5">
              <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-slate-200 text-slate-700 uppercase tracking-wider">
                Steady Maintenance
              </span>
              <span class="text-xs text-slate-500 font-medium">
                Predictable Daily Momentum
              </span>
            </div>

            <h3 class="text-2xl sm:text-3xl font-extrabold text-brand-navy mb-2">
              Half-Time Course Specialist (VA)
            </h3>
            <p class="text-brand-primary text-sm font-semibold mb-4">
              20 Hours / Week &bull; 80 Hours / Month (4 hrs/day)
            </p>
            <p class="text-slate-600 text-sm leading-relaxed mb-6">
              The sweet spot for active course creators and boutique agencies. Consistent 4-hour daily coverage to handle video uploads, asset formatting, student ticket replies, and routine updates without full-time commitment.
            </p>

            <div class="p-4 rounded-2xl bg-white border border-slate-200 mb-6 shadow-2xs">
              <span class="text-xs font-bold text-brand-navy uppercase tracking-wider block mb-1">Perfect If You:</span>
              <p class="text-xs text-slate-600 leading-relaxed">
                Have consistent recurring tasks (3–5 hours daily) but don't need a 40-hour staff member sitting idle.
              </p>
            </div>

            <ul class="space-y-3 text-xs sm:text-sm text-slate-600 mb-8">
              <li class="flex items-start gap-2.5">
                <span class="text-brand-accent font-bold shrink-0 mt-0.5">&check;</span>
                <span><strong>Daily 4-Hour Block:</strong> Scheduled during your core business or support hours.</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="text-brand-accent font-bold shrink-0 mt-0.5">&check;</span>
                <span><strong>Course Publishing & QA:</strong> Formatting text lessons, uploading slides, and QA testing links.</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="text-brand-accent font-bold shrink-0 mt-0.5">&check;</span>
                <span><strong>Student Onboarding Support:</strong> Resolving login issues and sending welcome guidance.</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="text-brand-accent font-bold shrink-0 mt-0.5">&check;</span>
                <span><strong>Direct Slack Access:</strong> Daily task logging and prompt asynchronous updates.</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="text-brand-accent font-bold shrink-0 mt-0.5">&check;</span>
                <span><strong>Upgradable Anytime:</strong> Scale effortlessly up to full-time during launch peaks.</span>
              </li>
            </ul>
          </div>

          <div>
            <a
              href="#partner-intake"
              class="w-full text-center py-3.5 px-6 rounded-xl bg-brand-navy hover:bg-brand-navy/90 text-white font-extrabold text-sm transition-all shadow-md hover:scale-[1.02] block focus-ring"
            >
              Hire Half-Time Specialist &rarr;
            </a>
            <p class="text-[11px] text-slate-500 text-center mt-2.5">
              Month-to-month flexibility &bull; Zero long-term lock-in
            </p>
          </div>
        </div>

      </div>
    </div>

    <!-- TAB PANEL 2: Pay-As-You-Go Team (Hidden by default, shown via toggle) -->
    <div id="panel-payg" class="tab-panel hidden transition-opacity duration-300">
      <div class="max-w-5xl mx-auto mb-16">
        <div class="bg-gradient-to-br from-slate-900 via-brand-navy to-slate-900 text-white p-8 sm:p-12 rounded-3xl border border-brand-primary/40 shadow-2xl relative overflow-hidden">
          <div class="absolute -right-20 -bottom-20 w-72 h-72 bg-brand-primary/20 rounded-full blur-3xl pointer-events-none"></div>

          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
            <div class="lg:col-span-7">
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-brand-primary text-white mb-4 uppercase tracking-wider">
                Zero Retainer &bull; Pure On-Demand
              </div>
              <h3 class="text-2xl sm:text-4xl font-extrabold text-white mb-4 leading-tight">
                Hire Our Multidisciplinary Team <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-secondary to-white">On Pay-As-You-Go</span>
              </h3>
              <p class="text-slate-300 text-sm sm:text-base leading-relaxed mb-6">
                Don't want a monthly payroll or retainer? Buy flexible hour blocks or hire us per milestone. Instead of paying one generalist VA, your pool of hours unlocks an entire team: Senior Instructional Architects, Kajabi Liquid Developers, Graphic Designers, and SCORM QA Engineers.
              </p>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs sm:text-sm text-slate-200 mb-6">
                <div class="flex items-start gap-2">
                  <span class="text-brand-secondary font-bold shrink-0">&check;</span>
                  <span><strong>Hours Never Expire:</strong> Valid for 6 months with auto-rollover.</span>
                </div>
                <div class="flex items-start gap-2">
                  <span class="text-brand-secondary font-bold shrink-0">&check;</span>
                  <span><strong>Multi-Role Access:</strong> Dev, design, instructional, and QA from one pool.</span>
                </div>
                <div class="flex items-start gap-2">
                  <span class="text-brand-secondary font-bold shrink-0">&check;</span>
                  <span><strong>Emergency SLA:</strong> Under 4-hour response for urgent launch bugs.</span>
                </div>
                <div class="flex items-start gap-2">
                  <span class="text-brand-secondary font-bold shrink-0">&check;</span>
                  <span><strong>Transparent Tracking:</strong> Minute-by-minute time logging + Loom videos.</span>
                </div>
              </div>

              <div class="flex flex-col sm:flex-row gap-3">
                <a
                  href="#partner-intake"
                  class="inline-flex items-center justify-center py-3 px-6 rounded-xl bg-brand-accent hover:bg-brand-accent/90 text-slate-950 font-extrabold text-sm transition-all shadow-lg shadow-brand-accent/30 hover:scale-[1.02] focus-ring"
                >
                  Buy Pay-As-You-Go Flex Hours &rarr;
                </a>
                <a
                  href="#partner-intake"
                  class="inline-flex items-center justify-center py-3 px-6 rounded-xl bg-white/10 hover:bg-white/15 text-white font-semibold text-sm transition-all border border-white/20 focus-ring"
                >
                  Request Single Task Quote
                </a>
              </div>
            </div>

            <!-- Hour Block Pricing Preview -->
            <div class="lg:col-span-5 bg-white/5 p-6 sm:p-8 rounded-2xl border border-white/10 backdrop-blur-md">
              <h4 class="text-base font-bold text-white mb-4 flex items-center justify-between">
                <span>Popular Flex Hour Bundles</span>
                <span class="text-xs text-brand-secondary">Pre-Paid / On-Demand</span>
              </h4>

              <div class="space-y-3 text-xs">
                <div class="p-3.5 rounded-xl bg-white/10 border border-white/15 flex items-center justify-between">
                  <div>
                    <span class="font-bold text-white block text-sm">Sprint Pass: 10 Hours</span>
                    <span class="text-slate-300 text-[11px]">Ideal for bug fixes, CSS tweaks, & quick launch audits</span>
                  </div>
                  <span class="px-2.5 py-1 rounded-md bg-brand-primary/40 text-brand-secondary font-bold shrink-0">Flex</span>
                </div>

                <div class="p-3.5 rounded-xl bg-brand-accent/20 border border-brand-accent/40 flex items-center justify-between">
                  <div>
                    <span class="font-bold text-white block text-sm">Launch Pass: 25 Hours</span>
                    <span class="text-slate-200 text-[11px]">Checkout funnel setup, video staging & email automations</span>
                  </div>
                  <span class="px-2.5 py-1 rounded-md bg-brand-accent text-slate-950 font-extrabold shrink-0">Best Value</span>
                </div>

                <div class="p-3.5 rounded-xl bg-white/10 border border-white/15 flex items-center justify-between">
                  <div>
                    <span class="font-bold text-white block text-sm">Scale Pass: 50 Hours</span>
                    <span class="text-slate-300 text-[11px]">Full course rebuilds, LMS migrations, & monthly overflow</span>
                  </div>
                  <span class="px-2.5 py-1 rounded-md bg-white/20 text-white font-bold shrink-0">Max Margin</span>
                </div>
              </div>

              <p class="text-[11px] text-slate-400 text-center mt-4">
                No recurring charges &bull; Use hours across any e-learning or course platform
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Comparative Breakdown Table: Marketplace VA vs TheEduAssist Specialist -->
    <div class="mt-12 bg-slate-50 rounded-3xl border border-slate-200 p-8 sm:p-10 max-w-5xl mx-auto">
      <div class="text-center max-w-2xl mx-auto mb-8">
        <h3 class="text-xl sm:text-2xl font-bold text-brand-navy mb-2">
          Why Course Creators Switch from Generic Offshore VAs
        </h3>
        <p class="text-xs sm:text-sm text-slate-600">
          The true cost of a cheap freelancer is the 20 hours you spend fixing their mistakes and explaining how LMS software works.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-xs sm:text-sm">
        <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-2xs">
          <div class="w-8 h-8 rounded-lg bg-rose-50 text-rose-600 flex items-center justify-center font-bold mb-3">
            &times;
          </div>
          <h4 class="font-bold text-brand-navy mb-1.5">Unvetted Offshore Marketplace</h4>
          <ul class="space-y-2 text-slate-500 text-xs">
            <li>&bull; You spend 30+ hours training them</li>
            <li>&bull; Stuck when custom code or Zapier breaks</li>
            <li>&bull; Unpredictable turnover and sudden ghosting</li>
            <li>&bull; You do all the quality assurance yourself</li>
          </ul>
        </div>

        <div class="p-5 rounded-2xl bg-white border-2 border-brand-primary/40 shadow-xs relative">
          <div class="absolute -top-3 right-4 px-2.5 py-0.5 rounded-full text-[10px] font-extrabold bg-brand-primary text-white uppercase tracking-wider">
            Our Standard
          </div>
          <div class="w-8 h-8 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold mb-3">
            &check;
          </div>
          <h4 class="font-bold text-brand-navy mb-1.5">TheEduAssist Dedicated VA</h4>
          <ul class="space-y-2 text-slate-700 text-xs">
            <li>&bull; <strong>Zero training lag:</strong> Pre-certified in Kajabi & LMS</li>
            <li>&bull; <strong>Senior engineer backup:</strong> Code bugs solved free</li>
            <li>&bull; <strong>Immediate replacement:</strong> Zero downtime guarantee</li>
            <li>&bull; <strong>Dedicated Slack/Teams:</strong> Daily task accountability</li>
          </ul>
        </div>

        <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-2xs">
          <div class="w-8 h-8 rounded-lg bg-brand-accent/10 text-brand-accent flex items-center justify-center font-bold mb-3">
            &check;
          </div>
          <h4 class="font-bold text-brand-navy mb-1.5">TheEduAssist Pay-As-You-Go Team</h4>
          <ul class="space-y-2 text-slate-700 text-xs">
            <li>&bull; <strong>Zero monthly commitment:</strong> Pay as you need</li>
            <li>&bull; <strong>Multi-discipline:</strong> Dev, design, & instructional</li>
            <li>&bull; <strong>Rapid launch response:</strong> 4-hour SLA</li>
            <li>&bull; <strong>Hours valid for 6 months:</strong> Zero wasted budget</li>
          </ul>
        </div>
      </div>
    </div>

  </div>
</section>

<script is:inline>
  // Interactive Tab Toggle for Dedicated VA vs Pay-As-You-Go Team
  document.addEventListener('DOMContentLoaded', () => {
    const btnDedicated = document.getElementById('tab-btn-dedicated');
    const btnPayg = document.getElementById('tab-btn-payg');
    const panelDedicated = document.getElementById('panel-dedicated');
    const panelPayg = document.getElementById('panel-payg');

    if (!btnDedicated || !btnPayg || !panelDedicated || !panelPayg) return;

    function activateDedicated() {
      btnDedicated.classList.add('bg-white', 'text-brand-navy', 'shadow-sm');
      btnDedicated.classList.remove('text-slate-600');
      btnDedicated.setAttribute('aria-selected', 'true');

      btnPayg.classList.remove('bg-white', 'text-brand-navy', 'shadow-sm');
      btnPayg.classList.add('text-slate-600');
      btnPayg.setAttribute('aria-selected', 'false');

      panelDedicated.classList.remove('hidden');
      panelPayg.classList.add('hidden');
    }

    function activatePayg() {
      btnPayg.classList.add('bg-white', 'text-brand-navy', 'shadow-sm');
      btnPayg.classList.remove('text-slate-600');
      btnPayg.setAttribute('aria-selected', 'true');

      btnDedicated.classList.remove('bg-white', 'text-brand-navy', 'shadow-sm');
      btnDedicated.classList.add('text-slate-600');
      btnDedicated.setAttribute('aria-selected', 'false');

      panelPayg.classList.remove('hidden');
      panelDedicated.classList.add('hidden');
    }

    btnDedicated.addEventListener('click', activateDedicated);
    btnPayg.addEventListener('click', activatePayg);

    // Initial state
    activateDedicated();
  });
</script>

<style>
  .tab-toggle-btn.active-tab {
    background-color: #ffffff;
    color: #0f172a;
  }
</style>
