---
// src/components/partners/AgencyPartnerCTA.astro
---

<section id="partner-intake" class="py-24 bg-gradient-to-b from-brand-navy to-slate-900 text-white relative overflow-hidden">
  <!-- Subtle decorative ambient background glows -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[700px] h-[700px] bg-brand-primary/15 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-10 right-10 w-96 h-96 bg-brand-accent/10 rounded-full blur-3xl pointer-events-none"></div>

  <!-- Anchor alias for audit-form-section -->
  <div id="audit-form-section" class="scroll-mt-12"></div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Header -->
    <div class="text-center mb-14">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-white/10 text-brand-secondary border border-white/15 backdrop-blur-xs mb-4">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75 motion-reduce:hidden"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        Direct Agency & Creator Intake
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight mb-4">
        Free Course, Kajabi & LMS Audit Request
      </h2>
      <p class="text-base sm:text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed">
        Tell us what you are building, improving, migrating, converting, or launching. TheEduAssist will review your request and recommend the right service path, estimated scope, and next steps within 24–48 hours.
      </p>
    </div>

    <!-- Quick Direct Contact & NDA Strip -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-12">
      <div class="p-5 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-xs flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-brand-primary/20 text-brand-secondary flex items-center justify-center shrink-0">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
        </div>
        <div>
          <span class="text-[11px] text-slate-400 block">Direct Partnership Email</span>
          <a
            href="mailto:info@theeduassist.com?subject=Agency%20Partnership%20%2F%20Audit%20Request"
            class="font-bold text-brand-secondary hover:text-white transition-colors text-xs sm:text-sm break-all"
          >
            info@theeduassist.com
          </a>
        </div>
      </div>

      <div class="p-5 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-xs flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        </div>
        <div>
          <span class="text-[11px] text-slate-400 block">Response SLA</span>
          <span class="font-bold text-white text-xs sm:text-sm">Within 4 Hours (Mon–Fri)</span>
        </div>
      </div>

      <div class="p-5 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-xs flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-brand-accent/20 text-brand-secondary flex items-center justify-center shrink-0">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
        </div>
        <div>
          <span class="text-[11px] text-slate-400 block">Confidentiality Guarantee</span>
          <span class="font-bold text-white text-xs sm:text-sm">Bilateral Mutual NDA</span>
        </div>
      </div>
    </div>

    <!-- Main Audit & Partnership Request Form Card -->
    <div class="bg-white text-slate-800 rounded-3xl p-6 sm:p-10 shadow-2xl border border-slate-100 overflow-hidden">
      <!-- Explainer Box -->
      <div class="bg-[#F8FAFC] border border-slate-200 rounded-2xl p-6 text-center shadow-2xs max-w-3xl mx-auto mb-8">
        <h3 class="text-brand-navy font-bold text-lg mb-2">What happens after you submit?</h3>
        <p class="text-slate-600 text-xs sm:text-sm mb-3">
          Our senior instructional architects and technical engineers will review your course setup, current bottlenecks, or upcoming agency client brief. We follow up within 24–48 hours with a recommended service path, estimated scope, and custom wholesale pricing.
        </p>
        <div class="text-[11px] text-slate-500 border-t border-slate-200 pt-3">
          🔒 100% Protected under strict mutual confidentiality. We never contact or solicit your agency's clients.
        </div>
      </div>

      <!-- Embedded Google Form (Same as /book-free-audit/#audit-form-section) -->
      <div class="w-full mx-auto relative rounded-xl border border-slate-200 overflow-hidden bg-white shadow-inner">
        <iframe
          src="https://docs.google.com/forms/d/e/1FAIpQLSceDHOuoN8pGLzkG80JDiQFFtZRr9mxQTHkVRZnWqe3pnesDA/viewform?embedded=true"
          width="100%"
          height="4800"
          class="border-0 bg-white w-full"
          title="TheEduAssist Free Course, Kajabi & LMS Audit Request Form"
          loading="lazy"
        >Loading…</iframe>
      </div>

      <!-- Fallback Direct Link -->
      <div class="mt-8 text-center border-t border-slate-100 pt-6">
        <p class="text-slate-600 text-xs sm:text-sm mb-3">Having trouble viewing the embedded form on mobile?</p>
        <div class="flex flex-col sm:flex-row justify-center gap-3">
          <a
            href="https://docs.google.com/forms/d/e/1FAIpQLSceDHOuoN8pGLzkG80JDiQFFtZRr9mxQTHkVRZnWqe3pnesDA/viewform"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center bg-brand-primary hover:bg-brand-primary/90 text-white px-6 py-3 rounded-xl font-bold text-xs sm:text-sm transition-all shadow-sm focus-ring"
          >
            Open Review Form in New Tab &rarr;
          </a>
          <a
            href="mailto:info@theeduassist.com?subject=Direct%20Agency%20Partnership%20Brief"
            class="inline-flex items-center justify-center bg-slate-100 hover:bg-slate-200 text-slate-800 border border-slate-200 px-6 py-3 rounded-xl font-semibold text-xs sm:text-sm transition-colors focus-ring"
          >
            Send Brief via Email Instead
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
