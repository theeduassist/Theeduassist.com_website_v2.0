---
// src/components/partners/AgencyPartnerHero.astro
---
<section class="relative bg-gradient-to-b from-brand-navy via-slate-900 to-brand-navy text-white pt-24 pb-20 overflow-hidden border-b border-white/10">
  <!-- Animated ambient decorative background glows -->
  <div class="absolute top-0 right-1/4 w-96 h-96 bg-brand-primary/25 rounded-full blur-3xl pointer-events-none -translate-y-1/2 animate-ambient-float-1 motion-reduce:animate-none"></div>
  <div class="absolute bottom-0 left-1/4 w-96 h-96 bg-brand-accent/20 rounded-full blur-3xl pointer-events-none translate-y-1/2 animate-ambient-float-2 motion-reduce:animate-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="max-w-3xl">
      <!-- Live Status Pill Badge with Ping Indicator -->
      <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full text-xs font-semibold bg-white/10 text-brand-secondary border border-white/15 backdrop-blur-xs mb-6 shadow-sm group hover:border-brand-secondary/40 transition-colors">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75 motion-reduce:hidden"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        <span>White-Label Agency Delivery &bull; Dedicated VAs &bull; Pay-As-You-Go Team</span>
      </div>

      <!-- Main Headline -->
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white mb-6 leading-[1.15]">
        Scale Your Agency’s Kajabi & E-Learning Delivery <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-secondary to-white">Without Adding Payroll</span>
      </h1>

      <!-- Subheadline -->
      <p class="text-lg sm:text-xl text-slate-300 mb-8 leading-relaxed font-normal">
        We serve as the silent, senior technical delivery engine for digital agencies and high-ticket course creators. Hire a dedicated full-time or half-time LMS virtual specialist, tap our team on pure pay-as-you-go, or outsource entire client deliverables under strict white-label bilateral NDA.
      </p>

      <!-- CTAs with Micro-Interactions -->
      <div class="flex flex-col sm:flex-row flex-wrap gap-4 mb-12">
        <a
          href="#partner-intake"
          class="relative group inline-flex items-center justify-center px-6 py-3.5 rounded-xl bg-brand-accent hover:bg-brand-accent/90 text-slate-950 font-extrabold text-sm transition-all shadow-lg shadow-brand-accent/25 hover:scale-[1.02] focus-ring overflow-hidden"
        >
          <span class="relative z-10 flex items-center gap-1.5">
            <span>Explore Agency Partnership</span>
            <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
          </span>
          <span class="absolute inset-0 -translate-x-full group-hover:translate-x-full bg-gradient-to-r from-transparent via-white/20 to-transparent transition-transform duration-1000 pointer-events-none motion-reduce:hidden"></span>
        </a>
        <a
          href="#staffing-models"
          class="inline-flex items-center justify-center px-6 py-3.5 rounded-xl bg-white/10 hover:bg-white/15 text-brand-secondary font-bold text-sm transition-all border border-brand-secondary/30 backdrop-blur-xs hover:border-brand-secondary/60 hover:scale-[1.02] focus-ring"
        >
          Hire a Dedicated VA / Team
        </a>
        <a
          href="#comparison-matrix"
          class="inline-flex items-center justify-center px-6 py-3.5 rounded-xl bg-transparent hover:bg-white/5 text-slate-300 hover:text-white font-medium text-sm transition-all border border-white/15 focus-ring"
        >
          Why Agencies Partner With Us
        </a>
      </div>

      <!-- Trust Badges Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-8 border-t border-white/10 text-xs text-slate-300">
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-brand-secondary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
          <span>Strict Bilateral NDA</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-brand-secondary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
          <span>100% White-Label</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-brand-secondary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
          <span>Senior Architects Only</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-brand-secondary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
          <span>US Time-Zone Overlap</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes ambientFloat1 {
    0%, 100% {
      transform: translateY(-50%) scale(1);
    }
    50% {
      transform: translateY(-42%) scale(1.08);
    }
  }

  @keyframes ambientFloat2 {
    0%, 100% {
      transform: translateY(50%) scale(1);
    }
    50% {
      transform: translateY(42%) scale(1.06);
    }
  }

  .animate-ambient-float-1 {
    animation: ambientFloat1 8s ease-in-out infinite;
  }

  .animate-ambient-float-2 {
    animation: ambientFloat2 10s ease-in-out infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-ambient-float-1,
    .animate-ambient-float-2 {
      animation: none !important;
    }
  }
</style>
