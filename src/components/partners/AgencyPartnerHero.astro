---
// src/components/partners/AgencyPartnerHero.astro
---
<section class="relative bg-gradient-to-b from-brand-navy via-slate-900 to-brand-navy text-white pt-24 pb-20 overflow-hidden border-b border-white/10">
  <!-- Subtle decorative ambient glows -->
  <div class="absolute top-0 right-1/4 w-96 h-96 bg-brand-primary/20 rounded-full blur-3xl pointer-events-none -translate-y-1/2"></div>
  <div class="absolute bottom-0 left-1/4 w-96 h-96 bg-brand-accent/15 rounded-full blur-3xl pointer-events-none translate-y-1/2"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="max-w-3xl">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-white/10 text-brand-secondary border border-white/15 backdrop-blur-xs mb-6">
        <svg class="w-3.5 h-3.5 text-brand-secondary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
        </svg>
        <span>100% White-Label & Subcontracting Delivery Engine</span>
      </div>

      <!-- Main Headline -->
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white mb-6 leading-[1.15]">
        Scale Your Agency’s Kajabi & E-Learning Delivery <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-secondary to-white">Without Adding Payroll</span>
      </h1>

      <!-- Subheadline -->
      <p class="text-lg sm:text-xl text-slate-300 mb-8 leading-relaxed font-normal">
        We serve as the silent, senior technical delivery partner for US, UK, and global marketing and design agencies. From deep instructional architecture and custom Kajabi portals to complex LMS migrations, we take client deliverables off your plate with zero hand-holding.
      </p>

      <!-- CTAs -->
      <div class="flex flex-col sm:flex-row gap-4 mb-12">
        <a
          href="#partner-intake"
          class="inline-flex items-center justify-center px-6 py-3.5 rounded-xl bg-brand-accent hover:bg-brand-accent/90 text-white font-bold text-sm transition-all shadow-lg shadow-brand-accent/25 hover:scale-[1.02] focus-ring"
        >
          Explore Agency Partnership &rarr;
        </a>
        <a
          href="#comparison-matrix"
          class="inline-flex items-center justify-center px-6 py-3.5 rounded-xl bg-white/10 hover:bg-white/15 text-white font-medium text-sm transition-all border border-white/20 backdrop-blur-xs hover:border-white/30 focus-ring"
        >
          Why Agencies Partner With Us
        </a>
      </div>

      <!-- Trust Badges Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-8 border-t border-white/10 text-xs text-slate-300">
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-brand-secondary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
          <span>Strict Bilateral NDA</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-brand-secondary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
          <span>100% White-Label</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-brand-secondary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
          <span>Senior Architects Only</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-brand-secondary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
          <span>US Time-Zone Overlap</span>
        </div>
      </div>
    </div>
  </div>
</section>
