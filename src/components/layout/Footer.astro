---
import { footerNavigation } from '../../data/siteNavigation';
import { trustPages } from '../../data/trustArchitecture';
import { organizationEntity } from '../../data/organizationEntity';
import BrandLogo from '../ui/BrandLogo.astro';

const site = { name: organizationEntity.name, email: organizationEntity.contactPoint.email, social: {} };
---
<footer class="bg-brand-navy text-slate-300 py-16 border-t border-brand-border/20 relative overflow-hidden">
