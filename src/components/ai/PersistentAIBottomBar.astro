---
// src/components/ai/PersistentAIBottomBar.astro
import { aiAssistants } from '../../data/aiAssistants';

// Get primary AI tools
const primaryAIs = ['chatgpt', 'claude', 'gemini', 'perplexity'];
const primaryAssistants = aiAssistants.filter(ai => primaryAIs.includes(ai.id));
---

<!-- Minimized Thin Dock Attached to Lower Border on Left Side -->
<button
  type="button"
  id="ai-minimized-pill"
  class="fixed bottom-0 left-3 sm:left-6 z-[40] bg-slate-900/95 hover:bg-brand-navy text-white border-t border-x border-slate-700/80 shadow-lg px-3 py-1.5 rounded-t-lg rounded-b-none text-xs font-bold flex items-center gap-2 transition-all hover:-translate-y-0.5 group focus-ring cursor-pointer"
  aria-expanded="false"
  aria-controls="ai-bottom-bar"
  aria-label="Open AI Assistant"
>
  <div class="relative flex items-center">
    <svg class="w-3.5 h-3.5 text-brand-green group-hover:rotate-12 transition-transform motion-reduce:transition-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
    </svg>
    <span class="absolute -top-0.5 -right-0.5 w-1.5 h-1.5 bg-brand-green rounded-full animate-ping motion-reduce:hidden"></span>
  </div>
  <span class="font-bold text-xs text-slate-100 group-hover:text-white">Ask AI</span>
  <span class="text-[10px] text-slate-400 group-hover:text-brand-green transition-colors">&uarr;</span>
</button>

<!-- Slim Floating AI Assistant Bar (Docked to Bottom-Left Border, Ultra-Low Footprint) -->
<div
  id="ai-bottom-bar"
  class="fixed bottom-0 left-0 sm:left-4 z-[40] mb-0 sm:mb-2 bg-white/98 backdrop-blur-md border-t sm:border border-slate-300/80 shadow-2xl rounded-t-xl sm:rounded-xl p-1.5 sm:px-3 sm:py-1.5 transform transition-all duration-300 translate-y-[150%] opacity-0 flex items-center gap-1.5 sm:gap-2 max-w-full sm:max-w-xl text-xs"
  aria-label="AI Assistant Toolbar"
>
  <!-- Identity -->
  <div class="flex items-center gap-1 shrink-0 text-slate-800 pl-1">
    <div class="p-1 rounded bg-brand-primary/10 text-brand-primary">
      <svg class="w-3 h-3 text-brand-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
      </svg>
    </div>
    <span class="text-xs font-black text-brand-navy hidden xs:inline">Ask AI</span>
  </div>

  <!-- Prompt Selector Dropdown -->
  <div class="flex-1 min-w-0 relative">
    <select
      id="ai-prompt-select"
      class="block w-full pl-2 pr-6 py-1 border border-slate-200 rounded-lg bg-slate-50 text-[11px] sm:text-xs text-slate-700 appearance-none focus:ring-1 focus:ring-brand-primary focus:border-brand-primary transition-all cursor-pointer truncate h-7 sm:h-8"
      aria-label="Select prompt for AI"
    >
      <option value="help_me_choose">Ask AI about this page or services...</option>
      <option value="summarize_page">Summarize this page</option>
      <option value="compare_platforms">Compare platforms</option>
      <option value="explain_pricing">Explain pricing</option>
      <option value="create_action_plan">Turn into action plan</option>
    </select>
    <div class="absolute inset-y-0 right-0 pr-1.5 flex items-center pointer-events-none text-slate-400">
      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
      </svg>
    </div>
  </div>

  <!-- Copy Prompt Button -->
  <button
    type="button"
    id="ai-copy-prompt-btn"
    class="shrink-0 bg-slate-100 hover:bg-slate-200 text-slate-700 px-2 py-1 rounded-lg text-xs font-bold transition-all border border-slate-200 flex items-center gap-1 focus-ring cursor-pointer h-7 sm:h-8"
    title="Copy prompt to clipboard"
  >
    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
    </svg>
    <span class="hidden sm:inline text-[11px]">Copy</span>
  </button>

  <!-- Quick AI Launch Buttons -->
  <div class="flex items-center gap-1 shrink-0" id="ai-tools-container">
    {primaryAssistants.map(ai => (
      <button
        type="button"
        class="ai-bottom-btn shrink-0 px-1.5 sm:px-2 py-0.5 sm:py-1 bg-white hover:bg-slate-50 text-slate-700 hover:text-brand-primary rounded border border-slate-200 text-[10px] sm:text-[11px] font-bold transition-all focus-ring cursor-pointer hover:border-brand-primary/40 h-7 sm:h-8 flex items-center"
        title={`Open in ${ai.name}`}
        data-ai-name={ai.name}
        data-ai-url={ai.baseUrl}
      >
        <span class="sm:hidden">{ai.shortLabel}</span>
        <span class="hidden sm:inline">{ai.name}</span>
      </button>
    ))}
  </div>

  <!-- Minimize / Close Button -->
  <button
    type="button"
    id="ai-bar-close"
    class="p-1 text-slate-400 hover:text-slate-700 hover:bg-slate-100 rounded-full focus-ring transition-colors shrink-0 ml-0.5 cursor-pointer"
    aria-label="Minimize AI Assist"
    title="Minimize"
  >
    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
    </svg>
  </button>
</div>

<script>
  import { copyAndOpenAI, generateFullPrompt } from './AIAssistClient';

  document.addEventListener('DOMContentLoaded', () => {
    const bar = document.getElementById('ai-bottom-bar');
    const pill = document.getElementById('ai-minimized-pill');
    const closeBtn = document.getElementById('ai-bar-close');
    const copyBtn = document.getElementById('ai-copy-prompt-btn');
    const promptSelect = document.getElementById('ai-prompt-select') as HTMLSelectElement;

    let isExpanded = false;

    // Check user preference (Default is minimized to avoid screen clutter!)
    const savedState = localStorage.getItem('aiBarState');
    if (savedState === 'expanded') {
      expandBar();
    } else {
      minimizeBar();
    }

    function expandBar() {
      isExpanded = true;
      if (bar) {
        bar.classList.remove('translate-y-[150%]', 'opacity-0');
        bar.classList.add('translate-y-0', 'opacity-100');
      }
      if (pill) {
        pill.classList.add('translate-y-[150%]', 'opacity-0', 'pointer-events-none');
        pill.setAttribute('aria-expanded', 'true');
      }
      localStorage.setItem('aiBarState', 'expanded');
    }

    function minimizeBar() {
      isExpanded = false;
      if (bar) {
        bar.classList.add('translate-y-[150%]', 'opacity-0');
        bar.classList.remove('translate-y-0', 'opacity-100');
      }
      if (pill) {
        pill.classList.remove('translate-y-[150%]', 'opacity-0', 'pointer-events-none');
        pill.setAttribute('aria-expanded', 'false');
      }
      localStorage.setItem('aiBarState', 'minimized');
    }

    pill?.addEventListener('click', expandBar);
    closeBtn?.addEventListener('click', minimizeBar);

    // Escape key minimizes bar
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isExpanded) minimizeBar();
    });

    // Copy prompt
    copyBtn?.addEventListener('click', async () => {
      const actionId = promptSelect?.value || 'help_me_choose';
      const prompt = generateFullPrompt(actionId);
      try {
        await navigator.clipboard.writeText(prompt);

        const originalContent = copyBtn.innerHTML;
        copyBtn.innerHTML = '<svg class="w-3 h-3 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg><span class="text-emerald-600 text-xs font-bold">Copied!</span>';

        setTimeout(() => {
          copyBtn.innerHTML = originalContent;
        }, 2000);
      } catch (err) {
        console.error("Failed to copy", err);
      }
    });

    // AI Buttons click
    const aiBtns = document.querySelectorAll('.ai-bottom-btn');
    aiBtns.forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const url = target.dataset.aiUrl || '';
        const name = target.dataset.aiName || '';
        const actionId = promptSelect?.value || 'help_me_choose';

        await copyAndOpenAI(actionId, url, name);
      });
    });
  });
</script>
