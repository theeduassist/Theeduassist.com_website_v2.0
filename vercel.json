{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "astro",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; img-src 'self' data: https://cdn.theeduassist.com https://*.; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://challenges.cloudflare.com; frame-src 'self' https://challenges.cloudflare.com; connect-src 'self' https://*."
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/data/blog/(.*)\\.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/services/ai-ethics-corporate-training/(.*)",
      "headers": [
        {
          "key": "Cache-Tag",
          "value": "service:ai-ethics-corporate-training"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "theeduassist.com"
        }
      ],
      "destination": "https://www.theeduassist.com/:path*",
      "permanent": true
    },
    {
      "source": "/contact/",
      "destination": "/contact-us/",
      "permanent": true
    },
    {
      "source": "/blog/how-theeduassist-transforms-online-learning/",
      "destination": "/blog/how-theeduassist-transforms-learning/",
      "permanent": true
    },
    {
      "source": "/blog/how-theeduassist-is-transforming-online-education/",
      "destination": "/blog/how-theeduassist-transforms-learning/",
      "permanent": true
    },
    {
      "source": "/enterprise-solutions/project-brief/",
      "destination": "/book-free-audit/",
      "permanent": true
    },
    {
      "source": "/wp-admin(.*)",
      "destination": "/404",
      "permanent": false
    },
    {
      "source": "/wp-login.php(.*)",
      "destination": "/404",
      "permanent": false
    },
    {
      "source": "/xmlrpc.php(.*)",
      "destination": "/404",
      "permanent": false
    },
    {
      "source": "/.env(.*)",
      "destination": "/404",
      "permanent": false
    },
    {
      "source": "/.git(.*)",
      "destination": "/404",
      "permanent": false
    },
    {
      "source": "/phpmyadmin(.*)",
      "destination": "/404",
      "permanent": false
    },
    {
      "source": "/adminer(.*)",
      "destination": "/404",
      "permanent": false
    }
  ],
  "routes": [
    {
      "src": "/tag/thinkific-marketing(?:/.*)?",
      "status": 410
    },
    {
      "src": "/tag/theeduassist-com-course-creation(?:/.*)?",
      "status": 410
    },
    {
      "src": "/jobs/lead-generation-internfresh-grads-unpaid(?:/.*)?",
      "status": 410
    },
    {
      "handle": "filesystem"
    }
  ]
}